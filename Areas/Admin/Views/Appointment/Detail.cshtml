@using AppointmentHospital.Areas.Admin.DTOs.Appointment
@model AppointmentResponse

<div class="appointment-detail">
    <div class="glass-card main-card">
        <div class="card-header">
            <div class="header-content">
                <h2 class="text-white">
                    <i class="bi bi-calendar2-check"></i>
                    Chi tiết lịch hẹn
                </h2>
                <div class="appointment-status @Model.Status.ToString().ToLower()">
                    <span class="status-badge">
                        @{
                            var status = Model.Status.ToString();
                            string statusText = status switch
                            {
                                "Pending" => "Chờ xác nhận",
                                "Confirmed" => "Đã xác nhận",
                                "Completed" => "Hoàn thành",
                                "Canceled" => "Đã hủy",
                                _ => "Không xác định"
                            };
                        }
                        @statusText
                    </span>
                </div>
            </div>
        </div>

        <div class="card-content">
            <div class="info-section">
                <div class="info-card patient-info">
                    <div class="info-header">
                        <i class="bi bi-person-circle"></i>
                        <h3>Thông tin bệnh nhân</h3>
                    </div>
                    <div class="info-body">
                        <p><strong>Họ tên:</strong> @Model.PatientName</p>
                        <p><strong>Mã bệnh nhân:</strong> @Model.PatientId</p>
                    </div>
                </div>

                <div class="info-card doctor-info">
                    <div class="info-header">
                        <i class="bi bi-person-badge"></i>
                        <h3>Thông tin bác sĩ</h3>
                    </div>
                    <div class="info-body">
                        <p><strong>Họ tên:</strong> @Model.DoctorName</p>
                        <p><strong>Chuyên khoa:</strong> @Model.SpecialityName</p>
                    </div>
                </div>
            </div>

            <div class="info-section">
                <div class="info-card appointment-time">
                    <div class="info-header">
                        <i class="bi bi-clock-history"></i>
                        <h3>Thời gian khám</h3>
                    </div>
                    <div class="info-body">
                        <div class="time-details">
                            <p><i class="bi bi-calendar-event"></i> @Model.AppointmentTime.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
                            <p><i class="bi bi-clock"></i> @Model.AppointmentTime.ToString("hh:mm tt")</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="info-section">
                    <div class="info-card notes">
                        <div class="info-header">
                            <i class="bi bi-journal-text"></i>
                            <h3>Ghi chú thêm</h3>
                        </div>
                        <div class="info-body">
                            <p>@Model.Notes</p>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.CancellationReason))
            {
                <div class="info-section">
                    <div class="info-card cancellation">
                        <div class="info-header warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <h3>Lý do hủy</h3>
                        </div>
                        <div class="info-body">
                            <p>@Model.CancellationReason</p>
                        </div>
                    </div>
                </div>
            }

            <div class="created-info">
                <small>
                    <i class="bi bi-clock-history"></i>
                    Tạo vào ngày @Model.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("vi-VN")) lúc @Model.CreatedAt.ToString("hh:mm tt")
                </small>
            </div>
        </div>

        <div class="card-actions">
            <a href="@Url.Action("Index")" class="btn-back">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/detail-appointment.css" />
}
@section Scripts {
    <script>
        $(document).ready(function() {
            $('.card').hover(
                function() { $(this).addClass('shadow-lg'); },
                function() { $(this).removeClass('shadow-lg'); }
            );
        });
    </script>
}

