@using AppointmentHospital.Areas.Admin.DTOs.Appointment;
@using AppointmentHospital.Helpers;
@using AppointmentHospital.EnumStatus;
@model Pagination<AppointmentResponse>;

@{
    var specializationList = ViewData["SpecializationList"] as List<SelectListItem>;
    var statusList = ViewData["StatusList"] as List<SelectListItem>;
    var searchTerm = ViewData["SearchTerm"] as string;
    var specializationViewData = ViewData["SpecialityId"] as int?;
    var statusViewData = ViewData["Status"] as string;
    var appointmentDate = ViewData["AppointmentDate"] as string;

    // Map Status enum to Vietnamese
    Func<string, string> GetVietnameseStatus = status => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "Canceled" => "Đã hủy",
        "Completed" => "Hoàn thành",
        _ => "Không rõ"
    };
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end justify-content-center">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="col-md-4">
                <label class="form-label">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input name="searchTerm" class="form-control" placeholder="Nhập tên bệnh nhân hoặc bác sĩ" value="@searchTerm">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Chuyên khoa</label>
                <select name="SpecialityId" class="form-select">
                    <option value="" disabled selected="@(!specializationViewData.HasValue)">Chọn chuyên khoa</option>
                    @foreach (var specialization in specializationList)
                    {
                        <option value="@specialization.Value" selected="@(specialization.Value == specializationViewData?.ToString())">@specialization.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(statusViewData))">Tất cả trạng thái</option>
                    @foreach (var status in statusList)
                    {
                        <option value="@status.Value" selected="@(status.Value == statusViewData)">@GetVietnameseStatus(status.Text)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Ngày hẹn</label>
                <input type="date" name="appointmentDate" class="form-control" value="@appointmentDate" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter me-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0">Danh sách lịch hẹn</h5>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-dark text-decoration-none">Bệnh nhân</th>
                        <th class="text-dark text-decoration-none">Bác sĩ</th>
                        <th class="text-dark text-decoration-none">Thời gian hẹn</th>
                        <th class="text-dark text-decoration-none">Chuyên khoa</th>
                        <th class="text-dark text-decoration-none">Trạng thái</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var response in Model)
                    {
                        var colorBadge = response.Status.ToString() switch
                        {
                            "Pending" => "secondary",
                            "Confimed" => "info",
                            "Canceled" => "danger",
                            "Completed" => "success",
                            _ => "dark"
                        };
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="ms-2">
                                        <h6 class="mb-0">@response.PatientName</h6>
                                        <small class="text-muted">ID: @response.PatientId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="ms-2">
                                        <h6 class="mb-0">@response.DoctorName</h6>
                                        <small class="text-muted">ID: @response.DoctorId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @response.AppointmentTime.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @response.SpecialityName
                            </td>
                            <td>
                                <span class="badge bg-@colorBadge">@GetVietnameseStatus(response.Status.ToString())</span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Detail" asp-route-id="@response.AppointmentId">
                                    Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav class="mt-2 d-flex justify-content-center" aria-label="Phân trang">
        <ul class="pagination">
            <!-- Nút "Trước" -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage-1)" asp-route-SpecialityId="@(specializationViewData)" asp-route-searchTerm="@(searchTerm)" asp-route-status="@(statusViewData)" asp-route-appointmentDate="@(appointmentDate)">Trước</a>
            </li>

            <!-- Hiển thị trang đầu tiên -->
            @if (Model.TotalPage > 1)
            {
                <li class="page-item @(Model.CurrentPage == 1 ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-SpecialityId="@(specializationViewData)" asp-route-searchTerm="@(searchTerm)" asp-route-status="@(statusViewData)" asp-route-appointmentDate="@(appointmentDate)">1</a>
                </li>
            }

            <!-- Hiển thị dấu "..." nếu cần -->
            @if (Model.TotalPage > 7 && Model.CurrentPage > 4)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }

            <!-- Hiển thị các trang xung quanh trang hiện tại (tối đa 5 trang giữa trang đầu và cuối) -->
            @{
                int startPage = Math.Max(2, Model.CurrentPage - 2);
                int endPage = Math.Min(Model.TotalPage - 1, Model.CurrentPage + 2);

                if (Model.CurrentPage <= 4)
                {
                    endPage = Math.Min(6, Model.TotalPage - 1);
                }
                else if (Model.CurrentPage >= Model.TotalPage - 3)
                {
                    startPage = Math.Max(2, Model.TotalPage - 5);
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-SpecialityId="@(specializationViewData)" asp-route-searchTerm="@(searchTerm)" asp-route-status="@(statusViewData)" asp-route-appointmentDate="@(appointmentDate)">@i</a>
                    </li>
                }
            }

            <!-- Hiển thị dấu "..." nếu cần -->
            @if (Model.TotalPage > 7 && Model.CurrentPage < Model.TotalPage - 3)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }

            <!-- Hiển thị trang cuối cùng -->
            @if (Model.TotalPage > 1)
            {
                <li class="page-item @(Model.CurrentPage == Model.TotalPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPage" asp-route-SpecialityId="@(specializationViewData)" asp-route-searchTerm="@(searchTerm)" asp-route-status="@(statusViewData)" asp-route-appointmentDate="@(appointmentDate)">@Model.TotalPage</a>
                </li>
            }

            <!-- Nút "Tiếp" -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage+1)" asp-route-SpecialityId="@(specializationViewData)" asp-route-searchTerm="@(searchTerm)" asp-route-status="@(statusViewData)" asp-route-appointmentDate="@(appointmentDate)">Tiếp</a>
            </li>
        </ul>
    </nav>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/appointment.css" />
}