@using AppointmentHospital.Models;
@using AppointmentHospital.Helpers;
@model Pagination<Specialities>;
@{
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="SpecialityIndex" class="row g-3 align-items-end justify-content-center">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="col-md-7">
                <label class="form-label">Tìm kiếm chuyên khoa</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input name="searchTerm"
                           class="form-control"
                           placeholder="Nhập tên chuyên khoa..."
                           value="@searchTerm">
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0">Danh sách chuyên khoa</h5>
            </div>
            <div class="col-auto">
                <a asp-action="CreateSpeciality" class="btn btn-primary btn-sm">Thêm chuyên khoa mới</a>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-dark text-decoration-none">Tên chuyên khoa</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var speciality in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="ms-2">
                                        <h6 class="mb-0">@speciality.SpecialityName</h6>
                                        <small class="text-muted">Mã số: @speciality.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="EditSpeciality" asp-route-id="@speciality.Id"
                                       class="btn btn-outline-primary btn-sm" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" 
                                            class="btn btn-outline-danger btn-sm delete-btn" 
                                            data-id="@speciality.Id"
                                            data-name="@speciality.SpecialityName"
                                            title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        int totalPages = Model.TotalPage;
        int currentPage = Model.CurrentPage;
        int maxDisplayedPages = 7;
        int startPage = Math.Max(1, currentPage - 3);
        int endPage = Math.Min(totalPages, currentPage + 3);

        if (totalPages > maxDisplayedPages)
        {
            if (currentPage <= 4)
            {
                startPage = 1;
                endPage = maxDisplayedPages;
            }
            else if (currentPage >= totalPages - 3)
            {
                startPage = totalPages - maxDisplayedPages + 1;
                endPage = totalPages;
            }
        }
        else
        {
            startPage = 1;
            endPage = totalPages;
        }

        object CreateRouteValues(int page)
        {
            var routeValues = new RouteValueDictionary { { "page", page } };
            
            if (!string.IsNullOrEmpty(searchTerm))
            {
                routeValues.Add("searchTerm", searchTerm);
            }
            
            return routeValues;
        }
    }

    <div class="d-flex justify-content-center align-items-center p-4">
        <nav aria-label="Điều hướng phân trang" class="mx-auto">
            <ul class="pagination pagination-rounded mb-0">

                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("SpecialityIndex", "Speciality", CreateRouteValues(Model.CurrentPage - 1))" aria-label="Trang trước">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("SpecialityIndex", "Speciality", CreateRouteValues(1))">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("SpecialityIndex", "Speciality", CreateRouteValues(i))">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("SpecialityIndex", "Speciality", CreateRouteValues(totalPages))">@totalPages</a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("SpecialityIndex", "Speciality", CreateRouteValues(Model.CurrentPage + 1))" aria-label="Trang sau">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/managing-doctor.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // Xử lý nút xóa
            $('.delete-btn').on('click', function() {
                const id = $(this).data('id');
                const name = $(this).data('name');
                
                Swal.fire({
                    title: 'Xác nhận xóa',
                    text: `Bạn có chắc chắn muốn xóa chuyên khoa "${name}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Gửi request xóa
                        window.location.href = '@Url.Action("DeleteSpeciality")?id=' + id;
                    }
                });
            });

            // Hiển thị thông báo từ TempData
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Không thể xóa!',
                    text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                    icon: 'error',
                    confirmButtonText: 'Đóng'
                });
                </text>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Thành công!',
                    text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                    icon: 'success',
                    confirmButtonText: 'Đóng'
                });
                </text>
            }
        });
    </script>
}