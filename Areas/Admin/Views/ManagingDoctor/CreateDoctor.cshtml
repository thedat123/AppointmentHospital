@using AppointmentHospital.Areas.Admin.DTOs.ManagingDoctor
@model ManagingDoctorRequest;
@{
    var specializationList = ViewData["SelectSpecialization"] as List<SelectListItem>;
    ViewData["Title"] = "Add New Doctor";
}
<div class="container-fluid py-4">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-8 mx-auto">
                    <form asp-action="CreateDoctor" method="post" enctype="multipart/form-data" class="needs-validation"
                        novalidate>
                        <div class="text-center mb-4">
                            <h3 class="text-primary">Add New Doctor</h3>
                            <p class="text-muted">Enter doctor's information below</p>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.FullName" class="form-control" placeholder="Full Name" />
                                    <label asp-for="@Model.FullName"></label>
                                    <span asp-validation-for="@Model.FullName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.EmailAddress" class="form-control"
                                        placeholder="Email Address" />
                                    <label asp-for="@Model.EmailAddress"></label>
                                    <span asp-validation-for="@Model.EmailAddress" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.PhoneNumber" class="form-control"
                                        placeholder="Phone Number" />
                                    <label asp-for="@Model.PhoneNumber"></label>
                                    <span asp-validation-for="@Model.PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="@Model.Specializaiton" class="form-select">
                                        <option value="">Select Specialization</option>
                                        @foreach(var specialization in specializationList){
                                            <option value="@specialization.Value" >@specialization.Text</option>
                                        }
                                    </select>
                                    <label asp-for="Specializaiton"></label>
                                    <span asp-validation-for="Specializaiton" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.ExperienceYear" class="form-control"
                                        placeholder="Years of Experience" />
                                    <label asp-for="@Model.ExperienceYear"></label>
                                    <span asp-validation-for="@Model.ExperienceYear" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="@Model.Gender" class="form-select">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <label asp-for="@Model.Gender"></label>
                                    <span asp-validation-for="@Model.Gender" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="@Model.Degree" class="form-control" placeholder="Degree" />
                                    <label asp-for="@Model.Degree"></label>
                                    <span asp-validation-for="@Model.Degree" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="@Model.Description" class="form-control" style="height: 100px"
                                        placeholder="Description"></textarea>
                                    <label asp-for="@Model.Description"></label>
                                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input value="1999-01-01" type="date" asp-for="@Model.DateOfBirth" class="form-control" placeholder="Date of birth" />
                                    <label asp-for="@Model.DateOfBirth"></label>
                                    <span asp-validation-for="@Model.DateOfBirth" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12 text-center mt-4">
                                <button type="submit" class="btn btn-primary px-4 py-2">
                                    <i class="fas fa-plus-circle me-2"></i>Add Doctor
                                </button>
                                <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                                    <i class="fas fa-arrow-left me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create.css" />
}
