@using AppointmentHospital.Areas.Admin.DTOs.ManagingDoctor
@model ManagingDoctorRequest;
@{
    var specializationList = ViewData["SelectSpecialization"] as List<SelectListItem>;
    ViewData["Title"] = "Thêm Bác Sĩ Mới";
}
<!-- Đảm bảo mã hóa UTF-8 để hiển thị tiếng Việt -->
<meta charset="utf-8" />
<div class="container-fluid py-4">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-10 mx-auto">
                    <form asp-action="CreateDoctor" method="post" enctype="multipart/form-data" class="needs-validation"
                        novalidate>
                        <div class="text-center mb-4">
                            <h3 class="text-primary">Thêm Bác Sĩ Mới</h3>
                            <p class="text-muted">Nhập thông tin bác sĩ dưới đây</p>
                        </div>

                        <div class="row g-4">
                            <!-- Phần Thông Tin Cơ Bản -->
                            <div class="col-12">
                                <h5 class="text-secondary border-bottom pb-2 mb-3">
                                    <i class="fas fa-user me-2"></i>Thông Tin Cơ Bản
                                </h5>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.FullName" class="form-control" placeholder="Họ và tên" />
                                    <label asp-for="@Model.FullName">Họ và Tên</label>
                                    <span asp-validation-for="@Model.FullName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.EmailAddress" type="email" class="form-control" placeholder="Địa chỉ email" />
                                    <label asp-for="@Model.EmailAddress">Địa Chỉ Email</label>
                                    <span asp-validation-for="@Model.EmailAddress" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="@Model.Degree" class="form-control" placeholder="Bằng cấp" />
                                    <label asp-for="@Model.Degree">Bằng Cấp</label>
                                    <span asp-validation-for="@Model.Degree" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="@Model.SpecialityId" class="form-select">
                                        <option value="">Chọn chuyên khoa</option>
                                        @foreach(var specialization in specializationList){
                                            <option value="@specialization.Value">@specialization.Text</option>
                                        }
                                    </select>
                                    <label asp-for="SpecialityId">Chuyên Khoa</label>
                                    <span asp-validation-for="SpecialityId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="file" asp-for="@Model.ImagePath" class="form-control" accept="image/*" />
                                    <label asp-for="@Model.ImagePath">Ảnh Bác Sĩ</label>
                                    <span asp-validation-for="@Model.ImagePath" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Chi Tiết Chuyên Môn -->
                            <div class="col-12 mt-5">
                                <h5 class="text-secondary border-bottom pb-2 mb-3">
                                    <i class="fas fa-award me-2"></i>Chi Tiết Chuyên Môn
                                </h5>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="@Model.Introduction" class="form-control" style="height: 120px"
                                        placeholder="Giới thiệu"></textarea>
                                    <label asp-for="@Model.Introduction">Giới Thiệu</label>
                                    <span asp-validation-for="@Model.Introduction" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Giải Thưởng -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Giải Thưởng & Ghi Nhận</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="mb-2">
                                        <small class="text-muted">Nhập mỗi giải thưởng trên một dòng riêng. Mỗi dòng sẽ hiển thị dưới dạng gạch đầu dòng.</small>
                                    </div>
                                    <textarea asp-for="@Model.Awards" class="form-control" rows="4"
                                        placeholder="Ví dụ:
Bằng khen của Bộ Y tế
Danh hiệu Lao động Tiên tiến, Chiến sĩ Thi đua
Giải Nhất – Hội nghị Nhi khoa tập đoàn Hoàn Mỹ 2018"></textarea>
                                    <span asp-validation-for="@Model.Awards" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Chuyên Môn -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Chuyên Môn</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="mb-2">
                                        <small class="text-muted">Nhập mỗi lĩnh vực chuyên môn trên một dòng riêng.</small>
                                    </div>
                                    <textarea asp-for="@Model.Expertise" class="form-control" rows="4"
                                        placeholder="Ví dụ:
Điều trị bệnh tim mạch
Phẫu thuật tim hở
Can thiệp tim mạch qua da"></textarea>
                                    <span asp-validation-for="@Model.Expertise" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Thành Viên Tổ Chức -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Thành Viên Tổ Chức</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="mb-2">
                                        <small class="text-muted">Nhập mỗi tổ chức trên một dòng riêng.</small>
                                    </div>
                                    <textarea asp-for="@Model.OrganizationMember" class="form-control" rows="3"
                                        placeholder="Ví dụ:
Hội Tim mạch học Việt Nam
Hội Nội khoa Việt Nam
Hiệp hội Tim mạch Hoa Kỳ"></textarea>
                                    <span asp-validation-for="@Model.OrganizationMember" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Dự Án Nghiên Cứu -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Dự Án Nghiên Cứu</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="mb-2">
                                        <small class="text-muted">Nhập mỗi dự án nghiên cứu trên một dòng riêng.</small>
                                    </div>
                                    <textarea asp-for="@Model.ResearchProject" class="form-control" rows="4"
                                        placeholder="Ví dụ:
Nghiên cứu về bệnh tim bẩm sinh ở trẻ em
Đề tài cấp bộ về điều trị suy tim
Nghiên cứu ứng dụng AI trong chẩn đoán tim mạch"></textarea>
                                    <span asp-validation-for="@Model.ResearchProject" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Quá Trình Đào Tạo -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Quá Trình Đào Tạo & Giáo Dục</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="mb-2">
                                        <small class="text-muted">Nhập mỗi thành tựu đào tạo/giáo dục trên một dòng riêng.</small>
                                    </div>
                                    <textarea asp-for="@Model.TrainingProcess" class="form-control" rows="4"
                                        placeholder="Ví dụ:
Tốt nghiệp Đại học Y Hà Nội
Thạc sĩ Tim mạch - Đại học Y Dược TP.HCM
Đào tạo tại Bệnh viện Johns Hopkins, Hoa Kỳ"></textarea>
                                    <span asp-validation-for="@Model.TrainingProcess" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phần Kinh Nghiệm Làm Việc -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Kinh Nghiệm Làm Việc</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="mb-2">
                                        <small class="text-muted">Nhập mỗi kinh nghiệm làm việc trên một dòng riêng.</small>
                                    </div>
                                    <textarea asp-for="@Model.WorkExperience" class="form-control" rows="4"
                                        placeholder="Ví dụ:
Bác sĩ Tim mạch - Bệnh viện Chợ Rẫy (2015-2020)
Trưởng khoa Tim mạch - Bệnh viện ABC (2020-nay)
Bác sĩ tư vấn - Phòng khám XYZ"></textarea>
                                    <span asp-validation-for="@Model.WorkExperience" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12 text-center mt-5">
                                <button type="submit" class="btn btn-primary px-4 py-2 me-3">
                                    <i class="fas fa-plus-circle me-2"></i>Thêm Bác Sĩ
                                </button>
                                <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                                    <i class="fas fa-arrow-left me-2"></i>Quay Lại Danh Sách
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create.css" />
    <style>
        .form-label.fw-bold {
            color: #495057;
            font-weight: 600 !important;
        }
        
        .bg-light {
            background-color: #f8f9fa !important;
        }
        
        .border {
            border: 1px solid #dee2e6 !important;
        }
        
        .text-secondary {
            color: #6c757d !important;
        }
        
        textarea.form-control {
            resize: vertical;
            min-height: 80px;
        }
        
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            opacity: .65;
            transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Tự động điều chỉnh kích thước textarea
        document.querySelectorAll('textarea').forEach(function(textarea) {
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = this.scrollHeight + 'px';
            });
        });
        
        // Xem trước ảnh khi tải lên
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Có thể thêm chức năng xem trước ảnh tại đây nếu cần
                    console.log('Đã chọn ảnh:', file.name);
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}