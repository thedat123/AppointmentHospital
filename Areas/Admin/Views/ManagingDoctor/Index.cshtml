@using AppointmentHospital.Areas.Admin.DTOs.ManagingDoctor;
@using AppointmentHospital.Helpers;
@using AppointmentHospital.EnumStatus;
@model Pagination<ManagingDoctorResponse>;
@{
    var specializations = ViewData["SelectSpecialization"] as List<SelectListItem>;
    var searchTerm = ViewBag.SearchTerm as string;
    var specializationViewData = ViewData["Specialization"] as int?;
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end justify-content-center">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="col-md-5">
                <label class="form-label">Tìm kiếm bác sĩ</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input name="searchTerm"
                           class="form-control"
                           placeholder="Nhập tên bác sĩ..."
                           value="@searchTerm">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Chuyên khoa</label>
                <select name="SpecialityId" class="form-select">
                    @if (!specializationViewData.HasValue || specializationViewData.Value == 0)
                    {
                        <option value="0" selected>Tất cả chuyên khoa</option>
                    }
                    else
                    {
                        <option value="0">Tất cả chuyên khoa</option>
                    }

                    @foreach (var specialization in specializations)
                    {
                        if (specializationViewData.HasValue && specializationViewData.Value.ToString() == specialization.Value)
                        {
                            <option value="@specialization.Value" selected>@specialization.Text</option>
                        }
                        else
                        {
                            <option value="@specialization.Value">@specialization.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0">Danh sách bác sĩ</h5>
            </div>
            <div class="col-auto">
                <a asp-action="CreateDoctor" class="btn btn-primary btn-sm">Thêm bác sĩ mới</a>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-dark text-decoration-none">Tên bác sĩ</th>
                        <th class="text-dark text-decoration-none">Học hàm - Học vị</th>
                        <th class="text-dark text-decoration-none">Chuyên khoa</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="ms-2">
                                        <h6 class="mb-0">@doctor.FullName</h6>
                                        <small class="text-muted">Mã số: @doctor.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>@doctor.Degree</td>
                            <td>@doctor.SpecialityName</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="EditDoctor" asp-route-id="@doctor.Id"
                                       class="btn btn-outline-primary btn-sm" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="DeleteDoctor" asp-route-id="@doctor.Id"
                                       class="btn btn-outline-danger btn-sm" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        int totalPages = Model.TotalPage;
        int currentPage = Model.CurrentPage;
        int maxDisplayedPages = 7;
        int startPage = Math.Max(1, currentPage - 3);
        int endPage = Math.Min(totalPages, currentPage + 3);

        if (totalPages > maxDisplayedPages)
        {
            if (currentPage <= 4)
            {
                startPage = 1;
                endPage = maxDisplayedPages;
            }
            else if (currentPage >= totalPages - 3)
            {
                startPage = totalPages - maxDisplayedPages + 1;
                endPage = totalPages;
            }
        }
        else
        {
            startPage = 1;
            endPage = totalPages;
        }

        // Helper method để tạo route values với filter parameters
        object CreateRouteValues(int page)
        {
            var routeValues = new RouteValueDictionary { { "page", page } };
            
            if (!string.IsNullOrEmpty(searchTerm))
            {
                routeValues.Add("searchTerm", searchTerm);
            }
            
            if (specializationViewData.HasValue && specializationViewData.Value > 0)
            {
                routeValues.Add("SpecialityId", specializationViewData.Value);
            }
            
            return routeValues;
        }
    }

    <div class="d-flex justify-content-center align-items-center p-4">
        <nav aria-label="Điều hướng phân trang" class="mx-auto">
            <ul class="pagination pagination-rounded mb-0">

                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingDoctor", CreateRouteValues(Model.CurrentPage - 1))" aria-label="Trang trước">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingDoctor", CreateRouteValues(1))">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "ManagingDoctor", CreateRouteValues(i))">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingDoctor", CreateRouteValues(totalPages))">@totalPages</a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingDoctor", CreateRouteValues(Model.CurrentPage + 1))" aria-label="Trang sau">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/managing-doctor.css" />
}