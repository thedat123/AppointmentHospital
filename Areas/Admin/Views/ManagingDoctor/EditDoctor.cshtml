@using AppointmentHospital.Areas.Admin.DTOs.ManagingDoctor;
@model ManagingDoctorResponse;
@{
    ViewData["Title"] = "Chỉnh Sửa Bác Sĩ";
    var specializationList = ViewData["SpecializationList"] as List<SelectListItem> ?? new List<SelectListItem>();
}
<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-12 col-lg-10 mx-auto">
                    <form asp-action="EditDoctor" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" name="Id" value="@(Model?.Id ?? Guid.Empty)" />
                        <input type="hidden" name="ImagePath" value="@(Model?.ImagePath ?? "")" />

                        <div class="text-center mb-4">
                            <h3 class="text-primary fw-bold">Chỉnh Sửa Hồ Sơ Bác Sĩ</h3>
                            <p class="text-muted">Cập nhật thông tin bác sĩ bên dưới</p>
                        </div>

                        <!-- Phần Thông Tin Cơ Bản -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-primary">
                                    <i class="fas fa-user-md me-2"></i>Thông Tin Cơ Bản
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input name="FullName" class="form-control" placeholder="Họ và Tên" value="@(Model?.FullName ?? "")" required />
                                            <label for="FullName">Họ và Tên</label>
                                            <span asp-validation-for="FullName" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input name="EmailAddress" type="email" class="form-control" placeholder="Địa Chỉ Email" value="@(Model?.EmailAddress ?? "")" required />
                                            <label for="EmailAddress">Địa Chỉ Email</label>
                                            <span asp-validation-for="EmailAddress" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input name="Degree" class="form-control" placeholder="Bằng Cấp" value="@(Model?.Degree ?? "")" required />
                                            <label for="Degree">Bằng Cấp</label>
                                            <span asp-validation-for="Degree" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select name="SpecialityId" class="form-select" required>
                                                <option value="">Chọn Chuyên Môn</option>
                                                @if (specializationList != null && specializationList.Any())
                                                {
                                                    @foreach(var specialization in specializationList)
                                                    {
                                                        if(specialization.Value == (Model?.SpecialityId.ToString() ?? ""))
                                                        {
                                                            <option value="@specialization.Value" selected>@specialization.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@specialization.Value">@specialization.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                            <label for="SpecialityId">Chuyên Môn</label>
                                            <span asp-validation-for="SpecialityId" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-bold">Hình Ảnh Hồ Sơ</label>
                                        <input type="file" class="form-control" name="ImageFile" accept="image/*">
                                        @if (!string.IsNullOrEmpty(Model?.ImagePath))
                                        {
                                            <div class="mt-2">
                                                <img src="@Model.ImagePath" alt="Hình Ảnh Hiện Tại" class="img-thumbnail" style="max-height: 100px;">
                                                <small class="text-muted d-block">Hình ảnh hiện tại (để trống ô tải lên để giữ hình ảnh hiện tại)</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Chưa có hình ảnh</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phần Chi Tiết Chuyên Môn -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-primary">
                                    <i class="fas fa-graduation-cap me-2"></i>Chi Tiết Chuyên Môn
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="Awards" class="form-control" style="height: 120px" placeholder="Giải Thưởng và Ghi Nhận">@(Model?.Awards ?? "")</textarea>
                                            <label for="Awards">Giải Thưởng và Ghi Nhận</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="Expertise" class="form-control" style="height: 120px" placeholder="Lĩnh Vực Chuyên Môn">@(Model?.Expertise ?? "")</textarea>
                                            <label for="Expertise">Lĩnh Vực Chuyên Môn</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="Introduction" class="form-control" style="height: 150px" placeholder="Giới Thiệu Chuyên Môn">@(Model?.Introduction ?? "")</textarea>
                                            <label for="Introduction">Giới Thiệu Chuyên Môn</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phần Kinh Nghiệm Chuyên Môn -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-primary">
                                    <i class="fas fa-briefcase me-2"></i>Kinh Nghiệm Chuyên Môn
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="OrganizationMember" class="form-control" style="height: 120px" placeholder="Thành Viên Tổ Chức">@(Model?.OrganizationMember ?? "")</textarea>
                                            <label for="OrganizationMember">Thành Viên Tổ Chức</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="ResearchProject" class="form-control" style="height: 120px" placeholder="Dự Án Nghiên Cứu">@(Model?.ResearchProject ?? "")</textarea>
                                            <label for="ResearchProject">Dự Án Nghiên Cứu</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="TrainingProcess" class="form-control" style="height: 120px" placeholder="Đào Tạo và Giáo Dục">@(Model?.TrainingProcess ?? "")</textarea>
                                            <label for="TrainingProcess">Đào Tạo và Giáo Dục</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="WorkExperience" class="form-control" style="height: 150px" placeholder="Kinh Nghiệm Làm Việc">@(Model?.WorkExperience ?? "")</textarea>
                                            <label for="WorkExperience">Kinh Nghiệm Làm Việc</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nút Hành Động -->
                        <div class="col-12 text-center mt-4">
                            <button type="submit" class="btn btn-primary px-5 py-2 me-2">
                                <i class="fas fa-save me-2"></i>Lưu Thay Đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                <i class="fas fa-arrow-left me-2"></i>Quay Lại Danh Sách
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create.css" asp-append-version="true" />
    <style>
        .card-header {
            border-bottom: 2px solid #dee2e6;
        }
        .form-text small {
            font-size: 0.8rem;
            line-height: 1.4;
        }
        .form-floating textarea {
            min-height: 120px;
        }
        .img-thumbnail {
            border: 2px solid #dee2e6;
        }
    </style>
}