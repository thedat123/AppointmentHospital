@using AppointmentHospital.Areas.Admin.DTOs.ManagingDoctor;
@model ManagingDoctorResponse;
@{
    ViewData["Title"] = "Edit Doctor";
    var specializationList = ViewData["SpecializationList"] as List<SelectListItem> ?? new List<SelectListItem>();
}
<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-12 col-lg-10 mx-auto">
                    <form asp-action="EditDoctor" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" name="Id" value="@(Model?.Id ?? Guid.Empty)" />
                        <input type="hidden" name="ImagePath" value="@(Model?.ImagePath ?? "")" />

                        <div class="text-center mb-4">
                            <h3 class="text-primary fw-bold">Edit Doctor Profile</h3>
                            <p class="text-muted">Update doctor's information below</p>
                        </div>

                        <!-- Basic Information Section -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-primary">
                                    <i class="fas fa-user-md me-2"></i>Basic Information
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input name="FullName" class="form-control" placeholder="Full Name" value="@(Model?.FullName ?? "")" required />
                                            <label for="FullName">Full Name</label>
                                            <span asp-validation-for="FullName" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input name="EmailAddress" type="email" class="form-control" placeholder="Email Address" value="@(Model?.EmailAddress ?? "")" required />
                                            <label for="EmailAddress">Email Address</label>
                                            <span asp-validation-for="EmailAddress" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input name="Degree" class="form-control" placeholder="Degree" value="@(Model?.Degree ?? "")" required />
                                            <label for="Degree">Degree</label>
                                            <span asp-validation-for="Degree" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select name="SpecialityId" class="form-select" required>
                                                <option value="">Select Specialization</option>
                                                @if (specializationList != null && specializationList.Any())
                                                {
                                                    @foreach(var specialization in specializationList)
                                                    {
                                                        if(specialization.Value == (Model?.SpecialityId.ToString() ?? ""))
                                                        {
                                                            <option value="@specialization.Value" selected>@specialization.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@specialization.Value">@specialization.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                            <label for="SpecialityId">Specialization</label>
                                            <span asp-validation-for="SpecialityId" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-bold">Profile Image</label>
                                        <input type="file" class="form-control" name="ImageFile" accept="image/*">
                                        @if (!string.IsNullOrEmpty(Model?.ImagePath))
                                        {
                                            <div class="mt-2">
                                                <img src="@Model.ImagePath" alt="Current Image" class="img-thumbnail" style="max-height: 100px;">
                                                <small class="text-muted d-block">Current image (leave file input empty to keep current image)</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">No current image</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Professional Details Section -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-primary">
                                    <i class="fas fa-graduation-cap me-2"></i>Professional Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="Awards" class="form-control" style="height: 120px" placeholder="Awards and Recognition">@(Model?.Awards ?? "")</textarea>
                                            <label for="Awards">Awards and Recognition</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="Expertise" class="form-control" style="height: 120px" placeholder="Areas of Expertise">@(Model?.Expertise ?? "")</textarea>
                                            <label for="Expertise">Areas of Expertise</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="Introduction" class="form-control" style="height: 150px" placeholder="Professional Introduction">@(Model?.Introduction ?? "")</textarea>
                                            <label for="Introduction">Professional Introduction</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Professional Experience Section -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-primary">
                                    <i class="fas fa-briefcase me-2"></i>Professional Experience
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="OrganizationMember" class="form-control" style="height: 120px" placeholder="Organization Memberships">@(Model?.OrganizationMember ?? "")</textarea>
                                            <label for="OrganizationMember">Organization Memberships</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="ResearchProject" class="form-control" style="height: 120px" placeholder="Research Projects">@(Model?.ResearchProject ?? "")</textarea>
                                            <label for="ResearchProject">Research Projects</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="TrainingProcess" class="form-control" style="height: 120px" placeholder="Training and Education">@(Model?.TrainingProcess ?? "")</textarea>
                                            <label for="TrainingProcess">Training and Education</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea name="WorkExperience" class="form-control" style="height: 150px" placeholder="Work Experience">@(Model?.WorkExperience ?? "")</textarea>
                                            <label for="WorkExperience">Work Experience</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 text-center mt-4">
                            <button type="submit" class="btn btn-primary px-5 py-2 me-2">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create.css" />
    <style>
        .card-header {
            border-bottom: 2px solid #dee2e6;
        }
        .form-text small {
            font-size: 0.8rem;
            line-height: 1.4;
        }
        .form-floating textarea {
            min-height: 120px;
        }
        .img-thumbnail {
            border: 2px solid #dee2e6;
        }
    </style>
}