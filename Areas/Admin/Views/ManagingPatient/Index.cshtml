@using AppointmentHospital.Areas.Admin.DTOs.AdminDashBoard;
@using AppointmentHospital.Helpers;
@{
    var patientList = ViewBag.PatientList as Pagination<ManagingPatientResponse>;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="card shadow-sm mb-4">
    <div class="card-body search-wrapper">
        <form method="get" asp-action="Index" class="row g-3 align-items-end justify-content-center">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="col-md-5">
                <label class="form-label">Tìm kiếm bệnh nhân</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input name="searchTerm" class="form-control" placeholder="Nhập tên bệnh nhân..."
                        value="@searchTerm">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0 text-dark">Danh sách bệnh nhân</h5>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-dark text-decoration-none">Họ và tên</th>
                        <th class="text-dark text-decoration-none">Email</th>
                        <th class="text-dark text-decoration-none">Địa chỉ</th>
                        <th class="text-dark text-decoration-none">Ngày sinh</th>
                        <th class="text-dark text-decoration-none">Số điện thoại</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in patientList)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="ms-2">
                                        <h6 class="mb-0">@patient.FullName</h6>
                                        <small class="text-muted">ID: @patient.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>@patient.EmailAddress</td>
                            <td>@patient.Address</td>
                            <td>@patient.DateOfBirth</td>
                            <td>@patient.PhoneNumber</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <a asp-action="EditPatient" asp-route-id="@patient.Id" class="btn btn-outline-primary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="DeletePatient" asp-route-id="@patient.Id" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        int totalPages = Model.TotalPage;
        int currentPage = Model.CurrentPage;
        int maxDisplayedPages = 7;
        int startPage = Math.Max(1, currentPage - 3);
        int endPage = Math.Min(totalPages, currentPage + 3);

        if (totalPages > maxDisplayedPages)
        {
            if (currentPage <= 4)
            {
                startPage = 1;
                endPage = maxDisplayedPages;
            }
            else if (currentPage >= totalPages - 3)
            {
                startPage = totalPages - maxDisplayedPages + 1;
                endPage = totalPages;
            }
        }
        else
        {
            startPage = 1;
            endPage = totalPages;
        }

        // Helper method để tạo route values với filter parameters
        object CreateRouteValues(int page)
        {
            var routeValues = new RouteValueDictionary { { "page", page } };
            
            if (!string.IsNullOrEmpty(searchTerm))
            {
                routeValues.Add("searchTerm", searchTerm);
            }
            
            return routeValues;
        }
    }

    <div class="d-flex justify-content-center align-items-center p-4">
        <nav aria-label="Điều hướng phân trang" class="mx-auto">
            <ul class="pagination pagination-rounded mb-0">

                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(Model.CurrentPage - 1))" aria-label="Trang trước">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(1))">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(i))">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(totalPages))">@totalPages</a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(Model.CurrentPage + 1))" aria-label="Trang sau">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/managing-patient.css" />
}
