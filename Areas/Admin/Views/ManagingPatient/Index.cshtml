@using AppointmentHospital.Areas.Admin.DTOs.AdminDashBoard;
@using AppointmentHospital.Helpers;
@{
    var patientList = ViewBag.PatientList as Pagination<ManagingPatientResponse>;
    var searchTerm = ViewBag.SearchTerm as string;
    var statusFilter = ViewBag.StatusFilter as string;
    var isDeletedFilter = ViewBag.IsDeletedFilter as string;
}

<div class="card shadow-sm mb-4">
    <div class="card-body search-wrapper">
        <form method="get" asp-action="Index" class="row g-3 align-items-end justify-content-center">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="col-md-5">
                <label class="form-label">Tìm kiếm bệnh nhân</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input name="searchTerm" class="form-control" placeholder="Nhập tên bệnh nhân..."
                           value="@searchTerm">
                    <input type="hidden" name="statusFilter" id="statusFilter" value="@statusFilter">
                    <input type="hidden" name="isDeletedFilter" id="isDeletedFilter" value="@isDeletedFilter">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Tìm kiếm
                </button>
            </div>
            <div class="col-md-2">
                <button type="button" id="toggleBannedFilter" class="btn btn-primary w-100">
                    @(statusFilter == "banned" ? "Xem tất cả bệnh nhân" : "Xem bệnh nhân bị cấm")
                </button>
            </div>
            <div class="col-md-2">
                <button type="button" id="toggleDeletedFilter" class="btn btn-primary w-100">
                    @(isDeletedFilter == "deleted" ? "Xem bệnh nhân chưa xóa" : "Xem bệnh nhân đã xóa")
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0 text-dark">Danh sách bệnh nhân @(statusFilter == "banned" ? "(Bị cấm)" : "") @(isDeletedFilter == "deleted" ? "(Đã xóa)" : "")</h5>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-dark text-decoration-none">Họ và tên</th>
                        <th class="text-dark text-decoration-none">Email</th>
                        <th class="text-dark text-decoration-none">Địa chỉ</th>
                        <th class="text-dark text-decoration-none">Ngày sinh</th>
                        <th class="text-dark text-decoration-none">Số điện thoại</th>
                        <th class="text-dark text-decoration-none">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in patientList)
                    {
                        <tr class="@(patient.IsDeleted ? "table-danger" : patient.IsBanned ? "table-warning" : "")">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="ms-2">
                                        <h6 class="mb-0">@patient.FullName</h6>
                                        <small class="text-muted">ID: @patient.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>@patient.EmailAddress</td>
                            <td>@patient.Address</td>
                            <td>@patient.DateOfBirth</td>
                            <td>@patient.PhoneNumber</td>
                            <td>
                                @(patient.IsDeleted ? "Đã xóa" : patient.IsBanned ? "Bị cấm" : "Hoạt động")
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <a asp-action="EditPatient" asp-route-id="@patient.Id" class="btn btn-outline-primary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    @if (!patient.IsDeleted)
                                    {
                                        <a href="javascript:void(0)" class="btn btn-outline-danger soft-delete-btn" data-id="@patient.Id" title="Xóa mềm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="javascript:void(0)" class="btn btn-outline-success restore-btn" data-id="@patient.Id" title="Khôi phục">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </a>
                                    }
                                    @if (!patient.IsDeleted)
                                    {
                                        if (patient.IsBanned)
                                        {
                                            <a href="javascript:void(0)" class="btn btn-outline-success unban-btn" data-id="@patient.Id" title="Bỏ cấm">
                                                <i class="bi bi-check-circle"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0)" class="btn btn-outline-warning ban-btn" data-id="@patient.Id" title="Cấm">
                                                <i class="bi bi-exclamation-circle"></i>
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        int totalPages = patientList.TotalPage;
        int currentPage = patientList.CurrentPage;
        int maxDisplayedPages = 7;
        int startPage = Math.Max(1, currentPage - 3);
        int endPage = Math.Min(totalPages, currentPage + 3);

        if (totalPages > maxDisplayedPages)
        {
            if (currentPage <= 4)
            {
                startPage = 1;
                endPage = maxDisplayedPages;
            }
            else if (currentPage >= totalPages - 3)
            {
                startPage = totalPages - maxDisplayedPages + 1;
                endPage = totalPages;
            }
        }
        else
        {
            startPage = 1;
            endPage = totalPages;
        }

        object CreateRouteValues(int page)
        {
            var routeValues = new RouteValueDictionary { { "page", page } };
            if (!string.IsNullOrEmpty(searchTerm))
            {
                routeValues.Add("searchTerm", searchTerm);
            }
            if (!string.IsNullOrEmpty(statusFilter))
            {
                routeValues.Add("statusFilter", statusFilter);
            }
            if (!string.IsNullOrEmpty(isDeletedFilter))
            {
                routeValues.Add("isDeletedFilter", isDeletedFilter);
            }
            return routeValues;
        }
    }

    <div class="d-flex justify-content-center align-items-center p-4">
        <nav aria-label="Điều hướng phân trang" class="mx-auto">
            <ul class="pagination pagination-rounded mb-0">
                @if (patientList.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(patientList.CurrentPage - 1))" aria-label="Trang trước">
                            <span aria-hidden="true">«</span>
                        </a>
                    </li>
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(1))">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(i))">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(totalPages))">@totalPages</a>
                    </li>
                }
                @if (patientList.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "ManagingPatient", CreateRouteValues(patientList.CurrentPage + 1))" aria-label="Trang sau">
                            <span aria-hidden="true">»</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/managing-patient.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleStatusFilter() {
            const statusFilterInput = document.getElementById('statusFilter');
            const currentStatus = statusFilterInput.value;
            statusFilterInput.value = currentStatus === 'banned' ? '' : 'banned';
            document.querySelector('form').submit();
        }

        function toggleDeletedFilter() {
            const isDeletedFilterInput = document.getElementById('isDeletedFilter');
            const currentDeletedStatus = isDeletedFilterInput.value;
            isDeletedFilterInput.value = currentDeletedStatus === 'deleted' ? '' : 'deleted';
            document.querySelector('form').submit();
        }

        // Add event listeners for toggle buttons
        document.getElementById('toggleBannedFilter').addEventListener('click', toggleStatusFilter);
        document.getElementById('toggleDeletedFilter').addEventListener('click', toggleDeletedFilter);

        document.querySelectorAll('.soft-delete-btn').forEach(button => {
            button.addEventListener('click', function () {
                const patientId = this.getAttribute('data-id');
                Swal.fire({
                    title: 'Xác nhận xóa mềm',
                    text: 'Bạn có chắc muốn xóa mềm bệnh nhân này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = `/ManagingPatient/DeletePatient?id=${patientId}`;
                    }
                });
            });
        });

        document.querySelectorAll('.ban-btn').forEach(button => {
            button.addEventListener('click', function () {
                const patientId = this.getAttribute('data-id');
                Swal.fire({
                    title: 'Xác nhận cấm',
                    text: 'Bạn có chắc muốn cấm bệnh nhân này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Cấm',
                    cancelButtonText: 'Hủy'
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = `/ManagingPatient/BanPatient?id=${patientId}`;
                    }
                });
            });
        });

        document.querySelectorAll('.unban-btn').forEach(button => {
            button.addEventListener('click', function () {
                const patientId = this.getAttribute('data-id');
                Swal.fire({
                    title: 'Xác nhận bỏ cấm',
                    text: 'Bạn có chắc muốn bỏ cấm bệnh nhân này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Bỏ cấm',
                    cancelButtonText: 'Hủy'
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = `/ManagingPatient/UnbanPatient?id=${patientId}`;
                    }
                });
            });
        });

        document.querySelectorAll('.restore-btn').forEach(button => {
            button.addEventListener('click', function () {
                const patientId = this.getAttribute('data-id');
                Swal.fire({
                    title: 'Xác nhận khôi phục',
                    text: 'Bạn có chắc muốn khôi phục bệnh nhân này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Khôi phục',
                    cancelButtonText: 'Hủy'
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = `/ManagingPatient/RestorePatient?id=${patientId}`;
                    }
                });
            });
        });
    </script>
}