@using AppointmentHospital.Models;
@using AppointmentHospital.EnumStatus;
@model Doctor;
@{
    var specializations = ViewBag.Specializaiton as List<SelectListItem>;
}
<div class="profile-container">
    <div class="profile-header">
        <div class="profile-avatar">
            <img src="@Url.Content(string.IsNullOrEmpty(Model.ImagePath) ? "~/images/user-default.png" : $"~/images/{Model.ImagePath}")"
                 alt="@Model.FullName" class="w-100 h-100 object-fit-cover">
        </div>
        <div class="profile-title">
            <h2>@Model.FullName</h2>
        </div>
    </div>

    <form id="submitForm" asp-action="UpdateProfile" method="post" class="profile-form">
        <div class="profile-section">
            <h3>Thông tin cá nhân</h3>
            <div asp-validation-summary="All"></div>
            <div class="form-grid">
                <input asp-for="@Model.DoctorId" class="form-control" type="hidden" value="@Model.DoctorId" />
                <div class="form-group">
                    <label asp-for="@Model.FullName">Họ và tên</label>
                    <input asp-for="@Model.FullName" class="form-control" required />
                    <span asp-validation-for="@Model.FullName"></span>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <h3>Thông tin chuyên môn</h3>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="@Model.Specialities.SpecialityName">Chuyên khoa</label>
                    <select asp-for="@Model.Specialities.Id" class="form-select" disabled>
                        <option value="" disabled>Chọn chuyên khoa</option>
                        @foreach (var specialization in specializations)
                        {
                            <option value="@specialization.Value" selected="@(specialization.Value == Model.Specialities.Id.ToString() ? "selected" : null)">@specialization.Text</option>
                        }
                    </select>
                    <span asp-validation-for="@Model.Specialities.SpecialityName"></span>
                </div>
                <div class="form-group">
                    <label asp-for="@Model.Degree">Bằng cấp</label>
                    <input asp-for="@Model.Degree" class="form-control" />
                    <span asp-validation-for="@Model.Degree"></span>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <h3>Thông tin liên hệ</h3>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="@Model.User.Email">Email</label>
                    <input asp-for="@Model.User.Email" type="email" class="form-control" readonly />
                    <span asp-validation-for="@Model.User.Email"></span>
                </div>
                <div class="form-group">
                    <label asp-for="@Model.User.PhoneNumber">Số điện thoại</label>
                    <input name="phoneNumber" value="@Model.User.PhoneNumber" class="form-control" />
                    <span asp-validation-for="@Model.User.PhoneNumber"></span>
                </div>
            </div>
        </div>

        <div class="button-group">
            <button type="submit" id="buttonSubmit" class="btn btn-primary">
                <i class="fas fa-save"></i> Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-profile.css" />
}
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buttonSubmit = document.getElementById('buttonSubmit');
            const submitForm = document.getElementById('submitForm');
            if (buttonSubmit && submitForm) {
                buttonSubmit.addEventListener('click', function (e) {
                    e.preventDefault();
                    buttonSubmit.disabled = true;
                    Swal.fire({
                        title: 'Update Information',
                        text: 'Are you sure to update information?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Accept',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            submitForm.submit();
                        }
                    });
                    buttonSubmit.disabled = false;
                });
                
            }
        })
    </script>
}