﻿@using AppointmentHospital.EnumStatus
@model List<AppointmentHospital.Models.Appointment>

<link rel="stylesheet" href="~/css/doctor-calendar.css" asp-append-version="true" />    
<link rel="stylesheet" href="~/css/doctor-index.css" asp-append-version="true" />  

<div class="container py-5">
    <div class="mb-5">
        <div class="card gradient-card border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-circle bg-white bg-opacity-25">
                            <i class="fas fa-stethoscope text-white fa-lg"></i>
                        </div>
                        <h1 class="h3 text-white mb-0">Appointments</h1>
                    </div>
                    <div class="bg-white status-badge">
                        <i class="fas fa-user-md text-primary me-2"></i>
                        <span class="fw-semibold text-primary">Dr. @ViewBag.DoctorName</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        @{
            var statCards = new[]
            {
                (AppointmentStatus.Pending, (int)ViewBag.Stats.PendingCount, "fa-clock", "#FFA500", "#FFF5E6"),
                (AppointmentStatus.Confirmed, (int)ViewBag.Stats.ConfirmedCount, "fa-check-circle", "#10B981", "#ECFDF5"),
                (AppointmentStatus.Completed, (int)ViewBag.Stats.CompletedCount, "fa-check-double", "#3B82F6", "#EFF6FF"),
                (AppointmentStatus.Canceled, (int)ViewBag.Stats.CanceledCount, "fa-times-circle", "#6B7280", "#F3F4F6")
            };
        }
        @foreach (var (status, count, icon, color, bgColor) in statCards)
        {
            <div class="col-md-3">
                <div class="card stat-card h-100 border-0 shadow-sm" style="background: @bgColor">
                    <div class="card-body p-4">
                        <div class="text-center">
                            <div class="icon-circle mb-3 mx-auto" style="background: @color">
                                <i class="fas @icon text-white"></i>
                            </div>
                            <h6 class="text-muted mb-2">@status</h6>
                            <h3 class="fw-bold mb-0" style="color: @color">@count</h3>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" 
                               class="form-control form-control-lg border-0 bg-light" 
                               id="searchInput" 
                               placeholder="Search patients or symptoms...">
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    @foreach (var (status, icon) in new[]
                    {
                        (AppointmentStatus.Pending, "fa-clock"),
                        (AppointmentStatus.Confirmed, "fa-check-circle"),
                        (AppointmentStatus.Completed, "fa-check-double"),
                        (AppointmentStatus.Canceled, "fa-times-circle")
                    })
                    {
                        <a asp-action="Index" 
                           asp-route-status="@status" 
                           class="btn @(ViewBag.SelectedStatus == status 
                                      ? "btn-primary" 
                                      : "btn-outline-primary") 
                                  btn-rounded me-2 mb-2">
                            <i class="fas @icon me-1"></i> @status
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0 ps-4">#</th>
                        <th class="border-0">Schedule</th>
                        <th class="border-0">Patient</th>
                        <th class="border-0">Symptoms</th>
                        <th class="border-0 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var appointment = Model[i];
                            <tr>
                                <td class="ps-4">@(i + 1)</td>
                                <td>
                                    <div class="fw-semibold">@appointment.AppointmentTime.ToString("dddd, MMMM d, yyyy")</div>
                                    <div class="small text-muted">@appointment.AppointmentTime.ToString("h:mm tt")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        @(
                                            appointment.Acquaintance?.Name != null 
                                            ? appointment.Acquaintance.Name 
                                            : appointment.Patient.FullName
                                        )
                                    </div>
                                    <div class="small text-muted">
                                        @(
                                            appointment.Acquaintance?.DateOfBirth != null 
                                            ? appointment.Acquaintance.DateOfBirth
                                            : appointment.Patient.DateOfBirth
                                        ) 
                                        | 
                                        @(
                                            !string.IsNullOrEmpty(appointment.Acquaintance?.Address) 
                                            ? appointment.Acquaintance.Address 
                                            : appointment.Patient.Address
                                        )
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" title="@appointment.Symptoms">
                                        @(
                                            !string.IsNullOrEmpty(appointment.Symptoms) 
                                            ? appointment.Symptoms 
                                            : "No Symptoms Provided"
                                        )
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (appointment.Status == AppointmentHospital.EnumStatus.AppointmentStatus.Pending)
                                    {
                                        <form action="/Doctor/UpdateStatus" method="post" class="d-inline-flex gap-2">
                                            <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                            <button type="submit" 
                                                    name="status" 
                                                    value="1" 
                                                    class="btn btn-success btn-sm btn-rounded">
                                                <i class="fas fa-check me-1"></i> Confirm
                                            </button>
                                            <button type="submit" 
                                                    name="status" 
                                                    value="3" 
                                                    class="btn btn-danger btn-sm btn-rounded">
                                                <i class="fas fa-times me-1"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    else if (appointment.Status == AppointmentHospital.EnumStatus.AppointmentStatus.Confirmed)
                                    {
                                        <a asp-controller="Doctor" 
                                           asp-action="StartDiagnosis" 
                                           asp-route-id="@appointment.AppointmentId"
                                           class="btn btn-primary btn-sm btn-rounded">
                                            <i class="fas fa-stethoscope me-1"></i> Start diagnosis
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-calendar-times fa-3x mb-3"></i>
                                    <p class="mb-0">No appointments available</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/scheduleHub')
            .build();

        connection.start()
            .then(() => {
                console.log("Connected to SignalR Hub");
            })
            .catch(err => console.error("SignalR connection error:", err));

        connection.on("UpdateStatus", (appointmentId, status) => {
            console.log(`Appointment ${appointmentId} updated to status ${status}`);

            const scrollPosition = window.scrollY;
            window.location.reload();
            window.scrollTo(0, scrollPosition);
        });
    });
</script>