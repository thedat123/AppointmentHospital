@model List<Appointment>
<link rel="stylesheet" href="~/css/doctor-calendar.css" asp-append-version="true" />
<div class="container">
    <header class="page-header">
        <h1 class="page-title">MANAGE DOCTOR'S APPOINTMENT SCHEDULE</h1>
    </header>

    <section class="filter-section">
        <div class="filter-row">
            <div class="filter-item">
                <label for="doctor-name">Doctor</label>
                <input type="text" id="doctor-name" class="filter-input" value="HA QUOC HUNG" readonly>
            </div>
        </div>

        <div class="status-filters">
            <div class="status-radio">
                <button class="btn btn-primary">New Appointment</button>
            </div>
            <div class="status-radio">
                <button class="btn btn-primary">Confirmed</button>
            </div>
            <div class="status-radio">
                <button class="btn btn-primary">Completed</button>
            </div>
            <div class="status-radio">
                <button class="btn btn-primary">Cancelled</button>
            </div>
        </div>
    </section>

    <table class="appointment-table">
        <thead class="table-header">
            <tr>
                <th>No.</th>
                <th>Time</th>
                <th>Full Name</th>
                <th>Date Of Birth</th>
                <th>Gender</th>
                <th>Address</th>
                <th>Symptoms</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                var appointment = Model[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>
                        @appointment.AppointmentTime.ToString("dddd, MMMM d, yyyy h:mm tt")
                    </td>
                    <td>
                        @appointment.Patient.FullName
                    </td>
                    <td>
                        @(appointment.Patient.DateOfBirth)
                    </td>
                    <td>
                        
                    </td>
                    <td>
                        @appointment.Patient.Address
                    </td>
                    <td>
                        @appointment.Symptoms
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-confirm">Confirm</button>
                            <button class="btn btn-cancel">Cancel</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
