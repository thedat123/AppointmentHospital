@using AppointmentHospital.EnumStatus
@model List<AppointmentHospital.Models.Appointment>

<link rel="stylesheet" href="~/css/doctor-calendar.css" asp-append-version="true" />    

<div class="container py-5">
    <div class="mb-5">
        <div class="card bg-gradient-to-r from-blue-600 to-blue-800 border-0 rounded-lg shadow-lg">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 p-3 rounded-circle">
                            <i class="fas fa-stethoscope text-white fa-lg"></i>
                        </div>
                        <h1 class="h3 text-white mb-0">Appointments</h1>
                    </div>
                    <div class="bg-white px-4 py-2 rounded-pill">
                        <i class="fas fa-user-md text-blue-600 me-2"></i>
                        <span class="fw-semibold text-blue-600">Dr. @ViewBag.DoctorName</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        @{
            var statCards = new[]
            {
                (AppointmentStatus.Pending, (int)ViewBag.Stats.PendingCount, "fa-clock", "#FFA500", "#FFF5E6"),
                (AppointmentStatus.Confirmed, (int)ViewBag.Stats.ConfirmedCount, "fa-check-circle", "#10B981", "#ECFDF5"),
                (AppointmentStatus.Completed, (int)ViewBag.Stats.CompletedCount, "fa-check-double", "#3B82F6", "#EFF6FF"),
                (AppointmentStatus.Canceled, (int)ViewBag.Stats.CanceledCount, "fa-times-circle", "#6B7280", "#F3F4F6")
            };
        }
        @foreach (var (status, count, icon, color, bgColor) in statCards)
        {
            <div class="col-md-3">
                <div class="card border-0 rounded-lg shadow-sm h-100" style="background: @bgColor">
                    <div class="card-body p-4 d-flex flex-column align-items-center">
                        <div class="rounded-circle p-3 mb-3" style="background: @color">
                            <i class="fas @icon fa-lg text-white"></i>
                        </div>
                        <h6 class="text-gray-600 mb-1">@status</h6>
                        <h3 class="fw-bold mb-0" style="color: @color">@count</h3>
                    </div>
                </div>
            </div>
        }
    </div>


    <div class="card border-0 rounded-lg shadow-sm mb-5">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-gray-100">
                            <i class="fas fa-search text-gray-400"></i>
                        </span>
                        <input type="text" class="form-control border-0 bg-gray-100" 
                               id="searchInput" placeholder="Search patients or symptoms...">
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    @foreach (var (status, icon) in new[]
                    {
                        (AppointmentStatus.Pending, "fa-clock"),
                        (AppointmentStatus.Confirmed, "fa-check-circle"),
                        (AppointmentStatus.Completed, "fa-check-double"),
                        (AppointmentStatus.Canceled, "fa-times-circle")
                    })
                    {
                        <a asp-action="Index" asp-route-status="@status" 
                           class="btn btn-outline-primary rounded-pill me-2 mb-2">
                            <i class="fas @icon me-1"></i> @status
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Appointments Table -->
    <div class="card border-0 rounded-lg shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="border-0 px-4 py-3">#</th>
                        <th class="border-0 px-4 py-3">Schedule</th>
                        <th class="border-0 px-4 py-3">Patient</th>
                        <th class="border-0 px-4 py-3">Symptoms</th>
                        <th class="border-0 px-4 py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var appointment = Model[i];
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3">@(i + 1)</td>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold">@appointment.AppointmentTime.ToString("dddd, MMMM d, yyyy")</div>
                                    <div class="text-sm text-gray-500">@appointment.AppointmentTime.ToString("h:mm tt")</div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold">@appointment.Patient.FullName</div>
                                    <div class="text-sm text-gray-500">
                                        @appointment.Patient.DateOfBirth | @appointment.Patient.Address
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-truncate" style="max-width: 200px;" 
                                    title="@appointment.Symptoms">
                                    @appointment.Symptoms
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <form action="/Doctor/UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                        <button type="submit" name="status" value="1" 
                                                class="btn btn-sm btn-success rounded-pill me-2">
                                            <i class="fas fa-check me-1"></i> Confirm
                                        </button>
                                        <button type="submit" name="status" value="3" 
                                                class="btn btn-sm btn-danger rounded-pill">
                                            <i class="fas fa-times me-1"></i> Cancel
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-gray-500">
                                    <i class="fas fa-calendar-times fa-3x mb-3"></i>
                                    <p class="mb-0">No appointments available</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>