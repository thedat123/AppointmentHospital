@model AppointmentHospital.Models.Appointment
<link rel="stylesheet" href="~/css/start-diagnosis.css" asp-append-version="true" />    

<div class="diagnosis-container">
    <div class="header-section">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="header-icon">
                <i class="fas fa-stethoscope"></i>
            </div>
            <h1 class="mb-0">Patient Diagnosis</h1>
        </div>
    </div>

    <!-- Patient Card -->
    <div class="patient-card mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-user-circle me-2"></i>
                    Patient Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Full Name</label>
                            <p class="info-value">@(
                                                    @Model.Acquaintance?.Name != null 
                                                    ? @Model.Acquaintance.Name
                                                    : @Model.Patient.FullName
                                                )</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Date of Birth</label>
                            <p class="info-value">
                                                @(
                                                    @Model.Acquaintance?.DateOfBirth != null 
                                                    ? @Model.Acquaintance.DateOfBirth.ToString("MMMM d, yyyy")
                                                    : @Model.Patient.DateOfBirth?.ToString("MMMM d, yyyy")
                                                )
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Appointment Time</label>
                            <p class="info-value">@Model.AppointmentTime.ToString("dddd, MMMM d, yyyy - h:mm tt")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Address</label>
                            <p class="info-value">@(
                                                    @Model.Acquaintance?.Address != null 
                                                    ? @Model.Acquaintance.Address
                                                    : @Model.Patient.Address
                                                )</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Symptoms & Diagnosis Section -->
    <div class="row g-4 mb-4">
        <!-- Symptoms Card -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-notes-medical me-2"></i>
                        Symptoms
                    </h5>
                </div>
                <div class="card-body">
                    <p class="symptoms-text">@Model.Symptoms</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-diagnoses me-2"></i>
                        Diagnosis Details
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Doctor" asp-action="SubmitDiagnosis" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
                        <input type="hidden" name="PatientId" value="@Model.PatientId" />
                        <input type="hidden" name="DoctorId" value="@Model.DoctorId" />
                        <input type="hidden" name="AcquaintanceId" value="@(Model.AcquaintanceId ?? null)" />

                        <div class="mb-3">
                            <textarea 
                                name="DiagnosisDetails" 
                                class="form-control diagnosis-textarea" 
                                rows="6" 
                                placeholder="Enter your detailed diagnosis here..."
                                required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="PrescribedMedications" class="form-label">Prescribed Medications</label>
                            <div id="prescribedMedicationsContainer" name="PrescribedMedications">
                                <div class="d-flex mb-2 medication-row">
                                    <div class="position-relative flex-grow-1 me-2">
                                        <input 
                                            type="text" 
                                            class="form-control drug-input" 
                                            placeholder="Enter drug name..." 
                                            required />
                                        <ul class="drug-suggestions dropdown-menu" style="display: none; max-height: 200px; overflow-y: auto; z-index: 1000;"></ul>
                                    </div>

                                    <div class="flex-shrink-0 me-2" style="width: 100px;">
                                        <input 
                                            type="number" 
                                            class="form-control quantity-input" 
                                            placeholder="Qty" 
                                            min="1" 
                                            required />
                                    </div>

                                    <!-- Remove Button -->
                                    <button type="button" class="btn btn-danger remove-row">Remove</button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary mt-2" id="addMedication">Add Medication</button>
                            <input type="hidden" id="PrescribedMedications" name="PrescribedMedications" />
                        </div>

                        <div class="mb-3">
                            <label for="DoctorNotes" class="form-label">Doctor's Notes</label>
                            <textarea 
                                name="DoctorNotes" 
                                class="form-control" 
                                rows="3" 
                                placeholder="Enter any additional notes or reminders for the patient..."></textarea>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save me-2"></i>
                                Save Diagnosis
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <i class="fas fa-history me-2"></i>
                Medical History
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Diagnosis</th>
                            <th>Doctor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* @if (Model.Patient.MedicalHistory != null && Model.Patient.MedicalHistory.Any())
                        {
                            @foreach (var history in Model.Patient.MedicalHistory)
                            {
                                <tr>
                                    <td>@history.DiagnosisDate.ToString("MM/dd/yyyy")</td>
                                    <td>@history.Details</td>
                                    <td>Dr. @history.Doctor</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">
                                    <i class="fas fa-info-circle me-2"></i>
                                    No medical history available
                                </td>
                            </tr>
                        } *@
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/scheduleHub')
            .build();

        connection.start()
            .then(() => {
                console.log("Connected to SignalR Hub");
            })
            .catch(err => console.error("SignalR connection error:", err));

        connection.on("UpdatePatientProfile", (patient) => {
            console.log(`Information is updated`);

            const scrollPosition = window.scrollY;
            window.location.reload();
            window.scrollTo(0, scrollPosition);
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('prescribedMedicationsContainer');
    const addButton = document.getElementById('addMedication');
    const hiddenInput = document.getElementById('PrescribedMedications');

    function updateHiddenInput() {
        const rows = container.querySelectorAll('.medication-row');
        const prescriptions = [];

        rows.forEach(row => {
            const drugName = row.querySelector('.drug-input').value.trim();
            const quantity = row.querySelector('.quantity-input').value.trim();

            if (drugName && quantity) {
                prescriptions.push(`${drugName}-${quantity}`);
            }
        });

        hiddenInput.value = prescriptions.join(',');
    }


    addButton.addEventListener('click', function () {
        const newRow = document.createElement('div');
        newRow.classList.add('d-flex', 'mb-2', 'medication-row');

        newRow.innerHTML = `
            <div class="position-relative flex-grow-1 me-2">
                <input 
                    type="text" 
                    class="form-control drug-input" 
                    placeholder="Enter drug name..." 
                    required />
                <ul class="dropdown-menu drug-suggestions" style="display: none; max-height: 200px; overflow-y: auto; z-index: 1000;"></ul>
            </div>
            <div class="flex-shrink-0 me-2" style="width: 100px;">
                <input 
                    type="number" 
                    class="form-control quantity-input" 
                    placeholder="Qty" 
                    min="1" 
                    required />
            </div>
            <button type="button" class="btn btn-danger remove-row">Remove</button>
        `;

        container.appendChild(newRow);
        updateHiddenInput();
    });

    container.addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-row')) {
            const row = e.target.closest('.medication-row');
            container.removeChild(row);
            updateHiddenInput();
        }
    });

    container.addEventListener('input', async function (e) {
        if (e.target.classList.contains('drug-input')) {
            const drugInput = e.target;
            const suggestions = drugInput.nextElementSibling;
            const query = drugInput.value.trim();

            if (query) {
                try {
                    const response = await fetch(`/Doctor/Search?query=${encodeURIComponent(query)}`);
                    const data = await response.json();
                    const drugs = data.$values;
                    suggestions.innerHTML = '';

                    if (drugs.length === 0) {
                        suggestions.style.display = 'none';
                        return;
                    }
                    drugs.forEach(drug => {
                        const listItem = document.createElement('li');
                        listItem.textContent = drug;
                        listItem.classList.add('dropdown-item');
                        listItem.style.cursor = 'pointer';
                        suggestions.appendChild(listItem);

                        listItem.addEventListener('click', () => {
                            drugInput.value = drug;
                            suggestions.style.display = 'none';
                        });
                    });

                    suggestions.style.display = 'block';
                } catch (error) {
                    console.error('Error fetching drug suggestions:', error);
                    suggestions.style.display = 'none';
                }
            } else {
                suggestions.style.display = 'none';
            }
        }
    });

    container.addEventListener('input', function () {
        updateHiddenInput();
    });

    container.addEventListener('keydown', function (e) {
        if (e.target.classList.contains('drug-input')) {
            const drugInput = e.target;
            const suggestions = drugInput.nextElementSibling; // UL element

            if (suggestions.style.display === 'block') {
                const items = suggestions.querySelectorAll('li');
                let selectedIndex = Array.from(items).findIndex(item => item.classList.contains('active'));

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (selectedIndex < items.length - 1) {
                        if (selectedIndex >= 0) items[selectedIndex].classList.remove('active');
                        selectedIndex++;
                        items[selectedIndex].classList.add('active');
                        items[selectedIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    } else if (selectedIndex === -1 && items.length > 0) {
                        selectedIndex = 0;
                        items[selectedIndex].classList.add('active');
                        items[selectedIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    }
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (selectedIndex > 0) {
                        items[selectedIndex].classList.remove('active');
                        selectedIndex--;
                        items[selectedIndex].classList.add('active');
                        items[selectedIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    }
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedIndex >= 0) {
                        drugInput.value = items[selectedIndex].textContent;
                        suggestions.style.display = 'none';
                    }
                }
            }
        }
    });

    // Ẩn danh sách khi nhấp ra ngoài
    document.addEventListener('click', function (e) {
        const isInsideContainer = container.contains(e.target);
        if (!isInsideContainer) {
            const allSuggestions = container.querySelectorAll('.drug-suggestions');
            allSuggestions.forEach(suggestions => suggestions.style.display = 'none');
        }
    });
});

</script>
