@model AppointmentHospital.Models.Appointment
@{
    var diagnosisHistory = ViewData["DiagnosisHistory"] as List<DiagnosisHistory>;
}
<link rel="stylesheet" href="~/css/start-diagnosis.css" asp-append-version="true" />    

<div class="diagnosis-container">
    <div class="header-section">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="header-icon">
                <i class="fas fa-stethoscope"></i>
            </div>
            <h1 class="mb-0">Patient Diagnosis</h1>
        </div>
    </div>
    <div class="patient-card mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-user-circle me-2"></i>
                    Patient Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Full Name</label>
                            <p class="info-value">@(
                                @Model.Acquaintance?.Name != null
                                ? @Model.Acquaintance.Name
                                : @Model.Patient.FullName
                                )</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Date of Birth</label>
                            <p class="info-value">
                                @(
                                    @Model.Acquaintance?.DateOfBirth != null
                                    ? @Model.Acquaintance.DateOfBirth.ToString("MMMM d, yyyy")
                                    : @Model.Patient.DateOfBirth?.ToString("MMMM d, yyyy")
                                    )
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Appointment Time</label>
                            <p class="info-value">@Model.AppointmentTime.ToString("dddd, MMMM d, yyyy - h:mm tt")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-group">
                            <label>Address</label>
                            <p class="info-value">@(
                                @Model.Acquaintance?.Address != null
                                ? @Model.Acquaintance.Address
                                : @Model.Patient.Address
                                )</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-notes-medical me-2"></i>
                        Symptoms
                    </h5>
                </div>
                <div class="card-body">
                    <p class="symptoms-text">@Model.Symptoms</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-diagnoses me-2"></i>
                        Diagnosis Details
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Doctor" id="submitForm" asp-action="SubmitDiagnosis" method="post"
                        enctype="multipart/form-data">
                        <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
                        <input type="hidden" name="PatientId" value="@Model.PatientId" />
                        <input type="hidden" name="DoctorId" value="@Model.DoctorId" />
                        <input type="hidden" name="AcquaintanceId" value="@(Model.AcquaintanceId ?? null)" />
                        <input type="hidden" name="DateTime" value="@Model.AppointmentTime" />

                        <div class="mb-3">
                            <textarea name="DiagnosisDetails" class="form-control diagnosis-textarea" rows="6"
                                placeholder="Enter your detailed diagnosis here..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="PrescribedMedications" class="form-label">Prescribed Medications</label>
                            <div id="prescribedMedicationsContainer" name="PrescribedMedications">
                                <div class="d-flex mb-2 medication-row">
                                    <div class="position-relative flex-grow-1 me-2">
                                        <input type="text" class="form-control drug-input"
                                            placeholder="Enter drug name..." required />
                                        <ul class="drug-suggestions dropdown-menu"
                                            style="display: none; max-height: 200px; overflow-y: auto; z-index: 1000;">
                                        </ul>
                                    </div>

                                    <div class="flex-shrink-0 me-2" style="width: 100px;">
                                        <input type="number" class="form-control quantity-input" placeholder="Qty"
                                            min="1" required />
                                    </div>

                                    <button type="button" class="btn btn-danger remove-row">Remove</button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary mt-2" id="addMedication">Add
                                Medication</button>
                            <input type="hidden" id="PrescribedMedications" name="PrescribedMedications" />
                        </div>

                        <div class="mb-3">
                            <label for="DoctorNotes" class="form-label">Doctor's Notes</label>
                            <textarea name="DoctorNotes" class="form-control" rows="3"
                                placeholder="Enter any additional notes or reminders for the patient..."></textarea>
                        </div>

                        <div class="text-end">
                            <button type="submit" id="buttonSubmit" class="btn btn-success btn-lg">
                                <i class="fas fa-save me-2"></i>
                                Save Diagnosis
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
    <div class="card-header bg-secondary text-white d-flex align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-history me-2"></i>
            Medical History
        </h5>
    </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="table-light">
                                <th class="py-3">Patient</th>
                                <th class="py-3">Diagnosis</th>
                                <th class="py-3">Notes</th>
                                <th class="py-3">Prescription</th>
                                <th class="py-3">Visit Date</th>
                                <th class="py-3">Doctor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (diagnosisHistory != null && diagnosisHistory.Any())
                            {
                                @foreach (var history in diagnosisHistory)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-medium">
                                                @(Model.Acquaintance?.Name ?? Model.Patient.FullName)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary diagnosis-badge px-3 py-2">
                                                @history.Diagnosis
                                            </span>
                                        </td>
                                        <td>
                                            <div class="note-cell text-truncate" 
                                                 data-bs-toggle="tooltip" 
                                                 data-bs-placement="top" 
                                                 title="@history.DoctorNote">
                                                @history.DoctorNote
                                            </div>
                                        </td>
                                        <td>
                                            @if (history.Prescription != null && history.Prescription.Any())
                                            {
                                                <div class="prescription-list">
                                                    @foreach (var medication in history.Prescription)
                                                    {
                                                        var parts = medication.Split('-');
                                                        var name = parts[0];
                                                        var quantity = parts.Length > 1 ? parts[1] : "N/A";
                                                        <div class="prescription-item">
                                                            <i class="fas fa-pills text-primary me-2"></i>
                                                            <span class="fw-medium">@name</span>
                                                            <span class="text-muted ms-1">- Qty: @quantity</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted fst-italic">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    No Prescription
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge date-badge px-3 py-2">
                                                @history.DateTime.ToString("dd/MM/yyyy")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="doctor-info">
                                                <div class="doctor-avatar">
                                                    <i class="fas fa-user-md text-primary"></i>
                                                </div>
                                                <div class="fw-medium">
                                                    Dr. @history.Doctor.FullName
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="fas fa-folder-open me-2"></i>
                                            No Medical History Available
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const DOM = {
        medicationContainer: document.getElementById('prescribedMedicationsContainer'),
        addButton: document.getElementById('addMedication'),
        hiddenInput: document.getElementById('PrescribedMedications'),
        submitButton: document.getElementById('buttonSubmit'),
        submitForm: document.getElementById('submitForm')
    };

    function initializeSignalR() {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/scheduleHub')
            .build();

        connection.start()
            .then(() => console.log("Connected to SignalR Hub"))
            .catch(err => console.error("SignalR connection error:", err));

        connection.on("UpdatePatientProfile", () => {
            const scrollPosition = window.scrollY;
            window.location.reload();
            window.scrollTo(0, scrollPosition);
        });
    }

    function setupFormSubmission() {
        if (DOM.submitButton && DOM.submitForm) {
            DOM.submitButton.addEventListener('click', (e) => {
                e.preventDefault();
                DOM.submitButton.disabled = true;

                Swal.fire({
                    title: 'Confirm Diagnosis',
                    text: 'Are you sure to confirm this diagnosis?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Accept',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        DOM.submitForm.submit();
                    }
                    DOM.submitButton.disabled = false;
                });
            });
        }
    }

    function updateHiddenInput() {
        const rows = DOM.medicationContainer.querySelectorAll('.medication-row');
        const prescriptions = Array.from(rows)
            .map(row => {
                const drugName = row.querySelector('.drug-input').value.trim();
                const quantity = row.querySelector('.quantity-input').value.trim();
                return drugName && quantity ? `${drugName}-${quantity}` : null;
            })
            .filter(Boolean);

        DOM.hiddenInput.value = prescriptions.join(',');
    }

    function createMedicationRow() {
        const row = document.createElement('div');
        row.classList.add('d-flex', 'mb-2', 'medication-row');
        row.innerHTML = `
            <div class="position-relative flex-grow-1 me-2">
                <input 
                    type="text" 
                    class="form-control drug-input" 
                    placeholder="Enter drug name..." 
                    required />
                <ul class="dropdown-menu drug-suggestions" style="display: none; max-height: 200px; overflow-y: auto; z-index: 1000;"></ul>
            </div>
            <div class="flex-shrink-0 me-2" style="width: 100px;">
                <input 
                    type="number" 
                    class="form-control quantity-input" 
                    placeholder="Qty" 
                    min="1" 
                    required />
            </div>
            <button type="button" class="btn btn-danger remove-row">Remove</button>
        `;
        return row;
    }

    async function handleDrugInput(drugInput) {
        const suggestions = drugInput.nextElementSibling;
        const query = drugInput.value.trim();

        if (!query) {
            suggestions.style.display = 'none';
            return;
        }

        try {
            const response = await fetch(`/Doctor/Search?query=${encodeURIComponent(query)}`);
            const data = await response.json();
            console.log(data);

            suggestions.innerHTML = '';

            if (data.length === 0) {
                suggestions.style.display = 'none';
                return;
            }

            data.forEach(drug => {
                const listItem = document.createElement('li');
                listItem.textContent = drug;
                listItem.classList.add('dropdown-item');
                listItem.style.cursor = 'pointer';

                listItem.addEventListener('click', () => {
                    drugInput.value = drug;
                    suggestions.style.display = 'none';
                    updateHiddenInput();
                });

                suggestions.appendChild(listItem);
            });

            suggestions.style.display = 'block';
        } catch (error) {
            console.error('Error fetching drug suggestions:', error);
            suggestions.style.display = 'none';
        }
    }

    function handleKeyboardNavigation(event, drugInput) {
        const suggestions = drugInput.nextElementSibling;
        if (suggestions.style.display !== 'block') return;

        const items = suggestions.querySelectorAll('li');
        let selectedIndex = Array.from(items).findIndex(item => item.classList.contains('active'));

        switch (event.key) {
            case 'ArrowDown':
                event.preventDefault();
                if (selectedIndex < items.length - 1) {
                    if (selectedIndex >= 0) items[selectedIndex].classList.remove('active');
                    selectedIndex++;
                    items[selectedIndex].classList.add('active');
                    items[selectedIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
                break;

            case 'ArrowUp':
                event.preventDefault();
                if (selectedIndex > 0) {
                    items[selectedIndex].classList.remove('active');
                    selectedIndex--;
                    items[selectedIndex].classList.add('active');
                    items[selectedIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
                break;

            case 'Enter':
                event.preventDefault();
                if (selectedIndex >= 0) {
                    drugInput.value = items[selectedIndex].textContent;
                    suggestions.style.display = 'none';
                    updateHiddenInput();
                }
                break;
        }
    }

    function setupEventListeners() {
        DOM.addButton.addEventListener('click', () => {
            const newRow = createMedicationRow();
            DOM.medicationContainer.appendChild(newRow);
            updateHiddenInput();
        });

        DOM.medicationContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-row')) {
                const row = e.target.closest('.medication-row');
                DOM.medicationContainer.removeChild(row);
                updateHiddenInput();
            }
        });

        DOM.medicationContainer.addEventListener('input', (e) => {
            if (e.target.classList.contains('drug-input')) {
                handleDrugInput(e.target);
            }
            updateHiddenInput();
        });

        DOM.medicationContainer.addEventListener('keydown', (e) => {
            if (e.target.classList.contains('drug-input')) {
                handleKeyboardNavigation(e, e.target);
            }
        });

        document.addEventListener('click', (e) => {
            if (!DOM.medicationContainer.contains(e.target)) {
                const suggestions = DOM.medicationContainer.querySelectorAll('.drug-suggestions');
                suggestions.forEach(s => s.style.display = 'none');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initializeSignalR();
        setupFormSubmission();
        setupEventListeners();
    });
</script>