<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="main-header">
        <div class="container">
            <div class="row main-nav">
                <div class="col-1">
                    <a href="@Url.Action("Index", "Patient")">
                        <img src="~/images/MedicalCarelogo.png" alt="MedicalCare Logo" class="logo">
                    </a>
                </div>
                <div class="col-7">
                    <div class="main-nav-links text-center">
                        <a href="@Url.Action("Index", "Patient")">Giới thiệu</a>
                        <a href="@Url.Action("Specialities", "Patient")">Chuyên khoa</a>
                        <a href="@Url.Action("ListDoctor", "Patient")">Chuyên gia - Bác sĩ</a>
                        <a href="@Url.Action("Chatbot", "Patient")" class="require-auth">Hỗ trợ Chatbot</a>
                    </div>
                </div>
                <div class="col-4">
                    <div class="search-and-actions">
                        <div class="booking-container">
                            <button type="button" id="bookingButton">Đặt lịch khám bệnh</button>
                        </div>
                        <div class="user-actions">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <span class="user-greeting">@(User.Identity.Name?.Split('@')[0])</span>
                                <div class="dropdown">
                                    <a href="#" class="dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown">
                                        <img src="~/images/user-default.png" class="rounded-circle" width="32" height="32" alt="Người dùng">
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Patient/PersonalProfile">Hồ sơ cá nhân</a></li>
                                        <li><a class="dropdown-item" href="/Patient/MySchedule">Lịch khám của tôi</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="/account/logout">
                                                <button type="submit" class="dropdown-item text-danger">Đăng xuất</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <div class="auth-buttons">
                                    <a href="/account/login" class="btn btn-outline-primary btn-login me-2">
                                        <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                                    </a>
                                    <a href="/account/register" class="btn btn-primary btn-register">
                                        <i class="fas fa-user-plus me-1"></i>Đăng ký
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- Chatbot Container -->
    <div class="chatbot-container" id="bookingChatbot">
        <div class="chatbot-header">
            <span>Tư vấn đặt lịch khám</span>
            <span class="chatbot-close" id="closeChatbot">&times;</span>
        </div>
        <div class="chatbot-messages" id="chatbotMessages">
            <!-- Messages will be added here dynamically -->
        </div>
        <div class="chatbot-input">
            <input type="text" id="userInput" placeholder="Nhập triệu chứng của bạn...">
            <button id="sendMessage">Gửi</button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
    const bookingButton = document.getElementById('bookingButton');
    const chatbotContainer = document.getElementById('bookingChatbot');
    const closeChatbot = document.getElementById('closeChatbot');
    const chatbotMessages = document.getElementById('chatbotMessages');
    const userInput = document.getElementById('userInput');
    const sendButton = document.getElementById('sendMessage');
    
    let userSymptoms = [];
    let selectedSymptoms = [];
    let conversationState = 'greeting';
    let sessionId = null;
    
    bookingButton.addEventListener('click', function() {
        @if (User.Identity.IsAuthenticated)
        {
            <text>
            chatbotContainer.style.display = 'flex';
            if (chatbotMessages.children.length === 0) {
                sessionId = generateSessionId();
                addBotMessage("🏥 Xin chào! Tôi là trợ lý ảo hỗ trợ đặt lịch khám. Vui lòng nhập triệu chứng theo cú pháp: 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu'.");
                setTimeout(() => {
                    showSymptomOptions();
                }, 500);
            }
            </text>
        }
        else
        {
            <text>
            showLoginAlert();
            </text>
        }
    });
    
    function generateSessionId() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }
    
    closeChatbot.addEventListener('click', function() {
        chatbotContainer.style.display = 'none';
    });
    
    sendButton.addEventListener('click', sendUserMessage);
    
    userInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            sendUserMessage();
        }
    });
    
    function addBotMessage(message) {
        const messageElement = document.createElement('div');
        messageElement.classList.add('message', 'bot-message');
        messageElement.innerHTML = message;
        chatbotMessages.appendChild(messageElement);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }
    
    function addUserMessage(message) {
        const messageElement = document.createElement('div');
        messageElement.classList.add('message', 'user-message');
        messageElement.textContent = message;
        chatbotMessages.appendChild(messageElement);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }
    
    function isValidSymptomInput(message) {
        const symptomRegex = /^tôi bị\s+(.+)/i;
        return symptomRegex.test(message.trim());
    }
    
    function sendUserMessage() {
        const message = userInput.value.trim();
        if (message === '') return;
        
        if (isValidSymptomInput(message)) {
            addUserMessage(message);
            userInput.value = '';
            showTypingIndicator();
            processUserInput(message);
        } else {
            Swal.fire({
                title: 'Cú pháp không hợp lệ',
                text: "Vui lòng nhập triệu chứng theo cú pháp 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu'. Nếu bạn có câu hỏi khác, vui lòng truy cập /Patient/Chatbot để được hỗ trợ.",
                icon: 'error',
                confirmButtonText: 'Đi đến Chatbot',
                showCancelButton: true,
                cancelButtonText: 'Thử lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Patient/Chatbot';
                }
            });
        }
    }
    
    function showTypingIndicator() {
        const typingElement = document.createElement('div');
        typingElement.classList.add('message', 'bot-message', 'typing-indicator');
        typingElement.innerHTML = `
            <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
        `;
        chatbotMessages.appendChild(typingElement);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }
    
    function removeTypingIndicator() {
        const typingIndicator = document.querySelector('.typing-indicator');
        if (typingIndicator) {
            typingIndicator.remove();
        }
    }
    
    async function processUserInput(message) {
        if (conversationState === 'greeting' || conversationState === 'collecting_symptoms') {
            await callChatbotAPI(message);
            conversationState = 'diagnosis_complete';
        } else if (conversationState === 'diagnosis_complete') {
            if (isValidSymptomInput(message)) {
                await callChatbotAPI(message);
            } else {
                removeTypingIndicator();
                Swal.fire({
                    title: 'Cú pháp không hợp lệ',
                    text: "Vui lòng nhập triệu chứng theo cú pháp 'tôi bị [triệu chứng]'. Nếu bạn có câu hỏi khác, vui lòng truy cập /Patient/Chatbot.",
                    icon: 'error',
                    confirmButtonText: 'Đi đến Chatbot',
                    showCancelButton: true,
                    cancelButtonText: 'Thử lại'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Patient/Chatbot';
                    }
                });
            }
        }
    }
    
    async function callChatbotAPI(userMessage) {
        try {
            const response = await fetch('/Patient/ChatbotMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    'userMessage': userMessage,
                    'sessionId': sessionId || ''
                })
            });
            
            const data = await response.json();
            
            removeTypingIndicator();
            
            if (data.botReply) {
                parseAndDisplayBotReply(data.botReply);
            } else {
                addBotMessage("❌ Xin lỗi, tôi không thể xử lý yêu cầu của bạn lúc này. Vui lòng thử lại sau.");
            }
            
        } catch (error) {
            console.error('Error calling chatbot API:', error);
            removeTypingIndicator();
            addBotMessage("❌ Có lỗi xảy ra khi kết nối với hệ thống. Vui lòng thử lại sau.");
        }
    }
    
    function parseAndDisplayBotReply(reply) {
        // Tách reply thành các phần dựa trên markers đặc biệt
        const sections = splitReplyIntoSections(reply);
        
        let delay = 0;
        
        // Hiển thị các phần general/diagnosis trước
        if (sections.general.length > 0) {
            setTimeout(() => {
                sections.general.forEach(section => {
                    addBotMessage(formatMarkdownToHTML(section));
                });
            }, delay);
            delay += 800;
        }
        
        // Hiển thị khoa chuyên môn điều trị trong 1 message
        if (sections.departments.length > 0) {
            setTimeout(() => {
                displayDepartmentsMessage(sections.departments);
            }, delay);
            delay += 1000;
        }
        
        // Hiển thị bác sĩ được khuyến nghị trong 1 message
        if (sections.doctors.length > 0) {
            setTimeout(() => {
                displayDoctorsMessage(sections.doctors);
            }, delay);
            delay += 1000;
        }
        
        // Hiển thị các phần bổ sung
        if (sections.additional.length > 0) {
            setTimeout(() => {
                sections.additional.forEach(section => {
                    addBotMessage(formatMarkdownToHTML(section));
                });
            }, delay);
        }
    }
    
    function splitReplyIntoSections(reply) {
        const result = {
            general: [],
            departments: [],
            doctors: [],
            additional: []
        };
        
        // Tách theo các marker chính
        const departmentMarkers = ['🏥 KHOA CHUYÊN MÔN ĐIỀU TRỊ:', '🏥 **KHOA CHUYÊN MÔN ĐIỀU TRỊ:**', 'KHOA CHUYÊN MÔN ĐIỀU TRỊ:'];
        const doctorMarkers = ['👨‍⚕️ BÁC SĨ ĐƯỢC KHUYẾN NGHỊ:', '👨‍⚕️ **BÁC SĨ ĐƯỢC KHUYẾN NGHỊ:**', 'BÁC SĨ ĐƯỢC KHUYẾN NGHỊ:'];
        
        let currentSection = 'general';
        let currentContent = '';
        
        const lines = reply.split('\n');
        
        for (let line of lines) {
            const trimmedLine = line.trim();
            
            // Kiểm tra marker khoa
            if (departmentMarkers.some(marker => trimmedLine.includes(marker))) {
                if (currentContent.trim() && currentSection === 'general') {
                    result.general.push(currentContent.trim());
                }
                currentSection = 'departments';
                currentContent = trimmedLine + '\n';
                continue;
            }
            
            // Kiểm tra marker bác sĩ
            if (doctorMarkers.some(marker => trimmedLine.includes(marker))) {
                if (currentContent.trim() && currentSection === 'departments') {
                    result.departments.push(currentContent.trim());
                }
                currentSection = 'doctors';
                currentContent = trimmedLine + '\n';
                continue;
            }
            
            // Kiểm tra marker additional (lưu ý, cảnh báo)
            if (trimmedLine.includes('⚠️') || trimmedLine.includes('💡') || trimmedLine.includes('LƯU Ý')) {
                if (currentContent.trim()) {
                    result[currentSection].push(currentContent.trim());
                }
                currentSection = 'additional';
                currentContent = line + '\n';
                continue;
            }
            
            currentContent += line + '\n';
        }
        
        // Thêm phần cuối cùng
        if (currentContent.trim()) {
            result[currentSection].push(currentContent.trim());
        }
        
        return result;
    }
    
    // Hàm tạo nội dung có thể thu gọn/mở rộng
    function createExpandableContent(text, maxLength = 150, id = null) {
        if (text.length <= maxLength) {
            return text;
        }
        
        const uniqueId = id || 'expandable_' + Math.random().toString(36).substr(2, 9);
        const shortText = text.substring(0, maxLength).trim();
        const remainingText = text.substring(maxLength).trim();
        
        return `
            <div class="expandable-content">
                <span class="short-text" id="short_${uniqueId}">${shortText}...</span>
                <span class="full-text" id="full_${uniqueId}" style="display: none;">${text}</span>
                <br>
                <button class="expand-btn" id="expand_${uniqueId}" onclick="toggleExpand('${uniqueId}')" style="background: none; border: none; color: #007bff; cursor: pointer; font-size: 12px; text-decoration: underline;">
                    Xem thêm
                </button>
            </div>
        `;
    }
    
    // Hàm toggle mở rộng/thu gọn
    window.toggleExpand = function(id) {
        const shortText = document.getElementById(`short_${id}`);
        const fullText = document.getElementById(`full_${id}`);
        const expandBtn = document.getElementById(`expand_${id}`);
        
        if (fullText.style.display === 'none') {
            shortText.style.display = 'none';
            fullText.style.display = 'inline';
            expandBtn.textContent = 'Thu gọn';
        } else {
            shortText.style.display = 'inline';
            fullText.style.display = 'none';
            expandBtn.textContent = 'Xem thêm';
        }
    }
    
    function displayDepartmentsMessage(departmentContents) {
        let departmentHTML = '<div class="departments-section">';
        departmentHTML += '<div class="section-header">🏥 <strong>KHOA CHUYÊN MÔN ĐIỀU TRỊ:</strong></div>';
        departmentHTML += '<div class="departments-content">';
        
        departmentContents.forEach(content => {
            // Tách từng khoa từ content
            const departments = extractDepartments(content);
            
            departments.forEach((dept, index) => {
                const deptId = `dept_${Date.now()}_${index}`;
                departmentHTML += '<div class="department-item">';
                departmentHTML += `<div class="department-name">🔹 <strong>${dept.name}</strong></div>`;
                
                if (dept.specialty) {
                    departmentHTML += `<div class="department-specialty">🩺 Chuyên điều trị: ${createExpandableContent(dept.specialty, 100, `specialty_${deptId}`)}</div>`;
                }
                
                if (dept.description && dept.description.trim()) {
                    departmentHTML += `<div class="department-description">📋 Thông tin về khoa: ${createExpandableContent(dept.description.trim(), 150, `desc_${deptId}`)}</div>`;
                }
                
                departmentHTML += '<div class="department-actions">';
                departmentHTML += `<button class="btn-view-department" onclick="viewDepartmentInfo('${dept.name}')">📋 Xem thông tin khoa</button>`;
                departmentHTML += '</div>';
                departmentHTML += '</div>';
            });
        });
        
        departmentHTML += '</div></div>';
        addBotMessage(departmentHTML);
    }
    
    function displayDoctorsMessage(doctorContents) {
        let doctorHTML = '<div class="doctors-section">';
        doctorHTML += '<div class="section-header">👨‍⚕️ <strong>BÁC SĨ ĐƯỢC KHUYẾN NGHỊ:</strong></div>';
        doctorHTML += '<div class="doctors-content">';
        
        doctorContents.forEach(content => {
            // Tách từng bác sĩ từ content
            const doctors = extractDoctors(content);
            
            doctors.forEach((doctor, index) => {
                const doctorId = `doctor_${Date.now()}_${index}`;
                doctorHTML += '<div class="doctor-item">';
                doctorHTML += `<div class="doctor-name">⭐ <strong>${doctor.name}</strong></div>`;
                
                if (doctor.specialty) {
                    doctorHTML += `<div class="doctor-specialty">🎯 Chuyên môn: ${createExpandableContent(doctor.specialty, 120, `specialty_${doctorId}`)}</div>`;
                }
                
                if (doctor.description && doctor.description.trim()) {
                    doctorHTML += `<div class="doctor-description">📝 Thông tin bác sĩ: ${createExpandableContent(doctor.description.trim(), 180, `desc_${doctorId}`)}</div>`;
                }
                
                doctorHTML += '<div class="doctor-actions">';
                doctorHTML += `<button class="btn-book-doctor" onclick="bookWithDoctor('${doctor.name}')">📞 Đặt lịch ngay</button>`;
                doctorHTML += '</div>';
                doctorHTML += '</div>';
            });
        });
        
        doctorHTML += '</div></div>';
        addBotMessage(doctorHTML);
    }
    
    function extractDepartments(content) {
        const departments = [];
        const lines = content.split('\n');
        let currentDept = null;
        
        for (let line of lines) {
            const trimmedLine = line.trim();
            
            // Tìm tên khoa (bắt đầu với 🔹 hoặc có từ "Khoa")
            if (trimmedLine.includes('🔹') || (trimmedLine.includes('Khoa') && !trimmedLine.includes('Chuyên điều trị'))) {
                if (currentDept) {
                    departments.push(currentDept);
                }
                currentDept = {
                    name: trimmedLine.replace('🔹', '').replace(/\*\*/g, '').trim(),
                    specialty: '',
                    description: ''
                };
            }
            // Tìm chuyên môn điều trị
            else if (currentDept && (trimmedLine.includes('Chuyên điều trị') || trimmedLine.includes('🩺'))) {
                currentDept.specialty = trimmedLine.replace('🩺', '').replace('Chuyên điều trị:', '').trim();
            }
            // Tìm thông tin về bệnh
            else if (currentDept && (trimmedLine.includes('Thông tin về bệnh') || trimmedLine.includes('📋'))) {
                currentDept.description += trimmedLine.replace('📋', '').replace('Thông tin về bệnh:', '').trim() + ' ';
            }
            // Mô tả khác
            else if (currentDept && trimmedLine && !trimmedLine.includes('🏥') && !trimmedLine.includes('KHOA CHUYÊN MÔN')) {
                currentDept.description += trimmedLine + ' ';
            }
        }
        
        if (currentDept) {
            departments.push(currentDept);
        }
        
        return departments;
    }
    
    function extractDoctors(content) {
        const doctors = [];
        const lines = content.split('\n');
        let currentDoctor = null;
        
        for (let line of lines) {
            const trimmedLine = line.trim();
            
            // Tìm tên bác sĩ (có các tiền tố như TS., BS., GS., v.v.)
            if (trimmedLine.match(/^[•\-\*]?\s*(TS\.|BS\.|GS\.|PGS\.|TTND\.|ThS\.|CKII)/)) {
                if (currentDoctor) {
                    doctors.push(currentDoctor);
                }
                currentDoctor = {
                    name: trimmedLine.replace(/^[•\-\*]?\s*/, '').replace(/\*\*/g, '').trim(),
                    specialty: '',
                    description: ''
                };
            }
            // Tìm chuyên môn
            else if (currentDoctor && (trimmedLine.includes('Chuyên môn') || trimmedLine.includes('🎯'))) {
                currentDoctor.specialty = trimmedLine.replace('🎯', '').replace('Chuyên môn:', '').trim();
            }
            // Mô tả khác
            else if (currentDoctor && trimmedLine && !trimmedLine.includes('👨‍⚕️') && !trimmedLine.includes('BÁC SĨ ĐƯỢC KHUYẾN NGHỊ')) {
                currentDoctor.description += trimmedLine + ' ';
            }
        }
        
        if (currentDoctor) {
            doctors.push(currentDoctor);
        }
        
        return doctors;
    }
    
    function formatMarkdownToHTML(text) {
        // Tìm và xử lý phần "Thông tin về bệnh:"
        text = text.replace(/(📋\s*Thông tin về bệnh:\s*)([\s\S]*?)(?=\n\n|\n(?=[🎯📋🏥👨‍⚕️])|$)/g, function(match, prefix, content) {
            const cleanContent = content.trim();
            return prefix + createExpandableContent(cleanContent, 200, `disease_info_${Date.now()}`);
        });
        
        return text
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/\n/g, '<br>')
            .replace(/^[-•]\s(.+)$/gm, '<li>$1</li>')
            .replace(/(<li>.*<\/li>)/gs, '<ul>$1</ul>')
            .replace(/<\/ul>\s*<ul>/g, '');
    }
    
    window.viewDepartmentInfo = function(departmentName) {
        addBotMessage(`
            <div class="action-feedback">
                <div class="feedback-content">
                    <div class="feedback-icon">📋</div>
                    <div class="feedback-text">Đang tải thông tin chi tiết về <strong>${departmentName}</strong>...</div>
                </div>
            </div>
        `);
        
        setTimeout(() => {
            addBotMessage(`
                <div class="info-message">
                    <div class="info-content">
                        ℹ️ Để xem thông tin chi tiết về ${departmentName}, vui lòng liên hệ trực tiếp với bệnh viện.
                    </div>
                </div>
            `);
        }, 1000);
    }
    
    window.bookWithDoctor = function(doctorName) {
        addBotMessage(`
            <div class="booking-feedback">
                <div class="booking-content">
                    <div class="booking-icon">🚀</div>
                    <div class="booking-text">Đang chuyển hướng đến trang đặt lịch với <strong>${doctorName}</strong>...</div>
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        `);
        
        setTimeout(() => {
            window.location.href = `/Patient/BookAppointment?doctor=${encodeURIComponent(doctorName)}`;
        }, 1500);
    }
    
    function showSymptomOptions() {
        const commonSymptoms = [
            "Đau đầu", "Sốt", "Ho", "Khó thở", 
            "Đau bụng", "Mệt mỏi", "Chóng mặt", "Buồn nôn",
            "Đau họng", "Đau lưng", "Đau răng", "Sưng tấy"
        ];
        
        let optionsHTML = "<div class='symptom-selection'>";
        optionsHTML += "<div class='symptom-title'>💊 Bạn có thể chọn một hoặc nhiều triệu chứng từ danh sách dưới đây:</div>";
        optionsHTML += "<div class='symptom-grid'>";
        
        commonSymptoms.forEach((symptom, index) => {
            optionsHTML += `<span class="symptom-option" data-symptom="${symptom}" onclick="toggleSymptom('${symptom}', this)">${symptom}</span>`;
        });
        
        optionsHTML += "</div>";
        optionsHTML += "<div class='selected-symptoms'>";
        optionsHTML += "<div class='selected-title' style='display: none;'>✅ Triệu chứng đã chọn:</div>";
        optionsHTML += "<div class='selected-list'></div>";
        optionsHTML += "</div>";
        optionsHTML += "<div class='symptom-actions'>";
        optionsHTML += "<button class='btn-submit-symptoms' onclick='submitSelectedSymptoms()' style='display: none;'>Gửi triệu chứng đã chọn</button>";
        optionsHTML += "</div>";
        optionsHTML += "<div class='or-text'>Hoặc nhập triệu chứng theo cú pháp 'tôi bị [triệu chứng]' vào ô chat bên dưới</div>";
        optionsHTML += "</div>";
        
        addBotMessage(optionsHTML);
    }
    
    window.toggleSymptom = function(symptom, element) {
        const index = selectedSymptoms.indexOf(symptom);
        
        if (index === -1) {
            selectedSymptoms.push(symptom);
            element.classList.add('symptom-selected');
        } else {
            selectedSymptoms.splice(index, 1);
            element.classList.remove('symptom-selected');
        }
        
        updateSelectedSymptomsDisplay();
    }
    
    function updateSelectedSymptomsDisplay() {
        const selectedTitle = document.querySelector('.selected-title');
        const selectedList = document.querySelector('.selected-list');
        const submitButton = document.querySelector('.btn-submit-symptoms');
        
        if (selectedSymptoms.length > 0) {
            selectedTitle.style.display = 'block';
            submitButton.style.display = 'inline-block';
            
            selectedList.innerHTML = selectedSymptoms.map(symptom => 
                `<span class="selected-symptom-tag">${symptom} <span class="remove-symptom" onclick="removeSelectedSymptom('${symptom}')">×</span></span>`
            ).join('');
        } else {
            selectedTitle.style.display = 'none';
            submitButton.style.display = 'none';
            selectedList.innerHTML = '';
        }
    }
    
    window.removeSelectedSymptom = function(symptom) {
        const index = selectedSymptoms.indexOf(symptom);
        if (index !== -1) {
            selectedSymptoms.splice(index, 1);
            
            const symptomOption = document.querySelector(`[data-symptom="${symptom}"]`);
            if (symptomOption) {
                symptomOption.classList.remove('symptom-selected');
            }
            
            updateSelectedSymptomsDisplay();
        }
    }
    
    window.submitSelectedSymptoms = async function() {
        if (selectedSymptoms.length === 0) {
            return;
        }
        
        const symptomsText = `tôi bị ${selectedSymptoms.join(', ')}`;
        userSymptoms = [...selectedSymptoms];
        
        addUserMessage(symptomsText);
        
        const symptomSelection = document.querySelector('.symptom-selection');
        if (symptomSelection) {
            symptomSelection.style.opacity = '0.5';
            symptomSelection.style.pointerEvents = 'none';
        }
        
        showTypingIndicator();
        await callChatbotAPI(symptomsText);
        conversationState = 'diagnosis_complete';
    }
    
    window.addMoreSymptoms = function() {
        addBotMessage("💊 Vui lòng nhập triệu chứng theo cú pháp: 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu'. Hoặc chọn từ danh sách:");
        setTimeout(() => {
            showSymptomOptions();
        }, 500);
        conversationState = 'collecting_symptoms';
    }
    
    window.restartConsultation = function() {
        userSymptoms = [];
        selectedSymptoms = [];
        conversationState = 'greeting';
        sessionId = generateSessionId();
        
        addBotMessage("🔄 Tôi sẽ bắt đầu tư vấn lại từ đầu. Vui lòng nhập triệu chứng theo cú pháp: 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu':");
        setTimeout(() => {
            showSymptomOptions();
        }, 500);
    }
});

function showLoginAlert() {
    Swal.fire({
        title: 'Yêu cầu đăng nhập',
        text: 'Vui lòng đăng nhập để sử dụng tính năng này',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Đăng nhập',
        cancelButtonText: 'Hủy'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '/Account/Login';
        }
    });
}

@if (!User.Identity.IsAuthenticated)
{
    <text>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.require-auth').forEach(function (el) {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                showLoginAlert();
            });
        });
    });
    </text>
}
</script>
    @RenderSection("Scripts", required: false)
</body>
</html>