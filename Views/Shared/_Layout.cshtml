<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="main-header">
        <div class="container">
            <div class="row main-nav">
                <div class="col-1">
                    <a href="@Url.Action("Index", "Patient")">
                        <img src="~/images/MedicalCarelogo.png" alt="MedicalCare Logo" class="logo">
                    </a>
                </div>
                <div class="col-7">
                    <div class="main-nav-links text-center">
                        <a href="@Url.Action("Index", "Patient")">Giới thiệu</a>
                        <a href="@Url.Action("Specialities", "Patient")">Chuyên khoa</a>
                        <a href="@Url.Action("ListDoctor", "Patient")">Chuyên gia - Bác sĩ</a>
                        <a href="@Url.Action("Chatbot", "Patient")" class="require-auth">Hỗ trợ Chatbot</a>
                    </div>
                </div>
                <div class="col-4">
                    <div class="search-and-actions">
                        <div class="booking-container">
                            <button type="button" id="bookingButton">Đặt lịch khám bệnh</button>
                        </div>
                        <div class="user-actions">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <span class="user-greeting">@(User.Identity.Name?.Split('@')[0])</span>
                                <div class="dropdown">
                                    <a href="#" class="dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown">
                                        <img src="~/images/user-default.png" class="rounded-circle" width="32" height="32" alt="Người dùng">
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Patient/PersonalProfile">Hồ sơ cá nhân</a></li>
                                        <li><a class="dropdown-item" href="/Patient/MySchedule">Lịch khám của tôi</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="/account/logout">
                                                <button type="submit" class="dropdown-item text-danger">Đăng xuất</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <div class="auth-buttons">
                                    <a href="/account/login" class="btn btn-outline-primary btn-login me-2">
                                        <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                                    </a>
                                    <a href="/account/register" class="btn btn-primary btn-register">
                                        <i class="fas fa-user-plus me-1"></i>Đăng ký
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- Chatbot Container -->
    <div class="chatbot-container" id="bookingChatbot">
        <div class="chatbot-header">
            <span>Tư vấn đặt lịch khám</span>
            <span class="chatbot-close" id="closeChatbot">&times;</span>
        </div>
        <div class="chatbot-messages" id="chatbotMessages">
            <!-- Messages will be added here dynamically -->
        </div>
        <div class="chatbot-input">
            <input type="text" id="userInput" placeholder="Nhập triệu chứng của bạn...">
            <button id="sendMessage">Gửi</button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Authentication check function
        function showLoginAlert() {
            Swal.fire({
                title: 'Yêu cầu đăng nhập',
                text: 'Vui lòng đăng nhập để sử dụng tính năng này',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đăng nhập',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Account/Login';
                }
            });
        }

        // Nếu người dùng chưa đăng nhập => gắn sự kiện cho các liên kết cần bảo vệ
        @if (!User.Identity.IsAuthenticated)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('.require-auth').forEach(function (el) {
                    el.addEventListener('click', function (e) {
                        e.preventDefault();
                        showLoginAlert();
                    });
                });
            });
            </text>
        }

        // Chatbot functionality
        document.addEventListener('DOMContentLoaded', function() {
            const bookingButton = document.getElementById('bookingButton');
            const chatbotContainer = document.getElementById('bookingChatbot');
            const closeChatbot = document.getElementById('closeChatbot');
            const chatbotMessages = document.getElementById('chatbotMessages');
            const userInput = document.getElementById('userInput');
            const sendButton = document.getElementById('sendMessage');
            
            let userSymptoms = [];
            let selectedSymptoms = [];
            let conversationState = 'greeting';
            let sessionId = null;
            
            // Show chatbot when booking button is clicked
            bookingButton.addEventListener('click', function() {
                @if (User.Identity.IsAuthenticated)
                {
                    <text>
                    chatbotContainer.style.display = 'flex';
                    if (chatbotMessages.children.length === 0) {
                        sessionId = generateSessionId();
                        addBotMessage("🏥 Xin chào! Tôi là trợ lý ảo hỗ trợ đặt lịch khám. Vui lòng nhập triệu chứng theo cú pháp: 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu'.");
                        setTimeout(() => {
                            showSymptomOptions();
                        }, 500);
                    }
                    </text>
                }
                else
                {
                    <text>
                    showLoginAlert();
                    </text>
                }
            });
            
            // Generate session ID
            function generateSessionId() {
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            }
            
            // Close chatbot
            closeChatbot.addEventListener('click', function() {
                chatbotContainer.style.display = 'none';
            });
            
            // Send message when clicking send button
            sendButton.addEventListener('click', sendUserMessage);
            
            // Send message when pressing Enter
            userInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendUserMessage();
                }
            });
            
            // Function to add a bot message to the chat
            function addBotMessage(message) {
                const messageElement = document.createElement('div');
                messageElement.classList.add('message', 'bot-message');
                messageElement.innerHTML = message;
                chatbotMessages.appendChild(messageElement);
                chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
            }
            
            // Function to add a user message to the chat
            function addUserMessage(message) {
                const messageElement = document.createElement('div');
                messageElement.classList.add('message', 'user-message');
                messageElement.textContent = message;
                chatbotMessages.appendChild(messageElement);
                chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
            }
            
            // Function to validate user input
            function isValidSymptomInput(message) {
                const symptomRegex = /^tôi bị\s+(.+)/i;
                return symptomRegex.test(message.trim());
            }
            
            // Function to send user message
            function sendUserMessage() {
                const message = userInput.value.trim();
                if (message === '') return;
                
                if (isValidSymptomInput(message)) {
                    addUserMessage(message);
                    userInput.value = '';
                    showTypingIndicator();
                    processUserInput(message);
                } else {
                    Swal.fire({
                        title: 'Cú pháp không hợp lệ',
                        text: "Vui lòng nhập triệu chứng theo cú pháp 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu'. Nếu bạn có câu hỏi khác, vui lòng truy cập /Patient/Chatbot để được hỗ trợ.",
                        icon: 'error',
                        confirmButtonText: 'Đi đến Chatbot',
                        showCancelButton: true,
                        cancelButtonText: 'Thử lại'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Patient/Chatbot';
                        }
                    });
                }
            }
            
            // Show typing indicator
            function showTypingIndicator() {
                const typingElement = document.createElement('div');
                typingElement.classList.add('message', 'bot-message', 'typing-indicator');
                typingElement.innerHTML = `
                    <div class="typing-dots">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                `;
                chatbotMessages.appendChild(typingElement);
                chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
            }
            
            // Remove typing indicator
            function removeTypingIndicator() {
                const typingIndicator = document.querySelector('.typing-indicator');
                if (typingIndicator) {
                    typingIndicator.remove();
                }
            }
            
            // Process user input based on conversation state
            async function processUserInput(message) {
                if (conversationState === 'greeting' || conversationState === 'collecting_symptoms') {
                    await callChatbotAPI(message);
                    conversationState = 'diagnosis_complete';
                } else if (conversationState === 'diagnosis_complete') {
                    if (isValidSymptomInput(message)) {
                        await callChatbotAPI(message);
                    } else {
                        removeTypingIndicator();
                        Swal.fire({
                            title: 'Cú pháp không hợp lệ',
                            text: "Vui lòng nhập triệu chứng theo cú pháp 'tôi bị [triệu chứng]'. Nếu bạn có câu hỏi khác, vui lòng truy cập /Patient/Chatbot.",
                            icon: 'error',
                            confirmButtonText: 'Đi đến Chatbot',
                            showCancelButton: true,
                            cancelButtonText: 'Thử lại'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/Patient/Chatbot';
                            }
                        });
                    }
                }
            }
            
            // Call chatbot API
            async function callChatbotAPI(userMessage) {
                try {
                    const response = await fetch('/Patient/ChatbotMessage', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({
                            'userMessage': userMessage,
                            'sessionId': sessionId || ''
                        })
                    });
                    
                    const data = await response.json();
                    
                    removeTypingIndicator();
                    
                    if (data.botReply) {
                        formatAndDisplayBotReply(data.botReply);
                    } else {
                        addBotMessage("❌ Xin lỗi, tôi không thể xử lý yêu cầu của bạn lúc này. Vui lòng thử lại sau.");
                    }
                    
                } catch (error) {
                    console.error('Error calling chatbot API:', error);
                    removeTypingIndicator();
                    addBotMessage("❌ Có lỗi xảy ra khi kết nối với hệ thống. Vui lòng thử lại sau.");
                }
            }
            
            // Format and display bot reply
            function formatAndDisplayBotReply(reply) {
                if (reply.includes('🎯') && reply.includes('DỰ ĐOÁN BỆNH LÝ')) {
                    formatDiagnosisReply(reply);
                } else {
                    addBotMessage(reply);
                }
            }
            
            // Format diagnosis reply
            function formatDiagnosisReply(reply) {
                const sections = reply.split(/(?=🎯|🔄|🏥|👨‍⚕️)/);
                
                sections.forEach((section, index) => {
                    if (section.trim()) {
                        setTimeout(() => {
                            if (section.includes('🎯')) {
                                formatMainDiagnosis(section);
                            } else if (section.includes('🔄')) {
                                formatAlternativeDiagnoses(section);
                            } else if (section.includes('🏥')) {
                                formatDepartmentRecommendations(section);
                            } else if (section.includes('👨‍⚕️')) {
                                formatDoctorRecommendations(section);
                            }
                        }, index * 1000);
                    }
                });
                
                setTimeout(() => {
                    addFollowUpOptions();
                }, sections.length * 1000 + 500);
            }
            
            // Format main diagnosis
            function formatMainDiagnosis(section) {
                const lines = section.split('\n').filter(line => line.trim());
                let formattedHTML = '';
                
                lines.forEach(line => {
                    if (line.includes('🎯')) {
                        formattedHTML += `<div class="diagnosis-header">${line}</div>`;
                    } else if (line.includes('✅')) {
                        formattedHTML += `<div class="diagnosis-symptoms">${line}</div>`;
                    } else if (line.includes('📋')) {
                        formattedHTML += `<div class="diagnosis-info">${line}</div>`;
                    } else if (line.trim()) {
                        formattedHTML += `<div class="diagnosis-detail">${line}</div>`;
                    }
                });
                
                addBotMessage(`<div class="diagnosis-card main-diagnosis">${formattedHTML}</div>`);
            }
            
            // Format alternative diagnoses
            function formatAlternativeDiagnoses(section) {
                const lines = section.split('\n').filter(line => line.trim());
                let formattedHTML = '<div class="alternative-diagnoses">';
                
                lines.forEach(line => {
                    if (line.includes('🔄')) {
                        formattedHTML += `<div class="section-header">${line}</div>`;
                    } else if (line.trim() && line.match(/^\d+\./)) {
                        formattedHTML += `<div class="alternative-item">${line}</div>`;
                    }
                });
                
                formattedHTML += '</div>';
                addBotMessage(formattedHTML);
            }
            
            // Format department recommendations
            function formatDepartmentRecommendations(section) {
                const lines = section.split('\n').filter(line => line.trim());
                let formattedHTML = '<div class="department-recommendations">';
                
                lines.forEach(line => {
                    if (line.includes('🏥')) {
                        formattedHTML += `<div class="section-header">${line}</div>`;
                    } else if (line.includes('🔹')) {
                        formattedHTML += `<div class="department-item">${line}</div>`;
                    } else if (line.includes('📌')) {
                        formattedHTML += `<div class="department-specialty">${line}</div>`;
                    } else if (line.includes('🔗')) {
                        formattedHTML += `<div class="department-link">${line}</div>`;
                    }
                });
                
                formattedHTML += '</div>';
                addBotMessage(formattedHTML);
            }
            
            // Format doctor recommendations
            function formatDoctorRecommendations(section) {
                const lines = section.split('\n').filter(line => line.trim());
                let formattedHTML = '<div class="doctor-recommendations">';
                
                lines.forEach(line => {
                    if (line.includes('👨‍⚕️')) {
                        formattedHTML += `<div class="section-header">${line}</div>`;
                    } else if (line.includes('⭐')) {
                        formattedHTML += `<div class="doctor-title">${line}</div>`;
                    } else if (line.includes('THS') || line.includes('BS')) {
                        const doctorName = line.replace(/^\*\*•\s*/, '').replace(/\*\*/g, '');
                        formattedHTML += `<div class="doctor-name" onclick="selectDoctor('${doctorName}')">${doctorName}</div>`;
                    } else if (line.includes('💼')) {
                        formattedHTML += `<div class="doctor-experience">${line}</div>`;
                    } else if (line.includes('🎯')) {
                        formattedHTML += `<div class="doctor-specialty">${line}</div>`;
                    } else if (line.includes('📞')) {
                        formattedHTML += `<div class="doctor-contact">${line}</div>`;
                    } else if (line.includes('🚀')) {
                        formattedHTML += `<div class="booking-cta"><button class="btn-book-now" onclick="bookAppointment()">Đặt lịch ngay</button></div>`;
                    }
                });
                
                formattedHTML += '</div>';
                addBotMessage(formattedHTML);
            }
            
            // Add follow-up options
            function addFollowUpOptions() {
                const optionsHTML = `
                    <div class="follow-up-options">
                        <div class="option-title">📋 Bạn muốn làm gì tiếp theo?</div>
                        <div class="option-buttons">
                            <button class="option-btn" onclick="bookAppointment()">🚀 Đặt lịch khám</button>
                            <button class="option-btn" onclick="addMoreSymptoms()">➕ Thêm triệu chứng</button>
                            <button class="option-btn" onclick="askMoreInfo()">❓ Hỏi thêm thông tin</button>
                            <button class="option-btn" onclick="restartConsultation()">🔄 Tư vấn lại</button>
                        </div>
                    </div>
                `;
                
                addBotMessage(optionsHTML);
            }
            
            // Show symptom options with multi-selection capability
            function showSymptomOptions() {
                const commonSymptoms = [
                    "Đau đầu", "Sốt", "Ho", "Khó thở", 
                    "Đau bụng", "Mệt mỏi", "Chóng mặt", "Buồn nôn",
                    "Đau họng", "Đau lưng", "Đau răng", "Sưng tấy"
                ];
                
                let optionsHTML = "<div class='symptom-selection'>";
                optionsHTML += "<div class='symptom-title'>💊 Bạn có thể chọn một hoặc nhiều triệu chứng từ danh sách dưới đây:</div>";
                optionsHTML += "<div class='symptom-grid'>";
                
                commonSymptoms.forEach((symptom, index) => {
                    optionsHTML += `<span class="symptom-option" data-symptom="${symptom}" onclick="toggleSymptom('${symptom}', this)">${symptom}</span>`;
                });
                
                optionsHTML += "</div>";
                optionsHTML += "<div class='selected-symptoms'>";
                optionsHTML += "<div class='selected-title' style='display: none;'>✅ Triệu chứng đã chọn:</div>";
                optionsHTML += "<div class='selected-list'></div>";
                optionsHTML += "</div>";
                optionsHTML += "<div class='symptom-actions'>";
                optionsHTML += "<button class='btn-submit-symptoms' onclick='submitSelectedSymptoms()' style='display: none;'>Gửi triệu chứng đã chọn</button>";
                optionsHTML += "</div>";
                optionsHTML += "<div class='or-text'>Hoặc nhập triệu chứng theo cú pháp 'tôi bị [triệu chứng]' vào ô chat bên dưới</div>";
                optionsHTML += "</div>";
                
                addBotMessage(optionsHTML);
            }
            
            // Toggle symptom selection
            window.toggleSymptom = function(symptom, element) {
                const index = selectedSymptoms.indexOf(symptom);
                
                if (index === -1) {
                    selectedSymptoms.push(symptom);
                    element.classList.add('symptom-selected');
                } else {
                    selectedSymptoms.splice(index, 1);
                    element.classList.remove('symptom-selected');
                }
                
                updateSelectedSymptomsDisplay();
            }
            
            // Update display of selected symptoms
            function updateSelectedSymptomsDisplay() {
                const selectedTitle = document.querySelector('.selected-title');
                const selectedList = document.querySelector('.selected-list');
                const submitButton = document.querySelector('.btn-submit-symptoms');
                
                if (selectedSymptoms.length > 0) {
                    selectedTitle.style.display = 'block';
                    submitButton.style.display = 'inline-block';
                    
                    selectedList.innerHTML = selectedSymptoms.map(symptom => 
                        `<span class="selected-symptom-tag">${symptom} <span class="remove-symptom" onclick="removeSelectedSymptom('${symptom}')">×</span></span>`
                    ).join('');
                } else {
                    selectedTitle.style.display = 'none';
                    submitButton.style.display = 'none';
                    selectedList.innerHTML = '';
                }
            }
            
            // Remove a selected symptom
            window.removeSelectedSymptom = function(symptom) {
                const index = selectedSymptoms.indexOf(symptom);
                if (index !== -1) {
                    selectedSymptoms.splice(index, 1);
                    
                    const symptomOption = document.querySelector(`[data-symptom="${symptom}"]`);
                    if (symptomOption) {
                        symptomOption.classList.remove('symptom-selected');
                    }
                    
                    updateSelectedSymptomsDisplay();
                }
            }
            
            // Submit selected symptoms
            window.submitSelectedSymptoms = async function() {
                if (selectedSymptoms.length === 0) {
                    return;
                }
                
                const symptomsText = `tôi bị ${selectedSymptoms.join(', ')}`;
                userSymptoms = [...selectedSymptoms];
                
                addUserMessage(symptomsText);
                
                const symptomSelection = document.querySelector('.symptom-selection');
                if (symptomSelection) {
                    symptomSelection.style.opacity = '0.5';
                    symptomSelection.style.pointerEvents = 'none';
                }
                
                showTypingIndicator();
                await callChatbotAPI(symptomsText);
                conversationState = 'diagnosis_complete';
            }
            
            // Legacy function for single symptom selection
            window.selectSymptom = async function(symptom) {
                selectedSymptoms = [symptom];
                await submitSelectedSymptoms();
            }
            
            // Book appointment
            window.bookAppointment = function() {
                addBotMessage(`
                    <div class="booking-process">
                        <div class="booking-title">🏥 Đang chuyển hướng đến trang đặt lịch...</div>
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                `);
                
                setTimeout(() => {
                    window.location.href = '/Patient/BookAppointment';
                }, 1500);
            }
            
            // Add more symptoms
            window.addMoreSymptoms = function() {
                addBotMessage("💊 Vui lòng nhập triệu chứng theo cú pháp: 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu'. Hoặc chọn từ danh sách:");
                setTimeout(() => {
                    showSymptomOptions();
                }, 500);
                conversationState = 'collecting_symptoms';
            }
            
            // Ask for more information
            window.askMoreInfo = function() {
                addBotMessage("❓ Bạn có câu hỏi khác? Vui lòng truy cập /Patient/Chatbot để được hỗ trợ thêm.");
                setTimeout(() => {
                    window.location.href = '/Patient/Chatbot';
                }, 1000);
            }
            
            // Restart consultation
            window.restartConsultation = function() {
                userSymptoms = [];
                selectedSymptoms = [];
                conversationState = 'greeting';
                sessionId = generateSessionId();
                
                addBotMessage("🔄 Tôi sẽ bắt đầu tư vấn lại từ đầu. Vui lòng nhập triệu chứng theo cú pháp: 'tôi bị [triệu chứng]', ví dụ: 'tôi bị đau đầu':");
                setTimeout(() => {
                    showSymptomOptions();
                }, 500);
            }
            
            // Select doctor
            window.selectDoctor = function(doctorName) {
                addUserMessage(`Tôi muốn đặt lịch với ${doctorName}`);
                addBotMessage(`✅ Bạn đã chọn đặt lịch với ${doctorName}. Tôi sẽ chuyển bạn đến trang đặt lịch để hoàn tất thủ tục.`);
                
                setTimeout(() => {
                    bookAppointment();
                }, 1000);
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>