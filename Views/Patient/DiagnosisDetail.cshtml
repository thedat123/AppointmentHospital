@model AppointmentHospital.Models.Appointment
@{
    var diagnosisHistory = ViewData["DiagnosisHistory"] as DiagnosisHistory;
}

<div class="container-fluid py-5 bg-light">
    <!-- Header with improved visual hierarchy -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            <i class="bi bi-heart-pulse me-2"></i>
            Patient Diagnosis Record
        </h1>
        <div class="col-lg-6 mx-auto">
            <p class="lead text-muted">Medical Examination Details</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Patient & Symptoms Section -->
            <div class="row g-4 mb-5">
                <!-- Enhanced Patient Information Card -->
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                        <div class="card-header bg-primary bg-gradient text-white p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-circle fs-4 me-2"></i>
                                <h5 class="mb-0">Patient Information</h5>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0">
                                    <small class="text-muted d-block mb-1">Full Name</small>
                                    <span class="fw-semibold">@(@Model.Acquaintance?.Name ?? @Model.Patient.FullName)</span>
                                </div>
                                <div class="list-group-item px-0">
                                    <small class="text-muted d-block mb-1">Date of Birth</small>
                                    <span class="fw-semibold">
                                        @(@Model.Acquaintance?.DateOfBirth.ToString("MMMM d, yyyy") ?? @Model.Patient.DateOfBirth?.ToString("MMMM d, yyyy"))
                                    </span>
                                </div>
                                <div class="list-group-item px-0">
                                    <small class="text-muted d-block mb-1">Appointment Time</small>
                                    <span class="fw-semibold">@Model.AppointmentTime.ToString("dddd, MMMM d, yyyy - h:mm tt")</span>
                                </div>
                                <div class="list-group-item px-0 border-bottom-0">
                                    <small class="text-muted d-block mb-1">Address</small>
                                    <span class="fw-semibold">@(@Model.Acquaintance?.Address ?? @Model.Patient.Address)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                        <div class="card-header bg-info bg-gradient text-white p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-clipboard2-pulse fs-4 me-2"></i>
                                <h5 class="mb-0">Reported Symptoms</h5>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-light mb-0">
                                <p class="lead mb-0">@Model.Symptoms</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enhanced Diagnosis Section -->
            <div class="card border-0 shadow-sm hover-shadow transition">
                <div class="card-header bg-success bg-gradient text-white p-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-medical fs-4 me-2"></i>
                        <h5 class="mb-0">Medical Diagnosis</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Diagnosis Details -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-clipboard-data me-2"></i>
                            Diagnosis Details
                        </label>
                        <textarea 
                            name="DiagnosisDetails" 
                            class="form-control bg-light"
                            rows="4" 
                            placeholder="Enter detailed diagnosis..."
                            disabled="disabled">@diagnosisHistory.Diagnosis</textarea>
                    </div>

                    <!-- Prescribed Medications -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-capsule me-2"></i>
                            Prescribed Medications
                        </label>
                        <div class="bg-light p-4 rounded-3">
                            @if (diagnosisHistory.Prescription != null && diagnosisHistory.Prescription.Any())
                            {
                                <div class="list-group">
                                    @foreach (var item in diagnosisHistory.Prescription)
                                    {
                                        var parts = item.Split('-');
                                        var medicineName = parts[0];
                                        var quantity = parts.Length > 1 ? parts[1] : "N/A";

                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="bi bi-pill text-primary me-2"></i>
                                                <span class="fw-medium">@medicineName</span>
                                            </div>
                                            <span class="badge bg-primary rounded-pill">@quantity</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-emoji-neutral fs-4 d-block mb-2"></i>
                                    No medications prescribed
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Doctor's Notes -->
                    <div>
                        <label class="form-label fw-semibold">
                            <i class="bi bi-journal-text me-2"></i>
                            Doctor's Notes
                        </label>
                        <textarea 
                            name="DoctorNotes" 
                            class="form-control bg-light" 
                            rows="3" 
                            placeholder="Additional notes or recommendations..."
                            disabled="disabled">@diagnosisHistory.DoctorNote</textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow {
        transition: all 0.3s ease;
    }
    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}