@model Pagination<Doctor>
@using AppointmentHospital.Models
@using AppointmentHospital.Helpers
@using AppointmentHospital.EnumStatus
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IUrlHelper Url

<div class="doctors-page">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 hero-content">
                    <h1 class="hero-title">Đội ngũ Bác sĩ chuyên môn</h1>
                    <p class="hero-subtitle">Khám phá đội ngũ bác sĩ giàu kinh nghiệm và tận tâm của chúng tôi</p>
                    <div class="search-container">
                        <div class="search-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" id="doctorSearch" class="form-control" placeholder="Tìm kiếm theo tên bác sĩ hoặc chuyên khoa..." value="@ViewBag.SearchTerm">
                        </div>
                    </div>
                </div>
                <div class="col-md-5 d-none d-md-block hero-image-container">
                    <img src="https://media.vneconomy.vn/w800/images/upload/2024/12/02/du-lieu-y-te-1.jpg" alt="Medical Team" class="hero-image">
                </div>
            </div>
        </div>
    </div>

    <div class="main-content">
        <div class="container">
            <!-- Filter Section -->
            <div class="filter-section">
                <div class="section-header">
                    <h2 class="section-title">Danh sách Bác sĩ</h2>
                    <div class="controls-wrapper">
                        <div class="view-options">
                            <button class="btn btn-view active" data-view="grid" title="Xem dạng lưới">
                                <i class="bi bi-grid"></i>
                            </button>
                            <button class="btn btn-view" data-view="list" title="Xem dạng danh sách">
                                <i class="bi bi-list"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doctors Grid -->
            <div class="doctors-wrapper">
                <div class="doctors-grid" id="doctorsContainer">
                    @foreach (var doctor in Model)
                    {
                        <div class="doctor-card" data-specialty="@doctor.Specialities.SpecialityName.ToLower()">
                            <div class="doctor-image">
                                <img src="@(string.IsNullOrEmpty(doctor.ImagePath) 
                                    ? Url.Content("~/images/user-default.png") 
                                    : doctor.ImagePath)" 
                                    alt="@doctor.FullName"
                                    loading="lazy">
                                <div class="doctor-specialty">
                                    @doctor.Specialities.SpecialityName
                                </div>
                            </div>
                            <div class="doctor-info">
                                <h3 class="doctor-name">@doctor.FullName</h3>
                                @{
                                    double averageRating = (doctor.Feedbacks != null && doctor.Feedbacks.Count > 0)
                                        ? doctor.Feedbacks.Average(f => f.Rating)
                                        : 0;
                                    double percentage = (averageRating / 5.0) * 100;
                                }
                                <div class="star-rating">
                                    <div class="star-rating-top" style="width: @percentage%"></div>
                                    <div class="star-rating-bottom"></div>
                                    <span class="rating-text">(@averageRating.ToString("0.0"))</span>
                                </div>
                                <div class="doctor-meta">
                                    @if (!string.IsNullOrEmpty(doctor.Introduction))
                                    {
                                        <div class="doctor-introduction">
                                            <i class="bi bi-person-circle"></i>
                                            <span class="introduction-text">@doctor.Introduction</span>
                                        </div>
                                    }
                                </div>
                                <div class="doctor-actions">
                                    <a href="@Url.Action("DetailDoctor", "Patient", new { id = doctor.DoctorId })" 
                                       class="btn btn-primary btn-appointment require-auth">
                                        <i class="bi bi-calendar-plus"></i>
                                        Đặt lịch khám
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Loading State -->
                <div class="state-message loading-state d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Đang tải danh sách bác sĩ...</p>
                </div>

                <!-- Empty State -->
                <div class="state-message empty-state @(Model.Any() ? "d-none" : "")">
                    <i class="bi bi-search"></i>
                    <h3>Không tìm thấy bác sĩ</h3>
                    <p>Vui lòng thử lại với tiêu chí tìm kiếm khác</p>
                    <button class="btn btn-primary btn-reset-search">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Xóa tìm kiếm
                    </button>
                </div>
            </div>

            @{
                int totalPages = Model.TotalPage;
                int currentPage = Model.CurrentPage;
                int maxDisplayedPages = 8;
                int startPage = Math.Max(1, currentPage - 3);
                int endPage = Math.Min(totalPages, currentPage + 3);

                if (totalPages > maxDisplayedPages)
                {
                    if (currentPage <= 4)
                    {
                        startPage = 1;
                        endPage = maxDisplayedPages;
                    }
                    else if (currentPage >= totalPages - 3)
                    {
                        startPage = totalPages - maxDisplayedPages + 1;
                        endPage = totalPages;
                    }
                }
                else
                {
                    startPage = 1;
                    endPage = totalPages;
                }

                object CreateRouteValues(int page)
                {
                    var routeValues = new RouteValueDictionary 
                    { 
                        { "page", page }
                    };
                    
                    if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                    {
                        routeValues.Add("searchTerm", ViewBag.SearchTerm);
                    }
                    
                    if (!string.IsNullOrEmpty(ViewBag.SelectedSpec))
                    {
                        routeValues.Add("selectSpec", ViewBag.SelectedSpec);
                    }
                    
                    return routeValues;
                }
            }

            <div class="d-flex justify-content-center align-items-center p-4">
                <nav aria-label="Page navigation" class="mx-auto">
                    <ul class="pagination pagination-rounded mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ListDoctor", "Patient", CreateRouteValues(Model.CurrentPage - 1))" aria-label="Trang trước">
                                    <span aria-hidden="true">«</span>
                                </a>
                            </li>
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ListDoctor", "Patient", CreateRouteValues(1))">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ListDoctor", "Patient", CreateRouteValues(i))">@i</a>
                            </li>
                        }

                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ListDoctor", "Patient", CreateRouteValues(totalPages))">@totalPages</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ListDoctor", "Patient", CreateRouteValues(Model.CurrentPage + 1))" aria-label="Trang sau">
                                    <span aria-hidden="true">»</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Existing styles remain unchanged */
        :root {
            --primary-50: #eff6ff;
            --primary-100: #dbeafe;
            --primary-200: #bfdbfe;
            --primary-300: #93c5fd;
            --primary-400: #60a5fa;
            --primary-500: #3b82f6;
            --primary-600: #2563eb;
            --primary-700: #1d4ed8;
            --primary-800: #1e40af;
            --primary-900: #1e3a8a;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-300: #d1d5db;
            --gray-400: #9ca3af;
            --gray-500: #6b7280;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
