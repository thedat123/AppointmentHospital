        }

        .doctors-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .doctors-list .doctor-card {
            display: flex;
            flex-direction: row;
        }

        .doctors-list .doctor-image {
            width: 120px;
            min-width: 120px;
            height: auto;
            min-height: 100%;
        }

        .doctors-list .doctor-info {
            flex: 1;
        }

        .doctor-card {
            background: white;
            border-radius: var(--radius-xl);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .doctor-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .doctor-image {
            position: relative;
            height: 220px;
        }

        .doctor-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .doctor-specialty {
            position: absolute;
            bottom: 1rem;
            left: 1rem;
            background: rgba(37, 99, 235, 0.9);
            color: white;
            padding: 0.375rem 0.75rem;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 500;
            box-shadow: var(--shadow-md);
        }

        .doctor-info {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .doctor-name {
            font-size: 1.25rem;
            font-weight: 600;
            margin-top: 0;
            margin-bottom: 0.75rem;
            color: var(--gray-900);
        }

        .doctor-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .doctor-introduction {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            color: var(--gray-700);
            font-size: 0.875rem;
            background-color: var(--gray-50);
            padding: 0.75rem;
            border-radius: var(--radius-lg);
            border-left: 3px solid var(--primary-500);
