            border-color: var(--primary-700);
        }

        .state-message {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: var(--radius-xl crazy);
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .empty-state i {
            font-size: 2.5rem;
            color: var(--gray-400);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            color: var(--gray-800);
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: var(--gray-600);
            margin-bottom: 1.5rem;
        }

        .btn-reset-search {
            margin-top: 0.5rem;
        }

        @@media (max-width: 576px) {
            .doctor-introduction {
                padding: 0.5rem;
                font-size: 0.8125rem;
            }
            
            .introduction-text {
                -webkit-line-clamp: 1;
            }
        }

        @@media (max-width: 992px) {
            .hero-title {
                font-size: 2rem;
            }
            
            .hero-subtitle {
                font-size: 1rem;
                max-width: 100%;
            }
            
            .section-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .controls-wrapper {
                width: 100%;
                flex-direction: column;
                align-items: flex-start;
            }
            
            .view-options {
                margin-left: auto;
            }
        }

        @@media (max-width: 768px) {
            .hero-section {
                padding: 3rem 0 2rem;
                text-align: center;
                border-radius: 0 0 var(--radius-xl) var(--radius-xl);
            }
            
            .hero-content {
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            
            .search-container {
                width: 100%;
            }
            
            .doctor-actions {
                grid-template-columns: 1fr;
            }
            
            .doctors-list .doctor-card {
                flex-direction: column;
            }
            
            .doctors-list .doctor-image {
                width: 100%;
                height: 200px;
            }
        }

        @@media (max-width: 576px) {
            .doctors-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const doctorSearch = document.getElementById('doctorSearch');
            const filterPills = document.querySelectorAll('.filter-pill');
            const viewButtons = document.querySelectorAll('.btn-view');
            const doctorsContainer = document.getElementById('doctorsContainer');
            const resetSearchBtn = document.querySelector('.btn-reset-search');
            const loadingState = document.querySelector('.loading-state');
            const emptyState = document.querySelector('.empty-state');

            // Debounce function for search input
            function debounce(func, wait) {
                let timeout;
                return function(...args) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func(...args), wait);
                };
            }

            // Update URL with search and filter parameters
            function updateUrl(searchTerm, specialty) {
                const params = new URLSearchParams();
                params.set('page', '1'); // Reset to page 1 on new search/filter
                if (searchTerm) params.set('searchTerm', searchTerm);
                if (specialty && specialty !== 'all') params.set('selectSpec', specialty);
                window.location.href = `/Patient/ListDoctor?${params.toString()}`;
            }

            // Handle search input
            doctorSearch.addEventListener('input', debounce(function() {
                const searchTerm = doctorSearch.value.trim();
                const activeSpecialty = document.querySelector('.filter-pill.active')?.dataset.specialty || 'all';
                updateUrl(searchTerm, activeSpecialty);
            }, 500));

            // Handle filter pill click
            filterPills.forEach(pill => {
                pill.addEventListener('click', function() {
                    filterPills.forEach(p => p.classList.remove('active'));
                    pill.classList.add('active');
                    const specialty = pill.dataset.specialty;
                    const searchTerm = doctorSearch.value.trim();
                    updateUrl(searchTerm, specialty);
                });
            });

            // Handle reset search
            if (resetSearchBtn) {
                resetSearchBtn.addEventListener('click', function() {
                    doctorSearch.value = '';
                    updateUrl('', 'all');
                });
            }

            // View toggle
            viewButtons.forEach(button => {
                button.addEventListener('click', () => {
                    viewButtons.forEach(b => b.classList.remove('active'));
                    button.classList.add('active');
                    const viewType = button.dataset.view;
                    doctorsContainer.className = viewType === 'grid' ? 'doctors-grid' : 'doctors-list';
                });
            });

            // Lazy loading images
            if ('IntersectionObserver' in window) {
                const imageObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            if (img.dataset.src) {
                                img.src = img.dataset.src;
                                img.removeAttribute('data-src');
                            }
                            imageObserver.unobserve(img);
                        }
                    });
                }, { rootMargin: '50px 0px', threshold: 0.1 });

                document.querySelectorAll('.doctor-image img').forEach(img => imageObserver.observe(img));
            }

            // Animate doctor cards
            if ('IntersectionObserver' in window) {
                const animateObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('animate-in');
                            animateObserver.unobserve(entry.target);
                        }
                    });
                }, { rootMargin: '0px', threshold: 0.1 });

                document.querySelectorAll('.doctor-card').forEach(card => animateObserver.observe(card));
            }

            // Animation styles
            const styleSheet = document.createElement('style');
            styleSheet.textContent = `
                @@keyframes fadeInUp {
                    from { opacity: 0; transform: translateY(20px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                .doctor-card { opacity: 0; }
                .doctor-card.animate-in { animation: fadeInUp 0.5s ease forwards; }
            `;
            document.head.appendChild(styleSheet);

            // Authentication check
            @if (!User.Identity.IsAuthenticated)
            {
                <text>
                    document.querySelectorAll('.require-auth').forEach(el => {
                        el.addEventListener('click', e => {
                            e.preventDefault();
                            Swal.fire({
                                title: 'Yêu cầu đăng nhập',
                                text: 'Vui lòng đăng nhập để sử dụng tính năng này',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: 'Đăng nhập',
                                cancelButtonText: 'Hủy'
                            }).then(result => {
                                if (result.isConfirmed) {
                                    window.location.href = '/Account/Login';
                                }
                            });
                        });
                    });
                </text>
            }
        });
    </script>
}