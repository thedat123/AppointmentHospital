        }

        .rating-text {
            margin-left: 8px;
            color: #333;
            font-size: 0.95rem;
        }

        .doctor-actions {
            display: grid;
            gap: 0.75rem;
            margin-top: auto;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            font-weight: 500;
            font-size: 0.875rem;
            padding: 0.625rem 1rem;
            border-radius: var(--radius-lg);
