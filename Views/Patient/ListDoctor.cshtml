        .star-rating {
            position: relative;
            display: flex;
            font-size: 1.2rem;
            line-height: 1;
            margin-bottom: 10px;
        }

        .star-rating-top {
            color: #ffc107;
            position: absolute;
            z-index: 1;
            overflow: hidden;
            white-space: nowrap;
        }

        .star-rating-bottom {
            color: #e4e5e9;
            z-index: 0;
        }

        .star-rating-top::before,
        .star-rating-bottom::before {
