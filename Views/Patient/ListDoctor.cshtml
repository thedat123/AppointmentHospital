            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
            --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
            --radius-sm: 0.125rem;
            --radius: 0.25rem;
            --radius-md: 0.375rem;
            --radius-lg: 0.5rem;
            --radius-xl: 0.75rem;
            --radius-2xl: 1rem;
            --radius-3xl: 1.5rem;
            --radius-full: 9999px;
        }

        .hero-section {
            background: linear-gradient(135deg, var(--primary-600), var(--primary-800));
            padding: 4rem 0;
            color: white;
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-lg);
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 0l30 30-30 30L0 30z' fill='%23ffffff' fill-opacity='0.05'/%3E%3C/svg%3E");
            opacity: 0.1;
        }

        .hero-content {
            padding: 0 1rem;
        }

        .hero-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            line-height: 1.2;
            letter-spacing: -0.025em;
        }

        .hero-subtitle {
            font-size: 1.125rem;
            opacity: 0.9;
            margin-bottom: 2rem;
            max-width: 80%;
        }

        .search-container {
            position: relative;
            max-width: 500px;
        }

        .search-box {
            position: relative;
            background: white;
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }

        .search-icon {
            position: absolute;
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            color: var(--gray-500);
            z-index: 10;
        }

        .search-box input {
            border: none;
            padding: 1rem 1.5rem 1rem 3rem;
            font-size: 1rem;
            width: 100%;
            border-radius: var(--radius-xl);
            transition: all 0.2s ease;
        }

        .search-box input:focus {
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
            outline: none;
        }

        .hero-image-container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-image {
            max-width: 100%;
            height: auto;
            filter: drop-shadow(0 20px 13px rgba(0, 0, 0, 0.08));
        }

        .main-content {
            position: relative;
            padding-bottom: 4rem;
        }

        .filter-section {
            margin-bottom: 2rem;
        }

        .section-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
            color: var(--gray-900);
        }

        .controls-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        .filter-wrapper {
            flex: 1;
        }

        .filter-pills {
            display: flex;
            gap: 0.75rem;
            overflow-x: auto;
            padding: 0.25rem 0;
            max-width: 100%;
            scrollbar-width: thin;
            scrollbar-color: var(--gray-300) transparent;
        }

        .filter-pills::-webkit-scrollbar {
            height: 4px;
        }

        .filter-pills::-webkit-scrollbar-track {
            background: transparent;
        }

        .filter-pills::-webkit-scrollbar-thumb {
            background-color: var(--gray-300);
            border-radius: var(--radius-full);
        }

        .filter-pill {
            padding: 0.5rem 1rem;
            border-radius: var(--radius-full);
            background: white;
            color: var(--gray-700);
            border: 1px solid var(--gray-200);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            white-space: nowrap;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
        }

        .filter-pill:hover {
            border-color: var(--primary-300);
            color: var(--primary-700);
            background: var(--primary-50);
        }

        .filter-pill.active {
            background: var(--primary-600);
            color: white;
            border-color: var(--primary-600);
        }

        .view-options {
            display: flex;
            gap: 0.5rem;
        }

        .btn-view {
            width: 2.5rem;
            height: 2.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-md);
            background: white;
            color: var(--gray-600);
            border: 1px solid var(--gray-200);
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-view:hover {
            border-color: var(--primary-300);
            color: var(--primary-600);
        }

        .btn-view.active {
            background: var(--primary-600);
            color: white;
            border-color: var(--primary-600);
        }

        .doctors-wrapper {
            position: relative;
            min-height: 300px;
        }

        .doctors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
