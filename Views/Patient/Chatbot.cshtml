<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const chatContainer = document.getElementById('chat-container');
        const userInput = document.getElementById('user-input');
        const sendButton = document.getElementById('send-button');
        const typingIndicator = document.querySelector('.typing-indicator');
        const resetButton = document.getElementById('reset-chat');
        const textarea = document.getElementById('user-input');
        const form = textarea.closest('form');
        
        // Thêm sự kiện cho nút gửi - FIX: Sử dụng form.submit() thay vì sendMessage
        sendButton.addEventListener('click', function(e) {
            e.preventDefault(); // Ngăn hành vi mặc định của button
            if (userInput.value.trim()) {
                form.submit(); // Gửi form đến controller
            }
        });
        
        // Thêm sự kiện khi nhấn Enter
        userInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault(); // chặn xuống dòng
                if (userInput.value.trim()) {
                    form.submit(); // gửi form
                }
            }
        });

        // Thêm sự kiện cho các nút trả lời nhanh
        document.querySelectorAll('.quick-reply').forEach(button => {
            button.addEventListener('click', function() {
                userInput.value = this.textContent;
                form.submit(); // Sử dụng form.submit() thay vì sendMessage
            });
        });
        
        // Nút reset chat
        resetButton?.addEventListener('click', function() {
            // Xóa tất cả tin nhắn trừ tin nhắn chào hỏi đầu tiên
            while (chatContainer.children.length > 1) {
                chatContainer.removeChild(chatContainer.lastChild);
            }
            
            // Thêm lại tin nhắn chào hỏi ban đầu nếu bị xóa
            if (chatContainer.children.length === 0) {
                const welcomeMessage = createBotMessage("Xin chào! Tôi là trợ lý ảo của Bệnh viện Sức khỏe Cộng đồng. Tôi có thể giúp gì cho bạn hôm nay?");
                chatContainer.appendChild(welcomeMessage);
                
                // Thêm các nút trả lời nhanh
                addQuickReplies(["Giờ làm việc", "Dịch vụ", "Đặt lịch khám", "Liên hệ bác sĩ"]);
            }
        });
        
        // Thêm sự kiện cho các suggestion cards trong welcome screen
        document.querySelectorAll('.suggestion-card').forEach(card => {
            card.addEventListener('click', function() {
                const query = this.getAttribute('data-query');
                if (query) {
                    userInput.value = query;
                    form.submit(); // Sử dụng form.submit() thay vì sendMessage
                }
            });
        });
        
        function createBotMessage(text) {
            const botMessageContainer = document.createElement('div');
            botMessageContainer.className = 'message-with-icon';
            
            const botIcon = document.createElement('div');
            botIcon.className = 'bot-icon';
            botIcon.innerHTML = '<i class="fas fa-robot"></i>';
            
            const messageContent = document.createElement('div');
            messageContent.className = 'message-content';
            
            const message = document.createElement('div');
            message.className = 'message bot-message';
            message.textContent = text;
            
            messageContent.appendChild(message);
            
            botMessageContainer.appendChild(botIcon);
            botMessageContainer.appendChild(messageContent);
            
            return botMessageContainer;
        }
        
        function addQuickReplies(replies) {
            const quickRepliesContainer = document.createElement('div');
            quickRepliesContainer.className = 'quick-replies';
            
            replies.forEach(reply => {
                const button = document.createElement('div');
                button.className = 'quick-reply';
                button.textContent = reply;
                button.addEventListener('click', function() {
                    userInput.value = this.textContent;
                    form.submit(); // Sử dụng form.submit() thay vì sendMessage
                });
                quickRepliesContainer.appendChild(button);
            });
            
            // Thêm vào message-content của tin nhắn bot cuối cùng
            const lastBotMessage = chatContainer.querySelector('.message-with-icon:last-child .message-content');
            if (lastBotMessage) {
                lastBotMessage.appendChild(quickRepliesContainer);
            }
        }
    });
</script>