@using AppointmentHospital.DTOs.Patient;
@model PatientRequest
@{
    var response = ViewBag.PatientInfo as PatientResponse;
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="profile-card">
                <div class="profile-header">
                    <div class="avatar-wrapper">
                        <div class="avatar">
                            <img src="~/images/user-default.png" alt="Hồ sơ" class="rounded-circle" />
                        </div>
                        <h3 class="profile-name">@response.FullName</h3>
                        <p class="profile-email">@response.EmailAddress</p>
                    </div>
                </div>

                <div class="profile-body">
                    <form id="submitForm" asp-action="PersonalProfile" method="post">
                        <input name="patientId" value="@response.PatientId" type="hidden" />

                        <div class="section-title">Thông tin cá nhân</div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" asp-for="@Model.FullName"
                                        value="@response.FullName" id="fullName" placeholder="Họ và tên" />
                                    <label for="fullName">Họ và tên</label>
                                    <span asp-validation-for="@Model.FullName"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" asp-for="@Model.EmailAddress"
                                        value="@response.EmailAddress" id="email" placeholder="Email" />
                                    <label for="email">Địa chỉ Email</label>
                                    <span asp-validation-for="@Model.EmailAddress"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" asp-for="@Model.UserName"
                                        value="@response.UserName" id="username" placeholder="Tên đăng nhập" />
                                    <label for="username">Tên đăng nhập</label>
                                    <span asp-validation-for="@Model.UserName"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="date" class="form-control" asp-for="@Model.DateOfBirth"
                                        value="@(response.DateOfBirth?.ToString("yyyy-MM-dd"))" id="dob" placeholder="Ngày sinh" readonly />
                                    <label for="dob">Ngày sinh</label>
                                    <span asp-validation-for="@Model.DateOfBirth"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" class="form-control" asp-for="@Model.Address"
                                        value="@response.Address" id="address" placeholder="Địa chỉ" />
                                    <label for="address">Địa chỉ</label>
                                </div>
                            </div>
                        </div>

                        <div class="section-title">Thông tin người thân</div>
                        <div class="table-responsive">
                            <table class="table table-hover custom-table">
                                <thead>
                                    <tr>
                                        <th>Họ và tên</th>
                                        <th>Ngày sinh</th>
                                        <th>Giới tính</th>
                                        <th>Số CMND/CCCD</th>
                                        <th>Địa chỉ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contact in response.Acquaintance)
                                    {
                                        <tr>
                                            <td>@contact.Name</td>
                                            <td>@contact.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                            <td>@contact.Gender</td>
                                            <td>@contact.IdentificationNumber</td>
                                            <td>@contact.Address</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="text-end mt-4">
                            <button id="buttonSubmit" type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link href="~/css/personal-profile.css" rel="stylesheet" />
}
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var buttonSubmit = document.getElementById('buttonSubmit');
            var submitForm = document.getElementById('submitForm');
            buttonSubmit.addEventListener('click', function (e) {
                buttonSubmit.disabled= true;
                Swal.fire({
                    title: 'Update information',
                    text: 'Are you sure to update information?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Accept',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        submitForm.submit();
                    }
                });
            })
        })
    </script>
}
