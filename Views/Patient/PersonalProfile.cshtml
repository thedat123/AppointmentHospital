@using AppointmentHospital.DTOs.Patient;
@model PatientRequest
@{
    var response = ViewBag.PatientInfo as PatientResponse;
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm" style="background-color: #f0f8ff;">
                <div class="card-header bg-primary bg-opacity-25">
                    <h3 class="card-title mb-0 text-primary">Personal Profile</h3>
                </div>
                <div class="card-body">
                    <form asp-action="PersonalProfile" method="post">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <input name="patientId" value="@response.PatientId" type="hidden" />
                                <div class="form-group mb-3">
                                    <label class="form-label text-primary fw-bold">Full Name</label>
                                    <input type="text" class="form-control" asp-for="@Model.FullName" value="@response.FullName"  />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label text-primary fw-bold">Email Address</label>
                                    <input type="email" class="form-control" asp-for="@Model.EmailAddress" value="@response.EmailAddress" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label text-primary fw-bold">Username</label>
                                    <input type="text" class="form-control" asp-for="@Model.UserName" value="@response.UserName"  />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label text-primary fw-bold">Date of Birth</label>
                                    <input type="date" class="form-control" asp-for="@Model.DateOfBirth" value="@(response.DateOfBirth?.ToString("yyyy-MM-dd"))" readonly />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label text-primary fw-bold">Address</label>
                                    <input type="text" class="form-control" asp-for="@Model.Address" value="@response.Address"  />
                                </div>
                            </div>
                        </div>

                        <h4 class="text-primary mb-3">Acquaintance</h4>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="bg-primary bg-opacity-10">
                                    <tr>
                                        <th>Name</th>
                                        <th>Date of Birth</th>
                                        <th>Gender</th>
                                        <th>ID Number</th>
                                        <th>Address</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contact in response.Acquaintance)
                                    {
                                        <tr>
                                            <td>@contact.Name</td>
                                            <td>@contact.DateOfBirth.ToString("MM/dd/yyyy")</td>
                                            <td>@contact.Gender</td>
                                            <td>@contact.IdentificationNumber</td>
                                            <td>@contact.Address</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="text-end mt-4">
                            <button type="button" id="editProfile"
                                    class="btn btn-outline-primary me-2 px-4">
                                <i class="fas fa-edit me-2"></i>Edit Profile
                            </button>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>    
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    <link href="~/css/personal-profile.css" rel="stylesheet" />
}
