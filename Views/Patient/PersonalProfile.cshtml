@using AppointmentHospital.DTOs.Patient;
@model PatientRequest
@{
    var response = ViewBag.PatientInfo as PatientResponse;
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="profile-card">
                <div class="profile-header">
                    <div class="avatar-wrapper">
                        <div class="avatar">
                            <img src="~/images/user-default.png" alt="Profile" class="rounded-circle" />
                        </div>
                        <h3 class="profile-name">@response.FullName</h3>
                        <p class="profile-email">@response.EmailAddress</p>
                    </div>
                </div>

                <div class="profile-body">
                    <form id="submitForm" asp-action="PersonalProfile" method="post">
                        <input name="patientId" value="@response.PatientId" type="hidden" />
                        
                        <div class="section-title">Personal Information</div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" asp-for="@Model.FullName"
                                        value="@response.FullName" id="fullName" placeholder="Full Name" />
                                    <label for="fullName">Full Name</label>
                                    <span asp-validation-for="@Model.FullName"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" asp-for="@Model.EmailAddress"
                                        value="@response.EmailAddress" id="email" placeholder="Email" />
                                    <label for="email">Email Address</label>
                                    <span asp-validation-for="@Model.EmailAddress"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" asp-for="@Model.UserName"
                                        value="@response.UserName" id="username" placeholder="Username" />
                                    <label for="username">Username</label>
                                    <span asp-validation-for="@Model.UserName"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="date" class="form-control" asp-for="@Model.DateOfBirth"
                                        value="@(response.DateOfBirth?.ToString("yyyy-MM-dd"))" id="dob" placeholder="Date of Birth" readonly />
                                    <label for="dob">Date of Birth</label>
                                    <span asp-validation-for="@Model.DateOfBirth"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" class="form-control" asp-for="@Model.Address"
                                        value="@response.Address" id="address" placeholder="Address" />
                                    <label for="address">Address</label>
                                </div>
                            </div>
                        </div>

                        <div class="section-title">Acquaintance Information</div>
                        <div class="table-responsive">
                            <table class="table table-hover custom-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Date of Birth</th>
                                        <th>Gender</th>
                                        <th>ID Number</th>
                                        <th>Address</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contact in response.Acquaintance)
                                    {
                                        <tr>
                                            <td>@contact.Name</td>
                                            <td>@contact.DateOfBirth.ToString("MM/dd/yyyy")</td>
                                            <td>@contact.Gender</td>
                                            <td>@contact.IdentificationNumber</td>
                                            <td>@contact.Address</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="text-end mt-4">
                            <button id="buttonSubmit" type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/personal-profile.css" rel="stylesheet" />
}
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var buttonSubmit = document.getElementById('buttonSubmit');
            var submitForm = document.getElementById('submitForm');
            buttonSubmit.addEventListener('click', function (e) {
                buttonSubmit.disabled= true;
                Swal.fire({
                    title: 'Update information',
                    text: 'Are you sure to update information?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Accept',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        submitForm.submit();
                    }
                });
            })
        })
    </script>
}
