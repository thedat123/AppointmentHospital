@model Pagination<AppointmentHospital.Models.DiagnosisHistory>
@using AppointmentHospital.Models
@using AppointmentHospital.Helpers
@using Newtonsoft.Json

@section Styles {
    <link href="~/css/my-schedule.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Existing styles remain unchanged */
        :root {
            --primary: #3182ce;
            --success: #38a169;
            --background: #f8fafc;
            --text-primary: #2d3748;
            --text-secondary: #64748b;
            --border: #e2e8f0;
        }

        * {
            font-family: 'Poppins', sans-serif;
            box-sizing: border-box;
        }

        .dashboard-container {
            padding: 1.5rem;
            background: var(--background);
            min-height: 100vh;
        }

        .section-header {
            background: white;
            padding: 1.25rem;
            border-radius: 12px 12px 0 0;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .table-container {
            background: white;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .table thead th {
            background: #f1f5f9;
            padding: 0.75rem 1rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            border-bottom: 1px solid var(--border);
        }

        .table tbody td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border);
            font-size: 0.925rem;
            color: var(--text-primary);
            vertical-align: middle;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background: #f9fafb;
        }

        .badge {
            padding: 0.375rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.8125rem;
            font-weight: 500;
        }

        .bg-success {
            background: #e6fffa;
        }

        .btn-action {
            width: 36px;
            height: 36px;
            border-radius: 6px;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-view {
            background: #e1f5fe;
            color: var(--primary);
        }

        .btn-view:hover {
            background: #bee3f8;
            transform: translateY(-1px);
        }

        .btn-print {
            background: #f0fff4;
            color: var(--success);
        }

        .btn-print:hover {
            background: #c6f6d5;
            transform: translateY(-1px);
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1.5rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .empty-state i {
            font-size: 2.5rem;
            color: #cbd5e0;
            margin-bottom: 0.75rem;
        }

        .pagination-rounded .page-link {
            border-radius: 9999px;
            margin: 0 0.25rem;
            padding: 0.5rem 0.75rem;
            color: var(--primary);
            border: none;
            background: transparent;
            transition: all 0.2s ease;
        }

        .pagination-rounded .page-item.active .page-link {
            background: var(--primary);
            color: white;
        }

        .pagination-rounded .page-link:hover {
            background: #e1f5fe;
        }

        @@media (max-width: 767.98px) {
            .dashboard-container {
                padding: 1rem;
            }

            .table-container {
                overflow-x: auto;
            }

            .table {
                min-width: 768px;
            }
        }

        /* Print-specific styles */
        @@media print {
            body {
                background: white;
                color: black;
                font-family: 'Times New Roman', Times, serif;
                font-size: 12pt;
            }

            .dashboard-container, .main-content, .table-container {
                margin: 0;
                padding: 0;
                width: 100%;
                box-shadow: none;
            }

            /* Hide non-essential elements */
            .section-header, .btn-action, .pagination, .empty-state {
                display: none !important;
            }

            /* Show only the print container */
            #printContent {
                display: block !important;
            }

            .print-table {
                width: 100%;
                border-collapse: collapse;
            }

            .print-table th, .print-table td {
                border: 1px solid #000;
                padding: 8px;
                text-align: left;
            }

            .print-table th {
                background-color: #f0f0f0;
                font-weight: bold;
            }

            .print-header, .print-footer {
                text-align: center;
                margin: 10px 0;
            }

            .print-header h2, .print-footer {
                font-size: 14pt;
                margin: 0;
            }
        }
    </style>
}

<div class="dashboard-container">
    <div class="main-content">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-file-medical-alt" aria-hidden="true"></i> 
                <span>Hồ sơ bệnh án</span>
            </h2>
        </div>

        <div class="table-container">
            @if (Model?.Any() == true)
            {
                <table class="table" role="grid">
                    <thead>
                        <tr>
                            <th scope="col"><i class="fas fa-user" aria-hidden="true"></i> Bệnh nhân</th>
                            <th scope="col"><i class="fas fa-user-md" aria-hidden="true"></i> Bác sĩ</th>
                            <th scope="col"><i class="fas fa-clock" aria-hidden="true"></i> Thời gian</th>
                            <th scope="col"><i class="fas fa-notes-medical" aria-hidden="true"></i> Triệu chứng</th>
                            <th scope="col"><i class="fas fa-clipboard-list" aria-hidden="true"></i> Chẩn đoán</th>
                            <th scope="col"><i class="fas fa-info-circle" aria-hidden="true"></i> Trạng thái</th>
                            <th scope="col"><i class="fas fa-cog" aria-hidden="true"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var diagnosis in Model
                            .Where(d => d.Appointment?.Status == AppointmentHospital.EnumStatus.AppointmentStatus.Completed)
                            .OrderByDescending(d => d.Appointment?.AppointmentTime)
                            .Where(d => d?.Appointment != null && d.Doctor != null && d.Patient != null))
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle p-2">
                                            <i class="fas fa-user" aria-hidden="true"></i>
                                        </div>
                                        <span class="fw-medium">@(diagnosis.Appointment.Acquaintance?.Name ?? diagnosis.Patient.FullName)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle p-2">
                                            <i class="fas fa-user-md" aria-hidden="true"></i>
                                        </div>
                                        <span class="fw-medium">BS. @diagnosis.Doctor.FullName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-medium">@diagnosis.Appointment.AppointmentTime.ToString("dd/MM/yyyy")</span>
                                        <small class="text-muted">@diagnosis.Appointment.AppointmentTime.ToString("HH:mm")</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 150px;" title="@diagnosis.Appointment.Symptoms">
                                        @diagnosis.Appointment.Symptoms
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 150px;" title="@diagnosis.Diagnosis">
                                        @diagnosis.Diagnosis
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle" aria-hidden="true"></i> Đã hoàn thành
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons d-flex gap-2">
                                        <a class="btn-action btn-view" 
                                           asp-controller="Patient" 
                                           asp-action="DiagnosisDetail" 
                                           asp-route-id="@diagnosis.AppointmentId">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @{
                                            var diagnosisData = new
                                            {
                                                patient = new
                                                {
                                                    fullName = diagnosis.Patient?.FullName,
                                                    dateOfBirth = diagnosis.Patient?.DateOfBirth?.ToString("dd/MM/yyyy"),
                                                    patientId = diagnosis.Patient?.PatientId,
                                                    address = diagnosis.Patient?.Address
                                                },
                                                acquaintance = diagnosis.Appointment?.Acquaintance != null ? new
                                                {
                                                    name = diagnosis.Appointment.Acquaintance.Name,
                                                    address = diagnosis.Appointment.Acquaintance.Address
                                                } : null,
                                                appointment = new
                                                {
                                                    appointmentTime = diagnosis.Appointment?.AppointmentTime.ToString("dd/MM/yyyy HH:mm"),
                                                    symptoms = diagnosis.Appointment?.Symptoms
                                                },
                                                diagnosis = diagnosis.Diagnosis,
                                                doctorNote = diagnosis.DoctorNote,
                                                doctor = new
                                                {
                                                    fullName = diagnosis.Doctor?.FullName
                                                },
                                                prescription = diagnosis.Prescription?.Select(p => p.Trim()).ToList() ?? new List<string>()
                                            };
                                            var jsonData = JsonConvert.SerializeObject(diagnosisData);
                                        }

                                        <button class="btn-action btn-print" 
                                                onclick='printDiagnosis(@Html.Raw(jsonData))' 
                                                title="In hồ sơ bệnh án"
                                                aria-label="In hồ sơ bệnh án">
                                            <i class="fas fa-print" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.TotalPage > 1)
                {
                    <nav aria-label="Phân trang hồ sơ bệnh án" class="d-flex justify-content-center p-3">
                        <ul class="pagination pagination-rounded mb-0">
                            @{
                                const int maxDisplayedPages = 5;
                                int currentPage = Model.CurrentPage;
                                int totalPages = Model.TotalPage;
                                int startPage = Math.Max(1, currentPage - maxDisplayedPages / 2);
                                int endPage = Math.Min(totalPages, startPage + maxDisplayedPages - 1);

                                if (endPage - startPage + 1 < maxDisplayedPages)
                                {
                                    startPage = Math.Max(1, endPage - maxDisplayedPages + 1);
                                }
                            }

                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" 
                                       href="@Url.Page("/Patient/PersonalDisease", new { page = currentPage - 1 })" 
                                       aria-label="Trang trước">
                                        <span aria-hidden="true">«</span>
                                    </a>
                                </li>
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Page("/Patient/PersonalDisease", new { page = 1 })">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Page("/Patient/PersonalDisease", new { page = i })">@i</a>
                                </li>
                            }

                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Page("/Patient/PersonalDisease", new { page = totalPages })">@totalPages</a>
                                </li>
                            }

                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" 
                                       href="@Url.Page("/Patient/PersonalDisease", new { page = currentPage + 1 })" 
                                       aria-label="Trang sau">
                                        <span aria-hidden="true">»</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-file-medical" aria-hidden="true"></i>
                    <h4>Chưa có hồ sơ bệnh án</h4>
                    <p>Bạn chưa có bệnh án nào đã hoàn thành. Vui lòng đặt lịch hẹn để bắt đầu.</p>
                </div>
            }
        </div>
    </div>

    <!-- Hidden Print Container -->
    <div id="printContent" style="display: none;">
        <div class="print-header">
            <h2>Bệnh Viện Đa khoa MedicalCare</h2>
            <p>Địa chỉ: 123 Trưng Nữ Vương, Đà Nẵng</p>
            <p>Điện thoại: (028) 1234-5678</p>
            <h3>HỒ SƠ CHẨN ĐOÁN BỆNH NHÂN</h3>
            <p>Ngày in: @(DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>
        </div>
        <table class="print-table">
            <tbody id="printTableBody"></tbody>
        </table>
        <div class="print-footer">
            <p>__________________________</p>
            <p>Bác Sĩ Phụ Trách: <span id="printDoctorName"></span></p>
            <p>__________________________</p>
            <p>Người Xác Nhận</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printDiagnosis(data) {
            try {
                if (!data?.patient) {
                    throw new Error('Dữ liệu bệnh án không hợp lệ.');
                }

                // Dữ liệu từ tham số
                const hospitalName = "Bệnh Viện Đa khoa MedicalCare";
                const patientName = data.acquaintance?.name ?? data.patient?.fullName ?? 'Không rõ';
                const dateOfBirth = data.patient?.dateOfBirth ?? 'Không rõ';
                const patientId = data.patient?.patientId ?? 'Không rõ';
                const appointmentTime = data.appointment?.appointmentTime ?? 'Không rõ';
                const address = data.acquaintance?.address ?? data.patient?.address ?? 'Không rõ';
                const symptoms = data.appointment?.symptoms ?? 'Không rõ';
                const diagnosis = data.diagnosis ?? 'Không rõ';
                const doctorNote = data.doctorNote ?? 'Không có ghi chú';
                const doctorName = data.doctor?.fullName ?? 'Không rõ';
                const prescription = (data.prescription || []).map(p => ({
                    medicine: p.split('-')[0]?.trim() ?? 'Không rõ',
                    quantity: p.split('-').length > 1 ? p.split('-')[1].trim() : 'Không rõ'
                }));

                // Debug: Log data to console
                console.log('Data being processed:', {
                    patientName, dateOfBirth, patientId, appointmentTime, address,
                    symptoms, diagnosis, doctorNote, doctorName, prescription
                });

                // Populate the print container
                const printTableBody = document.getElementById('printTableBody');
                printTableBody.innerHTML = `
                    <tr><td><strong>Họ Và Tên</strong></td><td>${patientName}</td></tr>
                    <tr><td><strong>Ngày Sinh</strong></td><td>${dateOfBirth}</td></tr>
                    <tr><td><strong>Mã Bệnh Nhân</strong></td><td>${patientId}</td></tr>
                    <tr><td><strong>Thời Gian Khám</strong></td><td>${appointmentTime}</td></tr>
                    <tr><td><strong>Địa Chỉ</strong></td><td>${address}</td></tr>
                    <tr><td><strong>Triệu Chứng</strong></td><td>${symptoms}</td></tr>
                    <tr><td><strong>Chẩn Đoán</strong></td><td>${diagnosis}</td></tr>
                    <tr><td><strong>Thuốc Kê Đơn</strong></td><td>${
                        prescription.length > 0
                            ? prescription.map(p => `${p.medicine} - ${p.quantity}`).join(', ')
                            : 'Không có'
                    }</td></tr>
                    <tr><td><strong>Ghi Chú Bác Sĩ</strong></td><td>${doctorNote}</td></tr>
                    <tr><td><strong>Bác Sĩ Phụ Trách</strong></td><td>${doctorName}</td></tr>
                    <tr><td><strong>Khuyến Nghị Tái Khám</strong></td><td>Đặt lịch sau 2 tuần</td></tr>
                `;

                // Set doctor name in footer
                document.getElementById('printDoctorName').textContent = doctorName;

                // Store original content
                const originalContent = document.body.innerHTML;

                // Replace body with print content
                document.body.innerHTML = document.getElementById('printContent').outerHTML;

                // Trigger print
                window.print();

                // Restore original content
                document.body.innerHTML = originalContent;

                // Reload to restore event listeners
                window.location.reload();
            } catch (error) {
                console.error('Lỗi khi in hồ sơ:', error);
                alert(`Không thể in hồ sơ: ${error.message}`);
            }
        }
    </script>
}