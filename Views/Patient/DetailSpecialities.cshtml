@model AppointmentHospital.Models.Specialities
@{
    ViewBag.Title = Model.SpecialityName;
    
    // Define available tabs with display names and icons
    var tabData = new[] {
        new { Field = "Introduction", DisplayName = "Thông Tin Giới Thiệu", Icon = "fa-info-circle", Content = Model.Introduction },
        new { Field = "Service", DisplayName = "Dịch vụ", Icon = "fa-handshake", Content = Model.Service },
        new { Field = "Equipment", DisplayName = "Kỹ thuật - Công nghệ", Icon = "fa-microscope", Content = Model.Equipment },
        new { Field = "Expertise", DisplayName = "Chuyên môn chính", Icon = "fa-user-md", Content = Model.Expertise },
        new { Field = "Aminities", DisplayName = "Tiện ích", Icon = "fa-star", Content = Model.Aminities },
        new { Field = "Archivement", DisplayName = "Thành tựu", Icon = "fa-trophy", Content = Model.Archivement },
        new { Field = "Mission", DisplayName = "Sứ mệnh", Icon = "fa-flag", Content = Model.Mission },
        new { Field = "Treatment", DisplayName = "Điều trị", Icon = "fa-procedures", Content = Model.Treatment },
        new { Field = "Doctors", DisplayName = "Danh sách bác sĩ", Icon = "fa-user-md", Content = (Model.Doctor != null && Model.Doctor.Any()) ? "HasDoctor" : null }
    };

    // Filter tabs that have content
    var availableTabs = tabData.Where(t => !string.IsNullOrWhiteSpace(t.Content)).ToList();
}

<div class="speciality-container">
    <!-- Header with animation -->
    <div class="speciality-header">
        <div class="container">
            <h1 class="speciality-title animated fadeInDown">@Model.SpecialityName</h1>
            <p class="speciality-subtitle animated fadeInUp">Khám và điều trị theo tiêu chuẩn quốc tế</p>
        </div>
    </div>

    <div class="container main-content">
        @if (availableTabs.Any())
        {
            <!-- Enhanced Tab Navigation -->
            <div class="tab-navigation animated fadeIn">
                <ul class="nav nav-pills" id="specialityTabs" role="tablist">
                    @for (int i = 0; i < availableTabs.Count; i++)
                    {
                        var tab = availableTabs[i];
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(i == 0 ? "active" : "")" 
                                    id="@(tab.Field)-tab" 
                                    data-bs-toggle="pill" 
                                    data-bs-target="#@(tab.Field)" 
                                    type="button" 
                                    role="tab" 
                                    aria-selected="@(i == 0 ? "true" : "false")">
                                <span class="tab-icon"><i class="fas @tab.Icon"></i></span>
                                <span class="tab-text">@tab.DisplayName</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
            
            <!-- Tab Content with improved rendering -->
            <div class="tab-content" id="specialityTabContent">
                @for (int i = 0; i < availableTabs.Count; i++)
                {
                    var tab = availableTabs[i];
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" 
                        id="@(tab.Field)" 
                        role="tabpanel" 
                        aria-labelledby="@(tab.Field)-tab">

                        <div class="content-card">
                            <div class="card-header">
                                <i class="fas @tab.Icon icon-header"></i>
                                <h2 class="card-title">@tab.DisplayName</h2>
                            </div>

                            <div class="card-body">
                                @if (tab.Field == "Doctors")
                                {
                                    <div class="row">
                                        <div class="doctors-grid" id="doctorsContainer">
                                            @foreach (var doctor in Model.Doctor)
                                            {
                                                <div class="doctor-card" data-specialty="@doctor.Specialities.SpecialityName.ToLower()">
                                                    <div class="doctor-image">
                                                        <img src="@Url.Content(string.IsNullOrEmpty(doctor.ImagePath) 
                                                            ? "~/images/user-default.png" 
                                                            : $"~/images/{doctor.ImagePath}")" 
                                                            alt="@doctor.FullName"
                                                            loading="lazy">
                                                        <div class="doctor-specialty">
                                                            @doctor.Specialities.SpecialityName
                                                        </div>
                                                    </div>
                                                    <div class="doctor-info">
                                                        <h3 class="doctor-name">@doctor.FullName</h3>
                                                        <div class="doctor-meta">
                                                            @if (!string.IsNullOrEmpty(doctor.Introduction))
                                                            {
                                                                <div class="doctor-introduction">
                                                                    <i class="bi bi-person-circle"></i>
                                                                    <span class="introduction-text">@doctor.Introduction</span>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="doctor-actions">
                                                            <a href="@Url.Action("DetailDoctor", "Patient", new { id = doctor.DoctorId })" 
                                                            class="btn btn-primary btn-appointment require-auth">
                                                                <i class="bi bi-calendar-plus"></i>
                                                                Đặt lịch khám
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    var content = FormatContent(tab.Content);
                                    @Html.Raw(content)
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i> Không có thông tin chi tiết về chuyên khoa này.
            </div>
        }
    </div>
</div>

<!-- Call-to-Action with gradient animation -->
<div class="appointment-cta">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="cta-text">
                    <h3><i class="fas fa-calendar-check me-2"></i>Đặt lịch khám với bác sĩ chuyên khoa</h3>
                    <p>Đội ngũ y bác sĩ giàu kinh nghiệm, trang thiết bị hiện đại</p>
                </div>
            </div>
            <div class="col-lg-4 text-end">
                <a href="/Appointment/Create" class="btn btn-appointment">
                    <span>Đặt lịch ngay</span>
                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Improved Floating Buttons -->
<div class="floating-buttons">
    <a href="tel:19001234" class="call-button" title="Gọi ngay để được tư vấn">
        <i class="fas fa-phone"></i>
        <span class="button-tooltip">Gọi ngay</span>
    </a>
    <button id="backToTop" class="back-to-top" title="Lên đầu trang">
        <i class="fas fa-chevron-up"></i>
    </button>
</div>

@functions {
    public string FormatContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;
            
        // Parse and format content with improved styling
        var lines = content.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        var result = new System.Text.StringBuilder();
        var inList = false;
        var listIndex = 0;
        
        foreach (var line in lines)
        {
            var trimmedLine = line.Trim();
            
            // Check if the line is a bullet point
            if (trimmedLine.StartsWith("-"))
            {
                if (!inList)
                {
                    result.Append("<ul class=\"medical-list\">");
                    inList = true;
                    listIndex = 0;
                }
                
                // Extract the text after the bullet point
                var itemText = trimmedLine.Substring(1).Trim();
                result.AppendFormat("<li class=\"list-item\" data-index=\"{0}\">{1}</li>", listIndex++, itemText);
            }
            else
            {
                // Close the list if we were in one
                if (inList)
                {
                    result.Append("</ul>");
                    inList = false;
                }
                
                // Handle headings (if line has a colon and less than 70 chars, treat as heading)
                if (trimmedLine.Contains(":") && trimmedLine.Length < 70 && !trimmedLine.Contains("<") && !trimmedLine.Contains(">"))
                {
                    var parts = trimmedLine.Split(new[] { ':' }, 2);
                    result.AppendFormat("<div class=\"content-heading\"><strong>{0}:</strong>{1}</div>", 
                        parts[0], 
                        parts.Length > 1 ? parts[1] : "");
                }
                else
                {
                    result.AppendFormat("<p>{0}</p>", trimmedLine);
                }
            }
        }
        
        // Close any open list
        if (inList)
        {
            result.Append("</ul>");
        }
        
        return result.ToString();
    }
}

<style>
    /* Import Google fonts with display=swap for better loading performance */
@@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Montserrat:wght@500;600;700&display=swap');

:root {
    /* Updated color palette with softer, more accessible colors */
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-light: #60a5fa;
    --secondary: #0ea5e9;
    --light-bg: #f8fafc;
    --text-color: #334155;
    --muted-text: #64748b;
    --border-color: #e2e8f0;
    --call-color: #10b981;
    --header-gradient: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    --transition: all 0.3s ease;

    /* Base colors - adjusted for increased accessibility */
    --primary-50: #eff6ff;
    --primary-100: #dbeafe;
    --primary-200: #bfdbfe;
    --primary-300: #93c5fd;
    --primary-400: #60a5fa;
    --primary-500: #3b82f6;
    --primary-600: #2563eb;
    --primary-700: #1d4ed8;
    --primary-800: #1e40af;
    --primary-900: #1e3a8a;
        
    /* Supporting colors */
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    
    /* Neutrals */
    --gray-50: #f9fafb;
    --gray-100: #f3f4f6;
    --gray-200: #e5e7eb;
    --gray-300: #d1d5db;
    --gray-400: #9ca3af;
    --gray-500: #6b7280;
    --gray-600: #4b5563;
    --gray-700: #374151;
    --gray-800: #1f2937;
    --gray-900: #111827;
    
    /* Shadows - refined for better depth perception */
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
    --shadow: 0 2px 4px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.08);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.08), 0 2px 4px -2px rgba(0,0,0,0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -4px rgba(0,0,0,0.05);
    --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.04);
    
    /* Border radius */
    --radius-sm: 0.25rem;  /* 4px */
    --radius: 0.375rem;    /* 6px */
    --radius-md: 0.5rem;   /* 8px */
    --radius-lg: 0.75rem;  /* 12px */
    --radius-xl: 1rem;     /* 16px */
    --radius-2xl: 1.25rem; /* 20px */
    --radius-3xl: 1.5rem;  /* 24px */
    --radius-full: 9999px; /* Fully rounded */
}

/* Improved smooth scrolling for better UX */
html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px; /* Accounts for fixed headers if present */
}

/* Refined animations with reduced motion preference support */
@@media (prefers-reduced-motion: no-preference) {
    .animated {
        animation-duration: 0.6s;
        animation-fill-mode: both;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @@keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .fadeIn { animation-name: fadeIn; }
    .fadeInDown { animation-name: fadeInDown; }
    .fadeInUp { animation-name: fadeInUp; animation-delay: 0.1s; }
}

/* Removed animation for those who prefer reduced motion */
@@media (prefers-reduced-motion: reduce) {
    .animated {
        animation: none !important;
        transition: none !important;
    }
}

/* Enhanced Speciality Header */
.speciality-header {
    background: var(--header-gradient);
    padding: 50px 0;
    color: white;
    text-align: center;
    margin-bottom: 30px;
    border-radius: 0 0 30px 30px;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
}

/* Simplified pseudo-elements for better performance */
.speciality-header::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.15) 0%, transparent 40%);
}

.speciality-title {
