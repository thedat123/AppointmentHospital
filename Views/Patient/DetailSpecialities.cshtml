@section Scripts {
    <script>
        function showLoginAlert() {
            Swal.fire({
                title: 'Yêu cầu đăng nhập',
                text: 'Vui lòng đăng nhập để sử dụng tính năng này',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đăng nhập',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Account/Login';
                }
            });
        }

        // Nếu người dùng chưa đăng nhập => gắn sự kiện cho các liên kết cần bảo vệ
        @if (!User.Identity.IsAuthenticated)
        {
            <text>
                document.addEventListener('DOMContentLoaded', function () {
                    document.querySelectorAll('.require-auth').forEach(function (el) {
                        el.addEventListener('click', function (e) {
                            e.preventDefault();
                            showLoginAlert();
                        });
                    });
                });
            </text>
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Back to top button
            const backToTop = document.getElementById('backToTop');
            
            window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                    backToTop.style.display = 'flex';
                    backToTop.classList.add('animated');
                    backToTop.classList.add('fadeIn');
                } else {
                    backToTop.style.display = 'none';
                    backToTop.classList.remove('animated');
                    backToTop.classList.remove('fadeIn');
                }
            });
            
            backToTop.addEventListener('click', function() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
            
            // Animation for list items
            const animateListItems = () => {
                document.querySelectorAll('.list-item').forEach(function(item, index) {
                    setTimeout(function() {
                        item.style.opacity = '0';
                        item.style.transform = 'translateX(-20px)';
                        
                        setTimeout(function() {
                            item.style.transition = 'all 0.5s ease';
                            item.style.opacity = '1';
                            item.style.transform = 'translateX(0)';
                        }, 50);
                    }, index * 150);
                });
            };
            
            // Initial animation
            setTimeout(animateListItems, 300);
            
            // Re-trigger animations when switching tabs
            document.querySelectorAll('[data-bs-toggle="pill"]').forEach(function(tabEl) {
                tabEl.addEventListener('shown.bs.tab', function (event) {
                    setTimeout(animateListItems, 100);
                });
            });
        });
    </script>
}