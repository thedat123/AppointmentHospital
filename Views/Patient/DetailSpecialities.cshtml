    margin-right: 5px;
}

/* Enhanced List Styling */
.medical-list {
    list-style: none;
    padding-left: 0;
    margin: 22px 0;
}

.list-item {
    position: relative;
    padding: 16px 20px 16px 45px;
    margin-bottom: 14px;
    background-color: var(--gray-50);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    font-size: 1.2rem;
}

.list-item::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 22px;
    width: 8px;
    height: 8px;
    background-color: var(--primary);
    border-radius: 50%;
}

/* Subtle indicator icon */
.list-item::after {
    content: '\f105'; /* Font Awesome arrow icon */
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary);
    opacity: 0;
