@using FinalProject.Entity
@{
    ViewData["Title"] = "Medical Departments";
}
@model List<Specialities> 

<div class="departments-page">
    <!-- Hero Section -->
    <div class="hero-section bg-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold mb-4 animate-up">Chuyên Khoa Y Tế</h1>
                    <p class="lead mb-4 animate-up">Khám phá các chuyên khoa y tế chất lượng cao với đội ngũ bác sĩ giàu kinh nghiệm</p>
                </div>
                <div class="col-lg-6">
                    <div class="search-container animate-up">
                        <div class="input-group">
                            <input type="text" 
                                   id="department-search" 
                                   class="form-control form-control-lg shadow-none" 
                                   placeholder="Tìm kiếm chuyên khoa..."
                                   aria-label="Search departments">
                            <button class="btn btn-secondary px-4" type="button">
                                Tìm kiếm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container py-5">
        <!-- Filter Section -->
        <div class="filter-section mb-5 animate-up">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-filter-circle me-2"></i>
                        Lọc theo danh mục
                    </h5>
                    <div class="filter-buttons">
                        <button class="btn btn-filter active" data-filter="all">
                            <i class="bi bi-grid-fill me-2"></i>
                            Tất cả
                            <span class="badge bg-white text-primary ms-2"></span>
                        </button>
                        <button class="btn btn-filter" data-filter="trung-tam">
                            <i class="bi bi-building me-2"></i>
                            Trung tâm
                            <span class="badge bg-white text-primary ms-2"></span>
                        </button>
                        <button class="btn btn-filter" data-filter="khoa">
                            <i class="bi bi-clipboard2-pulse me-2"></i>
                            Khoa
                            <span class="badge bg-white text-primary ms-2"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Departments Grid -->
        <div class="row g-4" id="departments-container">
            @foreach (var department in Model)
            {
                <div class="col-12 col-md-6 col-lg-3 department-item animate-up" 
                    data-category="@(department.SpecialityName.ToLower().Contains("trung tâm") ? "trung-tam" : 
                                    department.SpecialityName.ToLower().Contains("khoa") ? "khoa" : "other")" 
                    data-name="@department.SpecialityName.ToLower()">
                    <div class="department-card card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="icon-wrapper mx-auto mb-4">
                                <img src="@department.SpecialityImage" alt="@department.SpecialityName" class="img-fluid" />
                            </div>
                            <h3 class="card-title h5 mb-3">@department.SpecialityName</h3>

                            <a href="" class="btn btn-outline-primary btn-hover-fill">
                                <i class="bi bi-arrow-right-circle me-2"></i>
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- No Results Message -->
        <div id="no-results" class="text-center py-5 d-none animate-up">
            <div class="empty-state">
                <i class="bi bi-search display-1 text-muted mb-4"></i>
                <h4 class="text-muted">Không tìm thấy kết quả</h4>
                <p class="text-muted mb-4">Vui lòng thử lại với từ khóa khác</p>
                <button class="btn btn-primary" onclick="clearSearch()">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                    Đặt lại tìm kiếm
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #0d6efd;
        --primary-dark: #0b5ed7;
        --primary-light: #e7f1ff;
        --transition: all 0.3s ease;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: url('data:image/svg+xml,<svg...>') repeat;
        opacity: 0.1;
    }

    .search-container .form-control {
        border: none;
        padding: 15px 25px;
        font-size: 1.1rem;
        border-radius: 10px 0 0 10px;
    }

    .search-container .btn {
        padding: 15px 30px;
        font-size: 1.1rem;
        border-radius: 0 10px 10px 0;
        transition: var(--transition);
    }

    /* Filter Section */
    .filter-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-filter {
        padding: 12px 24px;
        border-radius: 10px;
        background: var(--primary-light);
        color: var(--primary);
        border: none;
        transition: var(--transition);
    }

    .btn-filter:hover, .btn-filter.active {
        background: var(--primary);
        color: white;
    }

    .btn-filter .badge {
        transition: var(--transition);
    }

    .btn-filter:hover .badge, .btn-filter.active .badge {
        background: var(--primary-light);
        color: var(--primary);
    }

    /* Department Cards */
    .department-card {
        border-radius: 15px;
        transition: var(--transition);
    }

    .department-card:hover {
        transform: translateY(-10px);
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        background: var(--primary-light);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--primary);
        transition: var(--transition);
    }

    .department-card:hover .icon-wrapper {
        color: white;
        transform: scale(1.1);
    }

    .btn-hover-fill {
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .btn-hover-fill::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 100%;
        background: var(--primary);
        transition: var(--transition);
        z-index: -1;
    }

    .btn-hover-fill:hover {
        color: white;
    }

    .btn-hover-fill:hover::before {
        width: 100%;
    }

    /* Animations */
    .animate-up {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s ease forwards;
    }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Empty State */
    .empty-state {
        padding: 60px 20px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-section {
            text-align: center;
        }

        .search-container {
            margin-top: 30px;
        }

        .filter-buttons {
            justify-content: center;
        }

        .btn-filter {
            width: 100%;
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize animations
            const animateElements = document.querySelectorAll('.animate-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animationDelay = `${entry.target.dataset.delay || 0}s`;
                        entry.target.style.animationPlayState = 'running';
                        observer.unobserve(entry.target);
                    }
                });
            });

            animateElements.forEach((el, index) => {
                el.style.animationPlayState = 'paused';
                el.dataset.delay = index * 0.1;
                observer.observe(el);
            });

            // Search functionality with debounce
            let searchTimeout;
            const searchInput = document.getElementById('department-search');
            
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    const searchTerm = this.value.toLowerCase().trim();
                    filterDepartments(searchTerm);
                }, 300);
            });

            // Filter functionality
            const filterButtons = document.querySelectorAll('.btn-filter');
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    filterDepartments();
                });
            });

            function filterDepartments(searchTerm = '') {
                const activeFilter = document.querySelector('.btn-filter.active').dataset.filter;
                const departments = document.querySelectorAll('.department-item');
                let visibleCount = 0;

                departments.forEach(dept => {
                    const category = dept.dataset.category;
                    const name = dept.dataset.name;
                    
                    // Xác định xem department có phù hợp với filter không
                    let matchesFilter = activeFilter === 'all';
                    
                    if (activeFilter === 'trung-tam' && name.includes('trung tâm')) {
                        matchesFilter = true;
                    } else if (activeFilter === 'khoa' && name.includes('khoa')) {
                        matchesFilter = true;
                    }
                    
                    const matchesSearch = !searchTerm || name.includes(searchTerm);

                    if (matchesFilter && matchesSearch) {
                        dept.classList.remove('d-none');
                        visibleCount++;
                        // Add fade in animation
                        dept.style.animation = 'fadeInUp 0.5s ease forwards';
                    } else {
                        dept.classList.add('d-none');
                    }
                });

                // Show/hide no results message
                const noResults = document.getElementById('no-results');
                if (visibleCount === 0) {
                    noResults.classList.remove('d-none');
                    noResults.style.animation = 'fadeInUp 0.5s ease forwards';
                } else {
                    noResults.classList.add('d-none');
                }

                // Update filter counts
                updateFilterCounts();
            }

            function updateFilterCounts() {
                // Reset counts
                const counts = {
                    'all': 0,
                    'trung-tam': 0,
                    'khoa': 0
                };
                
                // Count visible departments by category
                const departments = document.querySelectorAll('.department-item');
                departments.forEach(dept => {
                    if (!dept.classList.contains('d-none')) {
                        counts['all']++;
                        
                        // Check if the department is a "Trung tâm" or "Khoa"
                        const name = dept.dataset.name.toLowerCase();
                        if (name.includes('trung tâm')) {
                            counts['trung-tam']++;
                        } else if (name.includes('khoa')) {
                            counts['khoa']++;
                        }
                    }
                });

                // Update badges
                filterButtons.forEach(button => {
                    const filter = button.dataset.filter;
                    const badge = button.querySelector('.badge');
                    if (badge) {
                        badge.textContent = counts[filter] || 0;
                    }
                });
            }

            // Clear search function
            window.clearSearch = function() {
                searchInput.value = '';
                const allFilterBtn = document.querySelector('[data-filter="all"]');
                allFilterBtn.click();
            }

            // Add loading animation for department cards
            const departmentCards = document.querySelectorAll('.department-card');
            departmentCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-10px)';
                    this.style.boxShadow = '0 10px 30px rgba(0,0,0,0.1)';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '0 2px 10px rgba(0,0,0,0.08)';
                });
            });

            // Add smooth scrolling
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Add loading state to buttons
            document.querySelectorAll('.btn').forEach(button => {
                button.addEventListener('click', function() {
                    if (!this.classList.contains('btn-filter')) {
                        const originalContent = this.innerHTML;
                        this.innerHTML = `
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Loading...
                        `;
                        this.disabled = true;

                        setTimeout(() => {
                            this.innerHTML = originalContent;
                            this.disabled = false;
                        }, 1000);
                    }
                });
            });

            // Add tooltip initialization
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Add scroll to top button
            const scrollButton = document.createElement('button');
            scrollButton.className = 'scroll-to-top btn btn-primary';
            scrollButton.innerHTML = '<i class="bi bi-arrow-up"></i>';
            document.body.appendChild(scrollButton);

            window.addEventListener('scroll', () => {
                if (window.pageYOffset > 300) {
                    scrollButton.classList.add('show');
                } else {
                    scrollButton.classList.remove('show');
                }
            });

            scrollButton.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            // Add additional styles for scroll to top button
            const style = document.createElement('style');
            style.textContent = `
                .scroll-to-top {
                    position: fixed;
                    bottom: 20px;
                    right: 20px;
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    opacity: 0;
                    visibility: hidden;
                    transition: all 0.3s ease;
                    z-index: 1000;
                }

                .scroll-to-top.show {
                    opacity: 1;
                    visibility: visible;
                }

                .scroll-to-top:hover {
                    transform: translateY(-3px);
                }

                @@media (max-width: 768px) {
                    .scroll-to-top {
                        bottom: 10px;
                        right: 10px;
                    }
                }
            `;
            document.head.appendChild(style);

            // Update filter counts immediately when page loads
            updateFilterCounts();
        });
    </script>
}