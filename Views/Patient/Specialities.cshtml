
@using AppointmentHospital.Models
@using AppointmentHospital.Helpers
@model Pagination<Specialities>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="departments-page">
    <!-- Hero Section (unchanged) -->
    <div class="hero-section bg-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold mb-4 animate-up">Chuyên Khoa Y Tế</h1>
                    <p class="lead mb-4 animate-up">Khám phá các chuyên khoa y tế chất lượng cao với đội ngũ bác sĩ giàu kinh nghiệm</p>
                </div>
                <div class="col-lg-6">
                    <div class="search-container animate-up">
                        <div class="input-group">
                            <input type="text" 
                                   id="department-search" 
                                   class="form-control form-control-lg shadow-none" 
                                   placeholder="Tìm kiếm chuyên khoa..."
                                   aria-label="Search departments"
                                   value="@searchTerm">
                            <button class="btn btn-secondary px-4" type="button" id="search-button">
                                Tìm kiếm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content (unchanged except for pagination) -->
    <div class="container py-5">
        <!-- Filter Section (unchanged) -->
        <div class="filter-section mb-5 animate-up">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-filter-circle me-2"></i>
                        Lọc theo danh mục
                    </h5>
                    <div class="filter-buttons">
                        <button class="btn btn-filter active" data-filter="all">
                            <i class="bi bi-grid-fill me-2"></i>
                            Tất cả
                            <span class="badge bg-white text-primary ms-2"></span>
                        </button>
                        <button class="btn btn-filter" data-filter="trung-tam">
                            <i class="bi bi-building me-2"></i>
                            Trung tâm
                            <span class="badge bg-white text-primary ms-2"></span>
                        </button>
                        <button class="btn btn-filter" data-filter="khoa">
                            <i class="bi bi-clipboard2-pulse me-2"></i>
                            Khoa
                            <span class="badge bg-white text-primary ms-2"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Departments Grid -->
        <div class="row g-4" id="departments-container">
            @foreach (var department in Model)
            {
                <div class="col-12 col-md-6 col-lg-3 department-item animate-up" 
                     data-category="@(department.SpecialityName.ToLower().Contains("trung tâm") ? "trung-tam" : 
                                     department.SpecialityName.ToLower().Contains("khoa") ? "khoa" : "other")" 
                     data-name="@department.SpecialityName.ToLower()">
                    <div class="department-card card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="icon-wrapper mx-auto mb-4">
                                <img src="@department.SpecialityImage" alt="@department.SpecialityName" class="img-fluid" />
                            </div>
                            <h3 class="card-title h5 mb-3">@department.SpecialityName</h3>
                            <a asp-controller="Patient" asp-action="DetailSpecialities" asp-route-id="@department.Id" class="btn btn-outline-primary btn-hover-fill">
                                <i class="bi bi-arrow-right-circle me-2"></i>
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @{
            int totalPages = Model.TotalPage;
            int currentPage = Model.CurrentPage;
            int maxDisplayedPages = 8;
            int startPage = Math.Max(1, currentPage - 3);
            int endPage = Math.Min(totalPages, currentPage + 3);

            if (totalPages > maxDisplayedPages)
            {
                if (currentPage <= 4)
                {
                    startPage = 1;
                    endPage = maxDisplayedPages;
                }
                else if (currentPage >= totalPages - 3)
                {
                    startPage = totalPages - maxDisplayedPages + 1;
                    endPage = totalPages;
                }
            }
            else
            {
                startPage = 1;
                endPage = totalPages;
            }

            object CreateRouteValues(int page)
            {
                var routeValues = new RouteValueDictionary 
                { 
                    { "page", page },
                    { "filter", ViewBag.Filter ?? "all" } // Lưu giá trị bộ lọc từ ViewBag
                };
                
                if (!string.IsNullOrEmpty(searchTerm))
                {
                    routeValues.Add("searchTerm", searchTerm);
                }
                
                return routeValues;
            }
        }

        <div class="d-flex justify-content-center align-items-center p-4">
            <nav aria-label="Điều hướng phân trang" class="mx-auto">
                <ul class="pagination pagination-rounded mb-0">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Specialities", "Patient", CreateRouteValues(Model.CurrentPage - 1))" aria-label="Trang trước">
                                <span aria-hidden="true">«</span>
                            </a>
                        </li>
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Specialities", "Patient", CreateRouteValues(1))">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Specialities", "Patient", CreateRouteValues(i))">@i</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Specialities", "Patient", CreateRouteValues(totalPages))">@totalPages</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Specialities", "Patient", CreateRouteValues(Model.CurrentPage + 1))" aria-label="Trang sau">
                                <span aria-hidden="true">»</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

        <!-- No Results Message -->
        <div id="no-results" class="text-center py-5 d-none animate-up">
            <div class="empty-state">
                <i class="bi bi-search display-1 text-muted mb-4"></i>
                <h4 class="text-muted">Không tìm thấy kết quả</h4>
                <p class="text-muted mb-4">Vui lòng thử lại với từ khóa khác</p>
                <button class="btn btn-primary" onclick="clearSearch()">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                    Đặt lại tìm kiếm
                </button>
            </div>
        </div>
    </div>
</div>
<style>
    :root {
        /* Base colors */
        --primary-50: #eff6ff;
        --primary-100: #dbeafe;
        --primary-200: #bfdbfe;
        --primary-300: #93c5fd;
        --primary-400: #60a5fa;
        --primary-500: #3b82f6;
        --primary-600: #2563eb;
        --primary-700: #1d4ed8;
        --primary-800: #1e40af;
        --primary-900: #1e3a8a;

        /* Supporting colors */
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;

        /* Neutrals */
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-400: #9ca3af;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-800: #1f2937;
        --gray-900: #111827;

        /* Shadows */
        --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.05);
        --shadow: 0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px 0 rgba(0,0,0,0.06);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);

        /* Border radius */
        --radius-sm: 0.125rem;
        --radius: 0.25rem;
        --radius-md: 0.375rem;
        --radius-lg: 0.5rem;
        --radius-xl: 0.75rem;
        --radius-2xl: 1rem;
        --radius-3xl: 1.5rem;
        --radius-full: 9999px;

        /* Added missing variables */
        --primary: var(--primary-500);
        --primary-light: var(--primary-100);
        --transition: all 0.3s ease;
    }


    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, var(--primary-600), var(--primary-800));
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: url('data:image/svg+xml,<svg...>') repeat;
        opacity: 0.1;
    }

    .search-container .form-control {
        border: none;
        padding: 15px 25px;
        font-size: 1.1rem;
        border-radius: 10px 0 0 10px;
    }

    .search-container .btn {
        padding: 15px 30px;
        font-size: 1.1rem;
        border-radius: 0 10px 10px 0;
        transition: var(--transition);
    }

    /* Filter Section */
    .filter-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-filter {
        padding: 12px 24px;
        border-radius: 10px;
        background: var(--primary-light);
        color: var(--primary);
        border: none;
        transition: var(--transition);
    }

    .btn-filter:hover, .btn-filter.active {
        background: var(--primary);
        color: white;
    }

    .btn-filter .badge {
        transition: var(--transition);
    }

    .btn-filter:hover .badge, .btn-filter.active .badge {
        background: var(--primary-light);
        color: var(--primary);
    }

    /* Department Cards */
    .department-card {
        border-radius: 15px;
        transition: var(--transition);
    }

    .department-card:hover {
        transform: translateY(-10px);
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        background: var(--primary-light);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--primary);
        transition: var(--transition);
    }

    .department-card:hover .icon-wrapper {
        color: white;
        transform: scale(1.1);
    }

    .btn-hover-fill {
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .btn-hover-fill::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 100%;
        background: var(--primary);
        transition: var(--transition);
        z-index: -1;
    }

    .btn-hover-fill:hover {
        color: white;
    }

    .btn-hover-fill:hover::before {
        width: 100%;
    }

    /* Animations */
    .animate-up {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s ease forwards;
    }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Empty State */
    .empty-state {
        padding: 60px 20px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-section {
            text-align: center;
        }

        .search-container {
            margin-top: 30px;
        }

        .filter-buttons {
            justify-content: center;
        }

        .btn-filter {
            width: 100%;
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize animations
            const animateElements = document.querySelectorAll('.animate-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animationDelay = `${entry.target.dataset.delay || 0}s`;
                        entry.target.style.animationPlayState = 'running';
                        observer.unobserve(entry.target);
                    }
                });
            });

            animateElements.forEach((el, index) => {
                el.style.animationPlayState = 'paused';
                el.dataset.delay = index * 0.1;
                observer.observe(el);
            });

            // Search and filter functionality with debounce
            const searchInput = document.getElementById('department-search');
            const searchButton = document.getElementById('search-button');
            const filterButtons = document.querySelectorAll('.btn-filter');

            // Set active filter button based on ViewBag.Filter
            const currentFilter = '@(ViewBag.Filter ?? "all")';
            filterButtons.forEach(button => {
                button.classList.remove('active');
                if (button.dataset.filter === currentFilter) {
                    button.classList.add('active');
                }
            });

            // Debounce function to limit how often performAction is called
            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            // Function to perform the search or filter action
            const performAction = debounce(function() {
                const searchTerm = searchInput.value.trim();
                const activeFilter = document.querySelector('.btn-filter.active').dataset.filter;
                const url = new URL(window.location.href);
                url.searchParams.set('page', '1'); // Reset to first page
                url.searchParams.set('filter', activeFilter); // Set filter parameter
                if (searchTerm) {
                    url.searchParams.set('searchTerm', searchTerm);
                } else {
                    url.searchParams.delete('searchTerm');
                }
                // Prevent multiple reloads by checking if URL has changed
                if (url.toString() !== window.location.href) {
                    window.location.href = url.toString();
                }
            }, 300);

            // Handle search input (input event for typing)
            searchInput.addEventListener('input', performAction);

            // Handle search input (Enter key)
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault(); // Prevent form submission if input is in a form
                    performAction();
                }
            });

            // Handle search button click
            searchButton.addEventListener('click', function(e) {
                e.preventDefault(); // Prevent any default behavior
                performAction();
            });

            // Handle filter buttons
            filterButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault(); // Prevent any default behavior
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    performAction();
                });
            });

            // Clear search function
            window.clearSearch = function() {
                searchInput.value = '';
                const url = new URL(window.location.href);
                url.searchParams.delete('searchTerm');
                url.searchParams.set('page', '1');
                url.searchParams.set('filter', 'all');
                filterButtons.forEach(btn => btn.classList.remove('active'));
                document.querySelector('.btn-filter[data-filter="all"]').classList.add('active');
                if (url.toString() !== window.location.href) {
                    window.location.href = url.toString();
                }
            };

            // Add loading animation for department cards
            const departmentCards = document.querySelectorAll('.department-card');
            departmentCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-10px)';
                    this.style.boxShadow = '0 10px 30px rgba(0,0,0,0.1)';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '0 2px 10px rgba(0,0,0,0.08)';
                });
            });

            // Add smooth scrolling
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Add loading state to buttons
            document.querySelectorAll('.btn').forEach(button => {
                button.addEventListener('click', function() {
                    if (!this.classList.contains('btn-filter') && this.id !== 'search-button') {
                        const originalContent = this.innerHTML;
                        this.innerHTML = `
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Loading...
                        `;
                        this.disabled = true;

                        setTimeout(() => {
                            this.innerHTML = originalContent;
                            this.disabled = false;
                        }, 1000);
                    }
                });
            });

            // Add tooltip initialization
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Add scroll to top button
            const scrollButton = document.createElement('button');
            scrollButton.className = 'scroll-to-top btn btn-primary';
            scrollButton.innerHTML = '<i class="bi bi-arrow-up"></i>';
            document.body.appendChild(scrollButton);

            window.addEventListener('scroll', () => {
                if (window.pageYOffset > 300) {
                    scrollButton.classList.add('show');
                } else {
                    scrollButton.classList.remove('show');
                }
            });

            scrollButton.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        });
    </script>
}