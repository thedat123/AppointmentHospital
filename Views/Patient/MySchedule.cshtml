@model List<Appointment>
@section Styles {
    <link href="~/css/my-schedule.css" rel="stylesheet" />
}
<div class="dashboard-container">
    <div class="row g-4">
        <div class="col-12 col-md-3">
            <div class="sidebar">
                <h3 class="nav-title">
                    <i class="fas fa-filter me-2"></i>Filter Status
                </h3>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(string.IsNullOrEmpty(Context.Request.Query["status"]) ? "active" : "")" 
                        asp-page="/User/Order/MyOrder">
                            <i class="fas fa-th-list"></i>
                            All Appointments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["status"] == ((int)AppointmentHospital.EnumStatus.AppointmentStatus.Pending).ToString() ? "active" : "")" 
                        asp-route-status="@((int)AppointmentHospital.EnumStatus.AppointmentStatus.Pending)">
                            <i class="fas fa-clock"></i>
                            Pending
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["status"] == ((int)AppointmentHospital.EnumStatus.AppointmentStatus.Confirmed).ToString() ? "active" : "")" 
                        asp-route-status="@((int)AppointmentHospital.EnumStatus.AppointmentStatus.Confirmed)">
                            <i class="fas fa-check-circle"></i>
                            Confirmed
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["status"] == ((int)AppointmentHospital.EnumStatus.AppointmentStatus.Completed).ToString() ? "active" : "")" 
                        asp-route-status="@((int)AppointmentHospital.EnumStatus.AppointmentStatus.Completed)">
                            <i class="fas fa-calendar-alt"></i>
                            Completed
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["status"] == ((int)AppointmentHospital.EnumStatus.AppointmentStatus.Canceled).ToString() ? "active" : "")" 
                        asp-route-status="@((int)AppointmentHospital.EnumStatus.AppointmentStatus.Canceled)">
                            <i class="fas fa-times-circle"></i>
                            Cancelled
                        </a>
                    </li>
                    
                </ul>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <div class="main-content">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-calendar-alt me-2"></i>My Appointments
                    </h2>
                </div>
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user-md me-2"></i>Doctor</th>
                                    <th><i class="fas fa-notes-medical me-2">Specialist</i></th>
                                    <th><i class="fas fa-clock me-2"></i>Appointment Time</th>
                                    <th><i class="fas fa-notes-medical me-2"></i>Symptoms</th>
                                    <th><i class="fas fa-info-circle me-2"></i>Status</th>
                                    <th><i class="fas fa-cog me-2"></i>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model.OrderByDescending(a => a.AppointmentTime))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fas fa-user-md text-primary"></i>
                                                <span>Dr. @appointment.Doctor.FullName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span>@appointment.Doctor.Specializaiton</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold">@appointment.AppointmentTime.ToString("dddd, MMMM d, yyyy")</span>
                                                <small class="text-muted">@appointment.AppointmentTime.ToString("h:mm tt")</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;" title="@appointment.Symptoms">
                                                @appointment.Symptoms
                                            </div>
                                        </td>
                                        <td class="status">
                                            @switch(appointment.Status)
                                            {
                                                case AppointmentHospital.EnumStatus.AppointmentStatus.Pending:
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-clock"></i>
                                                        Pending
                                                    </span>
                                                    break;
                                                case AppointmentHospital.EnumStatus.AppointmentStatus.Confirmed:
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle"></i>
                                                        Confirmed
                                                    </span>
                                                    break;
                                                case AppointmentHospital.EnumStatus.AppointmentStatus.Completed:
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-calendar-alt"></i>
                                                        Completed
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-times-circle"></i>
                                                        Cancelled
                                                    </span>
                                                    break;
                                            }
                                        </td>
                                        <td class="action"
                                            data-appointment-id="@appointment.AppointmentId"
                                            data-appointment-time="@appointment.AppointmentTime.ToString("o")";
                                        >
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-calendar-times"></i>
                        <h4>No Appointments Found</h4>
                        <p>You don't have any appointments matching the selected criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" 
     aria-labelledby="feedbackModalLabel" 
     role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="feedbackModalLabel">
                    <span class="fas fa-comment-medical me-2" role="presentation"></span>
                    Appointment Feedback
                </h5>
                <button type="button" 
                        class="btn-close btn-close-white" 
                        data-bs-dismiss="modal"
                        aria-label="Close feedback form"></button>
            </div>
            <div class="modal-body">
                <div class="appointment-summary mb-4">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="doctor-profile text-center">
                                <img src="" id="doctorImage" class="rounded-circle mb-2" alt="Doctor" />
                                <h6 id="doctorName" class="mb-1"></h6>
                                <small id="doctorSpecialization" class="text-muted"></small>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="appointment-details">
                                <h6 class="text-primary mb-3">Appointment Details</h6>
                                <div class="info-grid">
                                    <div class="info-item">
                                        <i class="fas fa-calendar-day"></i>
                                        <span id="appointmentDate"></span>
                                    </div>
                                    <div class="info-item">
                                        <i class="fas fa-clock"></i>
                                        <span id="appointmentTime"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <form id="feedbackForm">
                    <input type="hidden" id="appointmentId" name="appointmentId" />
                    
                    <div class="rating-section mb-4">
                        <h6 class="text-primary mb-3">Overall Rating</h6>
                        <div class="rating">
                            <i class="far fa-star" data-rating="1"></i>
                            <i class="far fa-star" data-rating="2"></i>
                            <i class="far fa-star" data-rating="3"></i>
                            <i class="far fa-star" data-rating="4"></i>
                            <i class="far fa-star" data-rating="5"></i>
                        </div>
                        <input type="hidden" name="rating" id="rating" required />
                    </div>

                    <div class="feedback-categories mb-4">
                        <h6 class="text-primary mb-3">Rate These Aspects</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Professional Skills</label>
                                <select class="form-select" name="professionalSkills" required>
                                    <option value="">Select rating</option>
                                    <option value="5">Excellent</option>
                                    <option value="4">Very Good</option>
                                    <option value="3">Good</option>
                                    <option value="2">Fair</option>
                                    <option value="1">Poor</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Communication</label>
                                <select class="form-select" name="communication" required>
                                    <option value="">Select rating</option>
                                    <option value="5">Excellent</option>
                                    <option value="4">Very Good</option>
                                    <option value="3">Good</option>
                                    <option value="2">Fair</option>
                                    <option value="1">Poor</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Your Comments</h6>
                        <textarea class="form-control" name="comment" rows="4" 
                                placeholder="Share your experience with the doctor..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="submitFeedback">
                    <i class="fas fa-paper-plane me-2"></i>Submit Feedback
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View Feedback Modal -->
<div class="modal fade" id="viewFeedbackModal" tabindex="-1" 
     aria-labelledby="viewFeedbackModalLabel" 
     role="dialog"
    >
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="viewFeedbackModalLabel">
                    <span class="fas fa-comment-dots me-2" role="presentation"></span>
                    Feedback Details
                </h5>
                <button type="button" 
                        class="btn-close btn-close-white" 
                        data-bs-dismiss="modal"
                        aria-label="Close feedback details"></button>
            </div>
            <div class="modal-body">
                <div class="doctor-info mb-4">
                    <div class="d-flex align-items-center">
                        <div class="doctor-avatar me-3" role="img" aria-label="doctor avatar">
                            <span class="fas fa-user-md fa-3x"></span>
                        </div>
                        <div>
                            <h6 id="doctorName" class="mb-1"></h6>
                            <p id="doctorSpecialization" class="text-muted mb-0"></p>
                        </div>
                    </div>
                </div>

                <div class="ratings-grid mb-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="rating-card">
                                <h6 class="text-muted">Overall Rating</h6>
                                <div id="overallRating" class="rating-stars" role="img" aria-label="rating stars"></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="rating-card">
                                <h6 class="text-muted">Professional Skills</h6>
                                <div id="professionalRating" class="rating-stars" role="img" aria-label="professional skills rating"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/myschedule.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/scheduleHub')
                .build();

            connection.start()
                .then(() => {
                    console.log("Connected to SignalR Hub");
                })
                .catch(err => console.error("SignalR connection error:", err));

            connection.on("UpdateStatus", (appointmentId, status) => {
                console.log(`Appointment ${appointmentId} updated to status ${status}`);

                const scrollPosition = window.scrollY;
                window.location.reload();
                window.scrollTo(0, scrollPosition);
            });
        });
    </script>
}
