@{
    Layout = "_Layout";
    ViewData["Title"] = "MedicalCare Healthcare";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12 hero-content">
                <h1 class="hero-title">Chăm sóc bằng tài năng, y đức và sự thấu cảm</h1>
                <p class="hero-description">MedicalCare cam kết và trách nhiệm xã hội và đóng góp tích cực vào sự phát triển bền vững của cộng đồng</p>
                <a href="#" class="btn hero-button">Khám phá ngay</a>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="services-section">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <div class="service-card text-center">
                    <i class="bi bi-telephone-fill service-icon"></i>
                    <h3 class="service-title">Gọi tổng đài</h3>
                    <p class="service-description">Hỗ trợ tư vấn 24/7 về các phương pháp điều trị của chúng tôi</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card text-center">
                    <i class="bi bi-calendar-check-fill service-icon"></i>
                    <h3 class="service-title">Đặt Lịch Hẹn</h3>
                    <p class="service-description">Đặt lịch khám trực tuyến một cách nhanh chóng và thuận tiện</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card text-center">
                    <i class="bi bi-person-plus-fill service-icon"></i>
                    <h3 class="service-title">Tìm bác sĩ</h3>
                    <p class="service-description">Dễ dàng tìm kiếm bác sĩ theo chuyên khoa và kinh nghiệm</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why MedicalCare Section -->
<section class="why-medicalcare">
    <div class="container">
        <h2 class="section-title">Tại sao nên chọn MedicalCare?</h2>
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="feature-card text-center">
                    <i class="bi bi-star-fill feature-icon"></i>
                    <h3 class="feature-title">Chuyên gia hàng đầu</h3>
                    <p class="feature-description">Đội ngũ bác sĩ giàu kinh nghiệm, được đào tạo bài bản tại các nước tiên tiến</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-card text-center">
                    <i class="bi bi-award-fill feature-icon"></i>
                    <h3 class="feature-title">Chất lượng quốc tế</h3>
                    <p class="feature-description">Đạt tiêu chuẩn JCI và các chứng nhận quốc tế về chất lượng y tế</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-card text-center">
                    <i class="bi bi-laptop-fill feature-icon"></i>
                    <h3 class="feature-title">Công nghệ tiên tiến</h3>
                    <p class="feature-description">Trang bị hệ thống máy móc hiện đại nhất từ các nước phát triển</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-card text-center">
                    <i class="bi bi-graph-up-arrow feature-icon"></i>
                    <h3 class="feature-title">Nghiên cứu & Đổi mới</h3>
                    <p class="feature-description">Liên tục cập nhật và áp dụng các phương pháp điều trị mới nhất</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Partners Section -->
<section class="partners-section">
    <div class="container">
        <h2 class="section-title">Đối tác của chúng tôi</h2>
        <div class="partners-slider">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-4">
                    <div class="partner-card">
                        <img src="https://www.vinmec.com/static/uploads/thumbnail_SYDNEY_b7a1caf16e.webp" 
                            alt="University of Sydney" 
                            class="img-fluid" 
                            style="max-width: 100%; height: auto;">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="partner-card">
                        <img src="https://www.vinmec.com/static/uploads/thumbnail_macquarie_b78149953a.webp" 
                            alt="University of Sydney" 
                            class="img-fluid" 
                            style="max-width: 100%; height: auto;">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="partner-card">
                        <img src="https://www.vinmec.com/static/uploads/thumbnail_astrazeneca_d3e3b4a691.webp" 
                            alt="University of Sydney" 
                            class="img-fluid" 
                            style="max-width: 100%; height: auto;">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Additional Styles -->
<style>
    .statistics-section {
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
        padding: 80px 0;
    }

    .stat-card {
        background: white;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary-color);
        margin: 1rem 0;
    }

    .stat-title {
        color: var(--text-secondary);
        font-size: 1.1rem;
        margin: 0;
    }

    /* Call to Action Section */
    .cta-section {
        background: var(--bg-gradient);
        padding: 80px 0;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .cta-section::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: url('/images/pattern.svg') repeat;
        opacity: 0.1;
    }

    .cta-content {
        position: relative;
        z-index: 1;
    }

    .cta-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .cta-description {
        font-size: 1.25rem;
        margin-bottom: 2rem;
        opacity: 0.9;
    }

    .cta-button {
        padding: 1rem 2.5rem;
        font-size: 1.125rem;
        border-radius: 50px;
        background: white;
        color: var(--primary-color);
        border: none;
        transition: all 0.3s ease;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        background: #f8fafc;
    }

    /* Loading Animation */
    .loading-animation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 5px solid #f3f3f3;
        border-top: 5px solid var(--primary-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    :root {
        --primary-color: #2563eb;
        --secondary-color: #0ea5e9;
        --accent-color: #22c55e;
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --bg-gradient: linear-gradient(135deg, #2563eb, #0ea5e9);
    }

    /* Enhanced Header Section */
    .hero-section {
        background: var(--bg-gradient);
        padding: 80px 0;
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: url('/images/pattern.svg') repeat;
        opacity: 0.1;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        color: white;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        animation: slideInLeft 1s ease-out;
    }

    .hero-description {
        font-size: 1.25rem;
        margin-bottom: 2rem;
        opacity: 0.9;
        animation: slideInLeft 1s ease-out 0.2s;
    }

    .hero-button {
        padding: 1rem 2rem;
        font-size: 1.125rem;
        border-radius: 50px;
        background: var(--accent-color);
        border: none;
        color: white;
        transition: all 0.3s ease;
        animation: slideInLeft 1s ease-out 0.4s;
    }

    .hero-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        background: #16a34a;
    }

    .hero-image {
        animation: floatAnimation 3s ease-in-out infinite;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    /* Enhanced Service Icons */
    .services-section {
        margin-top: -50px;
        position: relative;
        z-index: 2;
    }

    .service-card {
        background: white;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .service-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .service-icon {
        font-size: 2.5rem;
        color: var(--primary-color);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .service-card:hover .service-icon {
        transform: scale(1.1);
        color: var(--secondary-color);
    }

    .service-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .service-description {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    /* Enhanced Why Vinmec Section */
    .why-vinmec {
        padding: 80px 0;
        background: #f8fafc;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        text-align: center;
        margin-top: 3rem;
        margin-bottom: 3rem;
        color: var(--text-primary);
        position: relative;
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background: var(--bg-gradient);
        border-radius: 2px;
    }

    .feature-card {
        background: white;
        padding: 2.5rem;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        height: 100%;
    }

    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1);
        color: var(--secondary-color);
    }

    .feature-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .feature-description {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
    }

    /* Enhanced Partners Section */
    .partners-section {
        padding: 80px 0;
        background: white;
    }

    .partners-slider {
        padding: 40px 0;
    }

    .partner-card {
        background: white;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        margin: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .partner-card img {
        max-width: 180px;
        filter: grayscale(100%);
        transition: all 0.3s ease;
    }

    .partner-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .partner-card:hover img {
        filter: grayscale(0%);
    }

    /* Animations */
    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-50px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes floatAnimation {
        0% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
        100% {
            transform: translateY(0px);
        }
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .hero-description {
            font-size: 1.1rem;
        }

        .service-card {
            margin-bottom: 20px;
        }

        .feature-card {
            margin-bottom: 20px;
        }
    }
</style>

<!-- JavaScript for Enhanced Interactions -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // Loading Animation
            $(window).on('load', function() {
                $('.loading-animation').fadeOut('slow');
            });

            // Animate on scroll
            $(window).scroll(function() {
                $('.feature-card, .service-card, .stat-card, .partner-card').each(function() {
                    var cardPosition = $(this).offset().top;
                    var scrollPosition = $(window).scrollTop();
                    var windowHeight = $(window).height();

                    if (scrollPosition > cardPosition - windowHeight + 100) {
                        $(this).addClass('animate__animated animate__fadeInUp');
                    }
                });
            });

            // Counter Animation for Statistics
            $('.stat-number').each(function() {
                $(this).prop('Counter', 0).animate({
                    Counter: $(this).text()
                }, {
                    duration: 2000,
                    easing: 'swing',
                    step: function(now) {
                        $(this).text(Math.ceil(now));
                    }
                });
            });

            // Smooth Scroll
            $('a[href*="#"]').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $($(this).attr('href')).offset().top - 100
                }, 500, 'linear');
            });
        });
    </script>
}