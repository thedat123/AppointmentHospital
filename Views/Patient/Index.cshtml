@model IEnumerable<AppointmentHospital.Models.Doctor>
@using AppointmentHospital.EnumStatus

@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/patientIndex.css" asp-append-version="true" />

<div class="hero-section text-white text-center py-5" 
    style="background-image: url('@Url.Content("~/images/bookingcare-cove.jpg")'); 
           background-size: cover; 
           background-position: center; 
           min-height: 90vh; 
           display: flex; 
           align-items: center;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4" 
            style="color: cyan; text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);">
            MEDICAL PLATFORM
        </h1>
        <h2 class="h4 fw-light mb-5">
            Comprehensive healthcare for every family
        </h2>

        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">
                <form action="/Patient/Predict" method="post">
                    <div class="input-group search-bar mb-4 shadow-lg"> 
                        <input type="text" class="form-control form-control-lg" id="searchInput"
                            placeholder="Search Symtomps" name="symptoms" 
                            style="border-radius: 50px 0 0 50px; padding: 20px;" />
                        <button class="btn btn-primary px-4" type="submit" 
                            style="border-radius: 0 50px 50px 0; font-size: 1.2rem;">
                            <i class="fas fa-search me-2"></i> Search
                        </button>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <input type="file" id="imageInput" class="form-control" accept="image/*" style="display: none;" />
                        <button class="btn btn-info btn-lg d-flex align-items-center gap-2 px-4"
                            type="button" onclick="startVoiceSearch()" style="border-radius: 50px;">
                            <i class="fas fa-microphone"></i> Voice Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-4 shadow-lg rounded-4 d-flex align-items-center gap-3 p-3">
                <div class="icon-container text-white bg-danger d-flex align-items-center justify-content-center rounded-circle" 
                    style="width: 50px; height: 50px;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 1.5rem;"></i>
                </div>
                <div class="text-container flex-grow-1">
                    <h5 class="fw-bold text-danger mb-1">An Error Occurred</h5>
                    <p class="mb-0">@TempData["Error"]</p>
                </div>
            </div>
        }

        @if (TempData["Disease"] != null && TempData["Probability"] != null)
        {
            <div class="card text-dark bg-light mt-4 shadow-lg rounded-4">
                <div class="card-header bg-primary text-white fw-bold d-flex align-items-center gap-2 rounded-top-4">
                    <i class="fas fa-stethoscope"></i>
                    <span>Prediction Details</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 d-flex flex-column align-items-center border-end">
                            <div class="text-center mb-3">
                                <h5 class="fw-bold text-danger">Disease Detected:</h5>
                                <h4 class="badge bg-danger text-white py-2 px-3" style="font-size: 1.2rem;">
                                    @TempData["Disease"]
                                </h4>
                            </div>
                            <div class="text-center">
                                <h5 class="fw-bold text-success">Probability:</h5>
                                <h4 class="text-success fw-bold">
                                    <i class="fas fa-chart-bar me-2"></i>@TempData["ProbabilityPercentage"] %
                                </h4>
                            </div>
                        </div>

                        <div class="col-md-6 d-flex flex-column justify-content-center">
                            <h5 class="fw-bold text-info text-center mb-3">Disease Description</h5>
                            <p class="card-text text-center">
                                <i class="fas fa-paragraph text-primary me-2"></i>@TempData["Description"]
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<div class="container my-5">
    <section class="services-section">
        <div class="container">
            <div class="row g-4">
                @{
                    var services = new[] {
                        ("specialist.png", "Khám chuyên khoa"),
                        ("remote.png", "Khám từ xa"),
                        ("general.png", "Khám tổng quát"),
                        ("mental.png", "Sức khỏe tinh thần"),
                    };
                }
                @foreach (var (icon, label) in services)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="service-card">
                            <img src="@Url.Content($"~/images/patient/{icon}")" alt="@label" class="service-icon">
                            <h3 class="h5 mt-3">@label</h3>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="doctors-section mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h4 fw-bold">Doctor List</h2>
            <a href="#" class="link-primary text-decoration-none">See more</a>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var doctor in Model)
            {
                <div class="col">
                    <div class="card doctor-card border-0">
                        <div class="card-body text-center">
                            <div class="mb-3 mx-auto rounded-circle overflow-hidden" style="width: 120px; height: 120px;">
                                <img src="@Url.Content(string.IsNullOrEmpty(doctor.ImagePath) ? "~/images/user-default.png" : $"~/images/{doctor.ImagePath}")"
                                    alt="@doctor.FullName" class="w-100 h-100 object-fit-cover">
                            </div>
                            <h5 class="card-title text-dark">@doctor.FullName</h5>
                            <p class="card-text text-muted small">@doctor.Specializaiton.GetDisplayName()</p>

                            <a onclick="@(User.Identity.IsAuthenticated? "return true" : "showLoginAlert(); return false")" href="@Url.Action("DetailDoctor", "Patient", new { id = doctor.DoctorId })"
                                class="btn btn-primary mt-3">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
