
@using AppointmentHospital.EnumStatus
@using AppointmentHospital.Helpers
@model Pagination<AppointmentHospital.Models.Appointment>

<div class="container py-4">
    <!-- Thẻ tìm kiếm và lọc -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" id="searchAppointment" placeholder="Tìm theo tên hoặc mã hẹn...">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-calendar-alt text-muted"></i>
                        </span>
                        <input type="date" class="form-control border-start-0" id="appointmentDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="statusFilter">
                        <option value="">Tất cả trạng thái</option>
                        <option value="1">Đã xác nhận</option>
                        <option value="2">Chờ xác nhận</option>
                        <option value="3">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i> Lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white p-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 d-flex align-items-center text-primary">
                <i class="fas fa-calendar-check me-2"></i> Danh sách lịch hẹn
            </h5>
            <div class="d-flex gap-2">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-download me-1"></i> Xuất
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#"><i class="far fa-file-excel me-2"></i>Excel</a></li>
                        <li><a class="dropdown-item" href="#"><i class="far fa-file-pdf me-2"></i>PDF</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="col-1 ps-3">Mã hẹn</th>
                            <th scope="col" class="col-2">Ngày & giờ</th>
                            <th scope="col" class="col-2">Bệnh nhân</th>
                            <th scope="col" class="col-2">Liên hệ</th>
                            <th scope="col" class="col-2">Triệu chứng</th>
                            <th scope="col" class="col-1">Trạng thái</th>
                            <th scope="col" class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var appointment in Model)
                            {
                                // Lấy 6 ký tự cuối của ID và định dạng lại
                                var shortId = appointment.AppointmentId.ToString().Length > 6 
                                    ? appointment.AppointmentId.ToString().Substring(Math.Max(0, appointment.AppointmentId.ToString().Length - 6)) 
                                    : appointment.AppointmentId.ToString();
                                    
                                // Tạo mã hẹn định dạng mới
                                var appointmentCode = $"AP-{shortId}";
                                
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2">
                                            <i class="fas fa-bookmark me-1"></i>
                                            @appointmentCode
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="calendar-icon rounded text-center me-2 p-1" 
                                                 style="width: 40px; background-color: #f0f9ff; border: 1px solid #e6f2ff;">
                                                <div class="small text-primary fw-bold">@appointment.AppointmentTime.ToString("MMM")</div>
                                                <div class="fw-bold fs-5">@appointment.AppointmentTime.ToString("dd")</div>
                                            </div>
                                            <div>
                                                <div class="fw-medium">@appointment.AppointmentTime.ToString("dddd")</div>
                                                <div class="small text-muted">
                                                    <i class="far fa-clock me-1"></i>@appointment.AppointmentTime.ToString("HH:mm")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle rounded-circle text-center me-2 d-flex align-items-center justify-content-center"
                                                 style="width: 32px; height: 32px; background-color: #e9ecef;">
                                                <i class="fas fa-user text-secondary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">
                                                    @(appointment.Acquaintance?.Name != null
                                                        ? appointment.Acquaintance.Name
                                                        : appointment.Patient.FullName)
                                                </div>
                                                @if (appointment.Acquaintance?.Name != null)
                                                {
                                                    <div class="small text-muted">Người thân</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var phoneNumber = appointment.Acquaintance?.PhoneNumber != null
                                                ? appointment.Acquaintance.PhoneNumber
                                                : appointment.Patient.PhoneNumber;
                                            
                                            var address = !string.IsNullOrEmpty(appointment.Acquaintance?.Address)
                                                ? appointment.Acquaintance.Address
                                                : appointment.Patient.Address;
                                        }
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-phone-alt text-muted me-2"></i>
                                                <a href="tel:@phoneNumber" class="text-decoration-none">@phoneNumber</a>
                                            </div>
                                            <div class="d-flex align-items-center text-truncate" style="max-width: 180px;" title="@address">
                                                <i class="fas fa-map-marker-alt text-muted me-2"></i>
                                                <span class="small text-muted">@address</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="symptoms-container" style="max-height: 40px; overflow: hidden; position: relative;">
                                            <p class="mb-0 text-truncate" style="max-width: 180px;" title="@appointment.Symptoms">
                                                @(!string.IsNullOrEmpty(appointment.Symptoms) ? appointment.Symptoms : "Không có triệu chứng")
                                            </p>
                                            @if (!string.IsNullOrEmpty(appointment.Symptoms) && appointment.Symptoms.Length > 30)
                                            {
                                                <span class="view-more-btn position-absolute end-0 bottom-0 small text-primary cursor-pointer" 
                                                      data-bs-toggle="tooltip" title="@appointment.Symptoms">
                                                    <i class="fas fa-ellipsis-h"></i>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (appointment.Status == AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                                <i class="fas fa-check-circle me-1"></i> Đã xác nhận
                                            </span>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Canceled)
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
                                                <i class="fas fa-times-circle me-1"></i> Đã hủy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">
                                                <i class="fas fa-clock me-1"></i> Chờ xác nhận
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill view-details"
                                                    data-id="@appointment.AppointmentId" data-bs-toggle="tooltip" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill dropdown-toggle" 
                                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    @if (appointment.Status != AppointmentStatus.Confirmed)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item text-success confirm-appointment" 
                                                                   data-id="@appointment.AppointmentId">
                                                                <i class="fas fa-check-circle me-2"></i> Xác nhận lịch hẹn
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (appointment.Status != AppointmentStatus.Canceled)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item text-danger cancel-appointment"
                                                                   data-id="@appointment.AppointmentId">
                                                                <i class="fas fa-times-circle me-2"></i> Hủy lịch hẹn
                                                            </button>
                                                        </li>
                                                    }
                                                    <li><hr class="dropdown-divider"></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state p-4">
                                        <i class="fas fa-calendar-times fa-3x mb-3 text-secondary"></i>
                                        <h5 class="mb-1">Không có lịch hẹn nào</h5>
                                        <p class="text-muted mb-3">Chưa có lịch hẹn nào được tạo hoặc không có lịch hẹn phù hợp với bộ lọc</p>
                                    </div>
                                </td>
                            </tr>
                        } 
                    </tbody>
                </table>
            </div>
        </div>
        
        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-0 p-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?page=@(Model.CurrentPage - 1)" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?page=@(Model.CurrentPage + 1)" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal xem chi tiết lịch hẹn -->
<div class="modal fade" id="appointmentDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary bg-gradient text-white">
                <h5 class="modal-title">
                    <i class="fas fa-calendar-check me-2"></i>
                    Chi tiết lịch hẹn #<span id="detailAppointmentCode"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin lịch hẹn</h6>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Mã lịch hẹn:</div>
                            <div class="fw-medium">
                                <span class="badge bg-primary-subtle text-primary px-2 py-1">
                                    <i class="fas fa-bookmark me-1"></i>
                                    AP-<span id="detailId"></span>
                                </span>
                            </div>
                        </div>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Ngày hẹn:</div>
                            <div class="fw-medium" id="detailDate"></div>
                        </div>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Thời gian:</div>
                            <div class="fw-medium" id="detailTime"></div>
                        </div>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Trạng thái:</div>
                            <div id="detailStatus"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin bệnh nhân</h6>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Họ tên:</div>
                            <div class="fw-medium" id="detailPatientName"></div>
                        </div>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Số điện thoại:</div>
                            <div class="fw-medium" id="detailPhone"></div>
                        </div>
                        <div class="mb-2 d-flex">
                            <div class="text-muted" style="width: 120px;">Địa chỉ:</div>
                            <div id="detailAddress"></div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin y tế</h6>
                        <div class="mb-3">
                            <div class="text-muted mb-1">Triệu chứng:</div>
                            <div class="p-3 bg-light rounded" id="detailSymptoms"></div>
                        </div>
                        <div>
                            <div class="text-muted mb-1">Ghi chú:</div>
                            <div class="p-3 bg-light rounded" id="detailNotes">Không có ghi chú</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="d-flex justify-content-between w-100">
                    <div>
                        <button type="button" class="btn btn-danger" id="deleteAppointment">
                            <i class="fas fa-trash me-1"></i> Xóa
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <a href="#" class="btn btn-primary" id="editAppointmentLink">
                            <i class="fas fa-edit me-1"></i> Chỉnh sửa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="confirmTitle">Xác nhận lịch hẹn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div id="confirmIconContainer" class="mb-3">
                    <i class="fas fa-check-circle fa-4x text-success"></i>
                </div>
                <h5 id="confirmMessage" class="mb-3">Bạn có chắc chắn muốn xác nhận lịch hẹn này?</h5>
                <p class="text-muted mb-0" id="confirmSubtext">Hành động này sẽ cập nhật trạng thái lịch hẹn.</p>
                <input type="hidden" id="appointmentId" value="">
                <input type="hidden" id="actionType" value="">
            </div>
            <div class="modal-footer border-0 bg-light p-3">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="confirmAction">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Khởi tạo tooltip
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            // Xử lý nút xác nhận lịch hẹn
            $('.confirm-appointment').on('click', function() {
                const appointmentId = $(this).data('id');
                $('#appointmentId').val(appointmentId);
                $('#actionType').val('confirm');
                
                // Cập nhật giao diện modal
                $('#confirmTitle').text('Xác nhận lịch hẹn');
                $('#confirmMessage').text('Bạn có chắc chắn muốn xác nhận lịch hẹn này?');
                $('#confirmSubtext').text('Bệnh nhân sẽ được thông báo về lịch hẹn đã được xác nhận.');
                $('#confirmIconContainer').html('<i class="fas fa-check-circle fa-4x text-success"></i>');
                $('#confirmAction').removeClass('btn-danger').addClass('btn-success').text('Xác nhận');
                
                $('#confirmModal').modal('show');
            });
            
            // Xử lý nút hủy lịch hẹn
            $('.cancel-appointment').on('click', function() {
                const appointmentId = $(this).data('id');
                $('#appointmentId').val(appointmentId);
                $('#actionType').val('cancel');
                
                // Cập nhật giao diện modal
                $('#confirmTitle').text('Hủy lịch hẹn');
                $('#confirmMessage').text('Bạn có chắc chắn muốn hủy lịch hẹn này?');
                $('#confirmSubtext').text('Bệnh nhân sẽ được thông báo về việc hủy lịch hẹn.');
                $('#confirmIconContainer').html('<i class="fas fa-times-circle fa-4x text-danger"></i>');
                $('#confirmAction').removeClass('btn-success').addClass('btn-danger').text('Hủy lịch hẹn');
                
                $('#confirmModal').modal('show');
            });
            
            // Xử lý nút xem chi tiết
            $('.view-details').on('click', function() {
                const appointmentId = $(this).data('id');
                
                // Lấy 6 ký tự cuối của ID để hiển thị
                let fullId = appointmentId.toString();
                let shortId = fullId.length > 6 
                    ? fullId.substring(Math.max(0, fullId.length - 6)) 
                    : fullId;
                
                // Giả lập tải dữ liệu chi tiết - trong thực tế sẽ gọi API
                // Giả sử đã có dữ liệu, hiển thị lên modal
                $('#detailAppointmentCode').text('AP-' + shortId);
                $('#detailId').text(shortId);
                $('#editAppointmentLink').attr('href', '/Appointments/Edit/' + appointmentId);
                
                // Hiển thị modal
                $('#appointmentDetailsModal').modal('show');
            });

            // Xử lý xác nhận trong modal
            $('#confirmAction').on('click', function() {
                const appointmentId = $('#appointmentId').val();
                const actionType = $('#actionType').val();
                
                let newStatus = 1; // Mặc định là xác nhận
                if (actionType === 'cancel') {
                    newStatus = 3; // Trạng thái hủy
                }
                
                // Gửi yêu cầu AJAX để cập nhật trạng thái
                $.ajax({
                    url: '@Url.Action("UpdateStatus", "Collaborator")',
                    type: 'POST',
                    data: {
                        id: appointmentId,
                        status: newStatus
                    },
                    success: function(response) {
                        // Làm mới trang để cập nhật giao diện
                        window.location.reload();
                    },
                    error: function() {
                        alert('Có lỗi xảy ra khi kết nối đến máy chủ');
                    }
                });
                
                $('#confirmModal').modal('hide');
            });
            
            // Xử lý tìm kiếm
            $('#searchAppointment').on('keyup', function() {
                const value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}