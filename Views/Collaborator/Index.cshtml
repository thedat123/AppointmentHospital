@using AppointmentHospital.EnumStatus
@using AppointmentHospital.Helpers
@model Pagination<AppointmentHospital.Models.Appointment>

<div class="container py-5">
    <!-- Tìm kiếm và Bộ lọc -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="transition: all 0.2s ease-in-out;">
        <div class="card-body p-4">
            <form method="get" id="filterForm">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-end-0 pe-0">
                                <i class="fas fa-search text-primary"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-2" 
                                   name="searchTerm" id="searchAppointment" 
                                   value="@ViewBag.CurrentSearchTerm"
                                   placeholder="Tìm theo tên hoặc mã lịch hẹn...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-end-0 pe-0">
                                <i class="fas fa-calendar-alt text-primary"></i>
                            </span>
                            <input type="date" class="form-control border-start-0 ps-2" 
                                   name="appointmentDate" id="appointmentDate"
                                   value="@ViewBag.CurrentDate">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select rounded-3" name="status" id="statusFilter">
                            <option value="">Tất cả trạng thái</option>
                            <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "1" ? "selected" : null)">Đã xác nhận</option>
                            <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "0" ? "selected" : null)">Chờ xử lý</option>
                            <option value="3" selected="@(ViewBag.CurrentStatus?.ToString() == "3" ? "selected" : null)">Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-3" style="transition: background-color 0.2s;">
                            <i class="fas fa-filter me-1"></i> Lọc
                        </button>
                    </div>
                </div>
                <!-- Hidden field to maintain page parameter -->
                <input type="hidden" name="page" value="1">
            </form>
        </div>
    </div>

    <!-- Danh sách lịch hẹn -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-gradient bg-primary text-white p-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 d-flex align-items-center">
                <i class="fas fa-calendar-check me-2"></i> Danh sách lịch hẹn
            </h5>
            <div class="dropdown">
                <button class="btn btn-outline-light dropdown-toggle rounded-3" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-download me-1"></i> Xuất file
                </button>
                <ul class="dropdown-menu dropdown-menu-end rounded-3 shadow-sm">
                    <li><a class="dropdown-item" href="#"><i class="far fa-file-excel me-2"></i> Excel</a></li>
                    <li><a class="dropdown-item" href="#"><i class="far fa-file-pdf me-2"></i> PDF</a></li>
                </ul>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="ps-4 fw-semibold">Mã</th>
                            <th scope="col" class="fw-semibold">Ngày & Giờ</th>
                            <th scope="col" class="fw-semibold">Bệnh nhân</th>
                            <th scope="col" class="fw-semibold">Bác sĩ</th>
                            <th scope="col" class="fw-semibold">Liên hệ</th>
                            <th scope="col" class="fw-semibold">Triệu chứng</th>
                            <th scope="col" class="fw-semibold">Trạng thái</th>
                            <th scope="col" class="text-end pe-4 fw-semibold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var appointment in Model)
                            {
                                var shortId = appointment.AppointmentId.ToString().Length > 6
                                    ? appointment.AppointmentId.ToString().Substring(Math.Max(0, appointment.AppointmentId.ToString().Length - 6))
                                    : appointment.AppointmentId.ToString();
                                var appointmentCode = $"LH-{shortId}";

                                <tr style="transition: background-color 0.2s;">
                                    <td class="ps-4">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                                            <i class="fas fa-bookmark me-1"></i> @appointmentCode
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="calendar-icon rounded text-center me-3 p-2" style="width: 48px; background-color: #f0f9ff; border: 1px solid #e6f2ff;">
                                                <div class="small text-primary fw-bold">@appointment.AppointmentTime.ToString("MMM").ToUpper()</div>
                                                <div class="fw-bold fs-5">@appointment.AppointmentTime.ToString("dd")</div>
                                            </div>
                                            <div>
                                                <div class="fw-medium">@appointment.AppointmentTime.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                                                <div class="small text-muted">
                                                    <i class="far fa-clock me-1"></i> @appointment.AppointmentTime.ToString("HH:mm")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle rounded-circle text-center me-2 d-flex align-items-center justify-content-center"
                                                 style="width: 36px; height: 36px; background-color: #e9ecef;">
                                                <i class="fas fa-user text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">
                                                    @(appointment.Acquaintance?.Name ?? appointment.Patient.FullName)
                                                </div>
                                                @if (appointment.Acquaintance?.Name != null)
                                                {
                                                    <div class="small text-muted">Người thân</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle rounded-circle text-center me-2 d-flex align-items-center justify-content-center"
                                                 style="width: 36px; height: 36px; background-color: #e9ecef;">
                                                <i class="fas fa-user-md text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">
                                                    @(appointment.Doctor?.FullName ?? "Chưa chỉ định")
                                                </div>
                                                @if (appointment.Doctor == null)
                                                {
                                                    <div class="small text-muted">Chưa chỉ định bác sĩ</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var phoneNumber = appointment.Acquaintance?.PhoneNumber ?? appointment.Patient.PhoneNumber;
                                            var address = appointment.Acquaintance?.Address ?? appointment.Patient.Address;
                                        }
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-phone-alt text-primary me-2"></i>
                                                <a href="tel:@phoneNumber" class="text-decoration-none">@phoneNumber</a>
                                            </div>
                                            <div class="d-flex align-items-center text-truncate" style="max-width: 200px;" title="@address">
                                                <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                                <span class="small text-muted">@address</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="symptoms-container" style="max-height: 48px; overflow: hidden; position: relative;">
                                            <p class="mb-0 text-truncate" style="max-width: 200px;" title="@appointment.Symptoms">
                                                @(!string.IsNullOrEmpty(appointment.Symptoms) ? appointment.Symptoms : "Không có triệu chứng")
                                            </p>
                                            @if (!string.IsNullOrEmpty(appointment.Symptoms) && appointment.Symptoms.Length > 30)
                                            {
                                                <span class="view-more-btn small text-primary cursor-pointer" 
                                                      data-bs-toggle="tooltip" title="@appointment.Symptoms">
                                                    <i class="fas fa-ellipsis-h"></i>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @switch (appointment.Status)
                                        {
                                            case AppointmentStatus.Confirmed:
                                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                                    <i class="fas fa-check-circle me-1"></i> Đã xác nhận
                                                </span>
                                                break;
                                            case AppointmentStatus.Canceled:
                                                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
                                                    <i class="fas fa-times-circle me-1"></i> Đã hủy
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">
                                                    <i class="fas fa-clock me-1"></i> Chờ xử lý
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill view-details"
                                                    data-id="@appointment.AppointmentId"
                                                    data-code="@appointmentCode"
                                                    data-date="@appointment.AppointmentTime.ToString("dd/MM/yyyy")"
                                                    data-time="@appointment.AppointmentTime.ToString("HH:mm")"
                                                    data-status="@((int)appointment.Status)"
                                                    data-patient-name="@(appointment.Acquaintance?.Name ?? appointment.Patient.FullName)"
                                                    data-phone="@phoneNumber"
                                                    data-address="@address"
                                                    data-symptoms="@(appointment.Symptoms ?? "Không có triệu chứng")"
                                                    data-notes="@(appointment.Notes ?? "Không có ghi chú")"
                                                    data-bs-toggle="tooltip" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            @if (appointment.Status == AppointmentStatus.Pending)
                                            {
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary rounded-pill dropdown-toggle"
                                                            type="button" data-bs-toggle="dropdown">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end rounded-3 shadow-sm">
                                                        <li>
                                                            <button class="dropdown-item text-success confirm-appointment"
                                                                    data-id="@appointment.AppointmentId">
                                                                <i class="fas fa-check-circle me-2"></i> Xác nhận
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <button class="dropdown-item text-danger cancel-appointment"
                                                                    data-id="@appointment.AppointmentId">
                                                                <i class="fas fa-times-circle me-2"></i> Hủy lịch hẹn
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state p-4">
                                        <i class="fas fa-calendar-times fa-3x mb-3 text-muted"></i>
                                        <h5 class="mb-2">Không có lịch hẹn</h5>
                                        <p class="text-muted mb-0">Chưa có lịch hẹn nào được tạo hoặc khớp với bộ lọc hiện tại.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-0 p-3">
                <nav aria-label="Điều hướng trang">
                    <ul class="pagination justify-content-center mb-0">
                        <!-- Nút Trang Trước -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link rounded-3" href="?page=@(Model.CurrentPage - 1)&searchTerm=@ViewBag.CurrentSearchTerm&appointmentDate=@ViewBag.CurrentDate&status=@ViewBag.CurrentStatus" aria-label="Trước">
                                <span aria-hidden="true">«</span>
                            </a>
                        </li>

                        @{
                            int maxPagesToShow = 7;
                            int halfPages = maxPagesToShow / 2;
                            int startPage = Math.Max(1, Model.CurrentPage - halfPages);
                            int endPage = Math.Min(Model.TotalPage, startPage + maxPagesToShow - 1);

                            if (endPage - startPage + 1 < maxPagesToShow)
                            {
                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                            }
                        }

                        <!-- Trang đầu tiên -->
                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link rounded-3" href="?page=1&searchTerm=@ViewBag.CurrentSearchTerm&appointmentDate=@ViewBag.CurrentDate&status=@ViewBag.CurrentStatus">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link rounded-3">...</span>
                                </li>
                            }
                        }

                        <!-- Các trang lân cận -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-3" href="?page=@i&searchTerm=@ViewBag.CurrentSearchTerm&appointmentDate=@ViewBag.CurrentDate&status=@ViewBag.CurrentStatus">@i</a>
                            </li>
                        }

                        <!-- Trang cuối cùng -->
                        @if (endPage < Model.TotalPage)
                        {
                            @if (endPage < Model.TotalPage - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link rounded-3">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link rounded-3" href="?page=@Model.TotalPage&searchTerm=@ViewBag.CurrentSearchTerm&appointmentDate=@ViewBag.CurrentDate&status=@ViewBag.CurrentStatus">@Model.TotalPage</a>
                            </li>
                        }

                        <!-- Nút Trang Sau -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link rounded-3" href="?page=@(Model.CurrentPage + 1)&searchTerm=@ViewBag.CurrentSearchTerm&appointmentDate=@ViewBag.CurrentDate&status=@ViewBag.CurrentStatus" aria-label="Sau">
                                <span aria-hidden="true">»</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Chi tiết Cuộc Hẹn Modal -->
<div class="modal fade" id="appointmentDetailsModal" tabindex="-1" aria-labelledby="appointmentDetailsModalLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary bg-gradient text-white rounded-top-4">
                <h5 class="modal-title" id="appointmentDetailsModalLabel">
                    <i class="fas fa-calendar-check me-2"></i>
                    Chi tiết cuộc hẹn #<span id="detailAppointmentCode"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin cuộc hẹn</h6>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Mã cuộc hẹn:</div>
                            <div class="fw-medium">
                                <span class="badge bg-primary-subtle text-primary px-3 py-1">
                                    <i class="fas fa-bookmark me-1"></i>
                                    AP-<span id="detailId"></span>
                                </span>
                            </div>
                        </div>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Ngày:</div>
                            <div class="fw-medium" id="detailDate"></div>
                        </div>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Giờ:</div>
                            <div class="fw-medium" id="detailTime"></div>
                        </div>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Trạng thái:</div>
                            <div id="detailStatus"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin bệnh nhân</h6>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Họ tên:</div>
                            <div class="fw-medium" id="detailPatientName"></div>
                        </div>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Số điện thoại:</div>
                            <div class="fw-medium" id="detailPhone"></div>
                        </div>
                        <div class="mb-3 d-flex">
                            <div class="text-muted" style="width: 130px;">Địa chỉ:</div>
                            <div id="detailAddress"></div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin y tế</h6>
                        <div class="mb-3">
                            <div class="text-muted mb-1">Triệu chứng:</div>
                            <div class="p-3 bg-light rounded-3" id="detailSymptoms"></div>
                        </div>
                        <div>
                            <div class="text-muted mb-1">Ghi chú:</div>
                            <div class="p-3 bg-light rounded-3" id="detailNotes">Không có ghi chú</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-3">
                <div class="d-flex justify-content-between w-100">
                    <button type="button" class="btn btn-outline-danger rounded-3" id="deleteAppointment">
                        <i class="fas fa-trash me-1"></i> Xóa
                    </button>
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title" id="confirmTitle">Xác nhận cuộc hẹn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div id="confirmIconContainer" class="mb-3">
                    <i class="fas fa-check-circle fa-4x text-success"></i>
                </div>
                <h5 id="confirmMessage" class="mb-3">Bạn có chắc chắn muốn xác nhận cuộc hẹn này?</h5>
                <p class="text-muted mb-0" id="confirmSubtext">Hành động này sẽ cập nhật trạng thái cuộc hẹn.</p>
                <input type="hidden" id="appointmentId" value="">
                <input type="hidden" id="actionType" value="">
            </div>
            <div class="modal-footer border-0 bg-light p-3">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3" id="confirmAction">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Khởi tạo tooltip
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Xử lý submit form lọc
            $('#filterForm').on('submit', function(e) {
                e.preventDefault();
                const searchTerm = $('#searchAppointment').val().trim();
                const appointmentDate = $('#appointmentDate').val();
                const status = $('#statusFilter').val();
                const page = $('input[name="page"]').val();

                // Xây dựng URL với các tham số query
                const params = new URLSearchParams();
                if (searchTerm) params.append('searchTerm', searchTerm);
                if (appointmentDate) params.append('appointmentDate', appointmentDate);
                if (status) params.append('status', status);
                params.append('page', page);

                // Điều hướng đến URL mới
                window.location.href = '?' + params.toString();
            });

            // Xử lý nút xác nhận lịch hẹn
            $('.confirm-appointment').on('click', function() {
                const appointmentId = $(this).data('id');
                $('#appointmentId').val(appointmentId);
                $('#actionType').val('confirm');
                
                // Cập nhật giao diện modal
                $('#confirmTitle').text('Xác nhận lịch hẹn');
                $('#confirmMessage').text('Bạn có chắc chắn muốn xác nhận lịch hẹn này?');
                $('#confirmSubtext').text('Bệnh nhân sẽ được thông báo về lịch hẹn đã được xác nhận.');
                $('#confirmIconContainer').html('<i class="fas fa-check-circle fa-4x text-success"></i>');
                $('#confirmAction').removeClass('btn-danger').addClass('btn-success').text('Xác nhận');
                
                $('#confirmModal').modal('show');
            });
            
            // Xử lý nút hủy lịch hẹn
            $('.cancel-appointment').on('click', function() {
                const appointmentId = $(this).data('id');
                $('#appointmentId').val(appointmentId);
                $('#actionType').val('cancel');
                
                // Cập nhật giao diện modal
                $('#confirmTitle').text('Hủy lịch hẹn');
                $('#confirmMessage').text('Bạn có chắc chắn muốn hủy lịch hẹn này?');
                $('#confirmSubtext').text('Bệnh nhân sẽ được thông báo về việc hủy lịch hẹn.');
                $('#confirmIconContainer').html('<i class="fas fa-times-circle fa-4x text-danger"></i>');
                $('#confirmAction').removeClass('btn-success').addClass('btn-danger').text('Hủy lịch hẹn');
                
                $('#confirmModal').modal('show');
            });
            
            $('.view-details').on('click', function() {
                const appointmentId = $(this).data('id');
                const appointmentCode = $(this).data('code');
                const date = $(this).data('date');
                const time = $(this).data('time');
                const status = $(this).data('status');
                const patientName = $(this).data('patient-name');
                const phone = $(this).data('phone');
                const address = $(this).data('address');
                const symptoms = $(this).data('symptoms');
                const notes = $(this).data('notes');

                // Đổ dữ liệu vào modal
                $('#detailAppointmentCode').text(appointmentCode);
                $('#detailId').text(appointmentId.toString().length > 6 
                    ? appointmentId.toString().substring(Math.max(0, appointmentId.toString().length - 6)) 
                    : appointmentId);
                $('#detailDate').text(date);
                $('#detailTime').text(time);
                $('#detailPatientName').text(patientName);
                $('#detailPhone').text(phone);
                $('#detailAddress').text(address);
                $('#detailSymptoms').text(symptoms);
                $('#detailNotes').text(notes);

                // Cập nhật trạng thái
                let statusHtml = '';
                if (status == 1) { // Confirmed
                    statusHtml = '<span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> Đã xác nhận</span>';
                } else if (status == 3) { // Canceled
                    statusHtml = '<span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i> Đã hủy</span>';
                } else { // Pending
                    statusHtml = '<span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i> Chờ xác nhận</span>';
                }
                $('#detailStatus').html(statusHtml);

                // Hiển thị modal
                $('#appointmentDetailsModal').modal('show');
            });

            // Xử lý xác nhận trong modal
            $('#confirmAction').on('click', function() {
                const appointmentId = $('#appointmentId').val();
                const actionType = $('#actionType').val();
                
                let newStatus = 1; // Mặc định là xác nhận
                if (actionType === 'cancel') {
                    newStatus = 3; // Trạng thái hủy
                }
                
                // Gửi yêu cầu AJAX để cập nhật trạng thái
                $.ajax({
                    url: '@Url.Action("UpdateStatus", "Collaborator")',
                    type: 'POST',
                    data: {
                        id: appointmentId,
                        status: newStatus
                    },
                    success: function(response) {
                        // Làm mới trang để cập nhật giao diện
                        window.location.reload();
                    },
                    error: function() {
                        alert('Có lỗi xảy ra khi kết nối đến máy chủ');
                    }
                });
                
                $('#confirmModal').modal('hide');
            });

            // Xóa xử lý tìm kiếm phía client
            // $('#searchAppointment').on('keyup', function() {...}); // Đã xóa vì tìm kiếm giờ được xử lý qua URL
        });
    </script>
}

