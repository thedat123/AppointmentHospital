@{
    Layout = "_AccountLayout";
}
<div class="container-fluid d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg text-center" style="max-width: 500px;">
        <div class="card-body p-5">
            <div class="mb-4">
                <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
            </div>

            <h2 class="mb-3">Email Confirmed Successfully</h2>

            <p class="text-muted mb-4">
                Your email has been confirmed. You can now log in to your account and access all features.
            </p>

            <div class="alert alert-success" role="alert">
                <div class="d-flex align-items-center">
                    <i class="fas fa-shield-alt me-3"></i>
                    <div>
                        Your account is now fully activated and secure.
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <a asp-action="Login" class="btn btn-primary w-100">
                        <i class="fas fa-sign-in-alt me-2"></i>Go to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
