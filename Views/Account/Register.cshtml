@using static AppointmentHospital.DTOs.Account.AccountRequest;
@model RegisterUserRequest;
@{
    Layout = "_AccountLayout";
}

<div class="login-container mt-5">
    <h2 class="text-center mb-4">Create Account</h2>
    
    <form method="post" asp-action="Register" class="login-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-floating mb-4">
            <input type="email" asp-for="@Model.Email" class="form-control" placeholder="name@example.com" />
            <label asp-for="@Model.Email">
                <i class="fas fa-envelope"></i> Email Address
            </label>
            <span asp-validation-for="@Model.Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input type="text" asp-for="@Model.FullName" class="form-control" placeholder="Full Name" />
            <label asp-for="@Model.FullName">
                <i class="fas fa-user"></i> Full Name
            </label>
            <span asp-validation-for="@Model.FullName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input type="password" asp-for="@Model.Password" class="form-control" placeholder="Password" />
            <label asp-for="@Model.Password">
                <i class="fas fa-lock"></i> Password
            </label>
            <span asp-validation-for="@Model.Password" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input type="password" asp-for="@Model.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
            <label asp-for="@Model.ConfirmPassword">
                <i class="fas fa-lock"></i> Confirm Password
            </label>
            <span asp-validation-for="@Model.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input type="text" asp-for="@Model.Address" class="form-control" placeholder="Address" />
            <label asp-for="@Model.Address">
                <i class="fas fa-home"></i> Address
            </label>
            <span asp-validation-for="@Model.Address" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input type="date" value="1999-01-01" asp-for="@Model.DateOfBirth" class="form-control" />
            <label asp-for="@Model.DateOfBirth">
                <i class="fas fa-calendar"></i> Date of Birth
            </label>
            <span asp-validation-for="@Model.DateOfBirth" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-4">
            <i class="fas fa-user-plus me-2"></i> Register
        </button>

        <div class="text-center links-section">
            <p class="mb-2">
                Already have an account? 
                <a asp-action="Login" class="text-primary">Sign In</a>
            </p>
        </div>
    </form>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/register.css">
}